@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Write Report</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Trumbowyg CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Trumbowyg/2.27.3/ui/trumbowyg.min.css">

    <!-- Mobile Note Editor CSS -->
    <link href="~/css/mobile-note-editor.css" rel="stylesheet">
</head>
<body class="mobile-note-editor">
    <div id="mobileNoteEditorPage">
        <!-- Loading Overlay -->
        <div class="mne-loading-overlay" id="loadingOverlay">
            <div class="mne-spinner"></div>
            <div class="mne-loading-text" id="loadingText">Loading...</div>
        </div>

        <!-- Header -->
        <header class="mne-header">
            <button class="mne-header-btn" id="closeBtn">
                <i class="bi bi-x-lg"></i>
            </button>
            <h1 id="pageTitle">Write Report</h1>
            <div style="width: 40px;"></div>
        </header>

        <!-- Main Content -->
        <main class="mne-content">
            <!-- Error Message -->
            <div class="mne-error-message" id="errorMessage" style="display: none;"></div>

            <!-- Patient & Provider Info -->
            <div class="mne-info-card">
                <div class="mne-info-row">
                    <div class="mne-info-item">
                        <div class="mne-info-label">Patient</div>
                        <div class="mne-info-value" id="patientName">-</div>
                    </div>
                    <div class="mne-info-item">
                        <div class="mne-info-label">Provider</div>
                        <div class="mne-info-value" id="providerName">-</div>
                    </div>
                </div>
            </div>

            <!-- Form Fields -->
            <div class="mne-form-section">
                <div class="mne-form-item">
                    <label for="templateSelect">Template</label>
                    <select id="templateSelect">
                        <option value="">Select a template</option>
                    </select>
                </div>
                <div class="mne-form-item">
                    <label for="serviceDate">Service Date</label>
                    <input type="date" id="serviceDate" autocomplete="off">
                </div>
            </div>

            <!-- Editor -->
            <div class="mne-editor-section">
                <div class="mne-editor-header">Note Content</div>
                <textarea id="noteContent"></textarea>
            </div>
        </main>

        <!-- Footer Actions -->
        <footer class="mne-footer">
            <button class="mne-btn-save-draft" id="saveDraftBtn">
                <i class="bi bi-save"></i>
                Save Draft
            </button>
            <button class="mne-btn-save-sign" id="saveSignBtn">
                <i class="bi bi-check-circle"></i>
                Save & Sign
            </button>
        </footer>

        <!-- Toast Container -->
        <div class="mne-toast-container">
            <div class="mne-toast-message" id="toastMessage"></div>
        </div>

        <!-- Missing Fields Modal -->
        <div class="mne-modal-overlay hidden" id="missingFieldsModal">
            <div class="mne-modal-content">
                <div class="mne-modal-header warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <h2 class="mne-modal-title" id="missingFieldsTitle">Missing Required Fields</h2>
                </div>
                <div class="mne-modal-body">
                    <p id="missingFieldsInfo">The following fields are required to create a Care Episode from the Initial Evaluation:</p>
                    <ul class="mne-missing-fields-list" id="missingFieldsList"></ul>
                    <p>Please edit the note to include these fields before signing.</p>
                </div>
                <div class="mne-modal-footer">
                    <button class="mne-modal-btn mne-modal-btn-primary" id="closeMissingFieldsBtn">
                        <i class="bi bi-pencil"></i>
                        Edit Note
                    </button>
                </div>
            </div>
        </div>

        <!-- Care Episode Confirmation Modal -->
        <div class="mne-modal-overlay hidden" id="careEpisodeModal">
            <div class="mne-modal-content">
                <div class="mne-modal-header success">
                    <i class="bi bi-check-circle-fill"></i>
                    <h2 class="mne-modal-title" id="careEpisodeTitle">Confirm Care Episode</h2>
                </div>
                <div class="mne-modal-body">
                    <div class="mne-info-alert" id="careEpisodeInfo">
                        <i class="bi bi-info-circle"></i>
                        <span>Review and confirm the Care Episode details before signing.</span>
                    </div>

                    <div class="mne-care-episode-form">
                        <!-- Diagnosis (read-only, only for Initial Eval) -->
                        <div class="mne-form-group" id="diagnosisGroup">
                            <label>Diagnosis</label>
                            <div class="readonly-value" id="ceDiagnosis">-</div>
                        </div>

                        <div class="mne-form-row">
                            <div class="mne-form-group">
                                <label>Expected Visits *</label>
                                <input type="number" id="ceExpectedVisits" min="1" placeholder="e.g., 12" autocomplete="off">
                            </div>
                            <div class="mne-form-group">
                                <label>Duration (Weeks)</label>
                                <input type="number" id="ceDuration" min="1" placeholder="e.g., 8" autocomplete="off">
                            </div>
                        </div>

                        <div class="mne-form-group">
                            <label>Visit Frequency</label>
                            <input type="text" id="ceVisitFrequency" placeholder="e.g., 2x/week" autocomplete="off">
                        </div>

                        <div class="mne-form-group">
                            <label>Physician Name</label>
                            <input type="text" id="cePhysicianName" placeholder="Referring physician" autocomplete="off">
                        </div>
                    </div>
                </div>
                <div class="mne-modal-footer">
                    <button class="mne-modal-btn mne-modal-btn-secondary" id="closeCareEpisodeBtn">
                        Cancel
                    </button>
                    <button class="mne-modal-btn mne-modal-btn-success" id="confirmCareEpisodeBtn">
                        <i class="bi bi-check-lg"></i>
                        <span id="ceConfirmBtnText">Confirm & Sign</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Trumbowyg/2.27.3/trumbowyg.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/modules/mobilenotes/MobileNoteEditorModule.js"></script>
</body>
</html>
