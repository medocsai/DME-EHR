@{
    ViewData["Title"] = "Consent Forms";
    ViewData["ActivePage"] = "consent-forms";
}

<!-- Consent Forms Page -->
<div class="page active" id="consent-formsPage">
    <div class="page-header">
        <button class="btn btn-primary" onclick="openConsentTemplateModal()">
            <i class="bi bi-plus-lg me-1"></i>New Template
        </button>
    </div>
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-tablet me-2"></i>Patient Kiosk</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <p class="mb-2">Share this link or QR code with patients to complete consent forms.</p>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" id="kioskLinkDisplay" readonly placeholder="Loading kiosk link...">
                        <button class="btn btn-outline-primary" type="button" onclick="copyKioskLink()">
                            <i class="bi bi-clipboard me-1"></i>Copy
                        </button>
                        <button class="btn btn-outline-secondary" type="button" onclick="openKioskInNewTab()">
                            <i class="bi bi-box-arrow-up-right me-1"></i>Open
                        </button>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <div id="kioskQrCodeDisplay" class="d-inline-block p-2 bg-white border rounded">
                        <div class="text-muted small">Loading QR code...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Consent Form Templates</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="consentTemplatesTable">
                    <thead>
                        <tr><th>Name</th><th>Type</th><th>Version</th><th>Status</th><th>Last Updated</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="consentTemplatesTableBody">
                        <tr><td colspan="6" class="text-center py-4"><div class="spinner-border spinner-border-sm" role="status"></div><span class="ms-2">Loading templates...</span></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_Modals" />
    <partial name="_ModalsAdmin" />
}

@section Scripts {
}
