@using EHR.Helpers
@{
    ViewData["ActivePage"] = "customers";
    var c = (Dictionary<string, object?>)ViewBag.Customer;
    var insurances = (List<Dictionary<string, object?>>)ViewBag.Insurances;
    var diagnoses = (List<Dictionary<string, object?>>)ViewBag.Diagnoses;
    var equipment = (List<Dictionary<string, object?>>)ViewBag.Equipment;
    var orders = (List<Dictionary<string, object?>>)ViewBag.Orders;
    var documents = (IReadOnlyList<EHR.Services.CustomerDocument>)ViewBag.Documents;
    var documentKinds = (IReadOnlyList<(string Value, string Name)>)ViewBag.DocumentKinds;
    int ht = F.I(c["HeightInches"]);
    var customerId = F.I(c["CustomerId"]);
}

<div class="dme-wrap">
    <a href="/Dme/Customers" class="dme-muted" style="font-size:13px;text-decoration:none"><i class="bi bi-arrow-left"></i> All customers</a>

    @if (TempData["CustomerError"] != null)
    {
        <div class="dme-banner" style="background:#fdecea;color:#8a1c13;margin-top:10px">
            <i class="bi bi-exclamation-triangle"></i> @TempData["CustomerError"]
        </div>
    }

    <div class="dme-card" style="margin-top:10px">
        <div class="dme-card-body" style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap">
            <div style="display:flex;align-items:center;gap:14px">
                <span class="dme-avatar" style="width:52px;height:52px;font-size:18px">@F.Initials(c["FirstName"], c["LastName"])</span>
                <div>
                    <div style="font-size:19px;font-weight:700">@F.S(c["FirstName"]) @F.S(c["LastName"])</div>
                    <div class="dme-muted" style="font-size:13px">@F.S(c["AccountNo"]) · @F.Age(c["Dob"]) yrs · @F.S(c["Gender"]) · @F.S(c["Phone"])</div>
                    <div class="dme-muted" style="font-size:12.5px">Ht @(ht > 0 ? (ht / 12) + "' " + (ht % 12) + "\"" : "—") · Wt @(F.I(c["WeightLbs"]) > 0 ? F.I(c["WeightLbs"]) + " lb" : "—") · @F.S(c["AddressLine1"]), @F.S(c["City"]) @F.S(c["State"]) @F.S(c["Zip"])</div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/Dme/EditCustomer/@customerId" class="dme-btn dme-btn-light"><i class="bi bi-pencil"></i> Edit</a>
                <a href="/Dme/NewOrder?customerId=@customerId" class="dme-btn dme-btn-primary"><i class="bi bi-box-seam"></i> New Order</a>
            </div>
        </div>
    </div>

    <div class="dme-grid2">
        <div>
            <div class="dme-card">
                <div class="dme-card-head">
                    <h2>Insurance</h2>
                    <span class="dme-muted" style="font-size:12px">one primary, one secondary</span>
                </div>
                <div class="dme-card-body">
                    @foreach (var i in insurances)
                    {
                        <div class="dme-line">
                            <div style="display:flex;justify-content:space-between;align-items:start;gap:8px">
                                <strong>@(F.S(i["Kind"]) == "primary" ? "Primary" : "Secondary") &middot; @F.S(i["PayerName"])</strong>
                                <form method="post" action="/Dme/RemoveInsurance" style="display:inline"
                                      onsubmit="return confirm('Remove this insurance? Claims already raised keep the payer they were billed to.');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="customerId" value="@customerId" />
                                    <input type="hidden" name="insuranceId" value="@F.I(i["InsuranceId"])" />
                                    <button type="submit" class="dme-btn dme-btn-light dme-btn-sm">remove</button>
                                </form>
                            </div>
                            <div class="dme-muted" style="font-size:12.5px;margin-top:4px">
                                Member @F.S(i["MemberId"])@(string.IsNullOrEmpty(F.S(i["GroupNumber"])) ? "" : " · Group " + F.S(i["GroupNumber"])) &middot;
                                Copay @F.Money(i["Copay"]) &middot; Coins @F.I(i["Coinsurance"])% &middot; Deductible @F.Money(i["Deductible"]) &middot;
                                Subscriber: @(string.IsNullOrEmpty(F.S(i["SubscriberRel"])) ? "Self" : F.S(i["SubscriberRel"]))
                            </div>
                        </div>
                    }
                    @if (insurances.Count == 0) { <div class="dme-muted">No insurance on file.</div> }

                    @* Saving a primary over an existing primary is what happens when
                       somebody changes plan in January, so this is a replace rather than
                       an append. A unique index on (CustomerId, Kind) is the guard. *@
                    <details style="margin-top:10px">
                        <summary style="cursor:pointer;font-size:13px">Add or replace an insurance</summary>
                        <form method="post" action="/Dme/SaveInsurance" class="row g-2 mt-1">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="customerId" value="@customerId" />
                            <div class="col-md-6">
                                <label class="form-label">Which</label>
                                <select name="kind" class="form-select">
                                    <option value="primary">Primary</option>
                                    <option value="secondary">Secondary</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Subscriber is the</label>
                                @* CMS-1500 box 6. Written as the literal 'Self' on every insert
                                   before this, because nothing ever asked. *@
                                <select name="subscriberRel" class="form-select">
                                    @foreach (var r in EHR.Controllers.DmeController.SubscriberRelationships)
                                    {
                                        <option value="@r">@(r == "Self" ? "Customer themselves" : r)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Payer</label>
                                @* A typeahead over Office Ally's national list, not a select.
                                   The hidden field carries the catalog id, which is the only
                                   thing the server trusts: a posted NAME would let a typo
                                   become the payer a claim is addressed to. *@
                                <div class="dme-typeahead">
                                    <input type="text" id="insPayerSearch" class="form-control" autocomplete="off"
                                           placeholder="Search insurance by name or Payer ID…" />
                                    <input type="hidden" name="payerId" id="insPayerIdField" value="0" />
                                    <div id="insPayerResults" class="dme-typeahead-list" hidden></div>
                                </div>
                                <div id="insPayerChosen" class="form-text" style="font-size:11px" hidden></div>
                            </div>
                            <div class="col-md-6"><label class="form-label">Member ID</label><input name="memberId" class="form-control" /></div>
                            <div class="col-md-6"><label class="form-label">Group #</label><input name="groupNumber" class="form-control" /></div>
                            <div class="col-md-4"><label class="form-label">Copay ($)</label><input type="number" step="0.01" name="copay" class="form-control" value="0" /></div>
                            <div class="col-md-4"><label class="form-label">Coins (%)</label><input type="number" name="coinsurance" class="form-control" value="0" /></div>
                            <div class="col-md-4"><label class="form-label">Deductible ($)</label><input type="number" step="0.01" name="deductible" class="form-control" value="0" /></div>
                            <div class="col-12 d-flex justify-content-end">
                                <button type="submit" class="dme-btn dme-btn-primary dme-btn-sm">Save insurance</button>
                            </div>
                        </form>
                    </details>
                </div>
            @{
                var bal = (Dictionary<string, object?>)ViewBag.Balance;
                var owed = bal == null ? 0m : F.Dec(bal["Balance"]);
            }
            @* What the CUSTOMER owes, not what the payer owes. This is the
               deductible, coinsurance and copay the remittance put in the PR
               group. A supplier is required to make a genuine effort to collect
               it, so it belongs on the screen somebody has open when the
               customer is on the phone. *@
            <div class="dme-card">
                <div class="dme-card-head">
                    <h2>Customer balance</h2>
                    <span class="dme-muted" style="font-size:12px">their share, not the payer's</span>
                </div>
                <div class="dme-card-body">
                    @if (bal == null)
                    {
                        <div class="dme-muted">Nothing billed yet.</div>
                    }
                    else
                    {
                        <div style="display:flex;align-items:baseline;gap:10px">
                            <div style="font-size:26px;font-weight:700;color:@(owed > 0 ? "#a32d2d" : "#0f6e56")">@F.Money(owed)</div>
                            @if (owed > 0 && bal["OldestOutstandingServiceDate"] != null)
                            {
                                <span class="dme-chip amber">since @F.Date(bal["OldestOutstandingServiceDate"])</span>
                            }
                        </div>
                        <div class="dme-muted" style="font-size:12.5px;margin-top:6px">
                            Payers put @F.Money(bal["PatientResponsibility"]) on the patient.
                            @F.Money(bal["CustomerPaid"]) has been received from them.
                        </div>
                        @if (owed > 0)
                        {
                            <div class="dme-muted" style="font-size:12px;margin-top:8px">
                                Post what they pay on the claim it belongs to, from
                                <strong>Billing &rarr; Post payment</strong>, choosing
                                <em>Customer</em> as the source.
                            </div>
                        }
                    }
                </div>
            </div>
            </div>
            <div class="dme-card">
                <div class="dme-card-head"><h2>Equipment on file</h2></div>
                <table class="dme-table">
                    <thead><tr><th>Item</th><th>Serial</th><th>Status</th><th>In service</th></tr></thead>
                    <tbody>
                        @foreach (var e in equipment)
                        {
                            <tr><td>@F.S(e["ItemName"]) <span class="dme-muted dme-mono">@F.S(e["Hcpcs"])</span></td><td class="dme-mono">@F.S(e["SerialNumber"])</td><td>@Html.Raw(F.StatusChip(e["Status"]))</td><td>@F.Date(e["InServiceDate"])</td></tr>
                        }
                        @if (equipment.Count == 0) { <tr><td colspan="4" class="dme-empty">No equipment dispensed yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
        <div>
            <div class="dme-card">
                <div class="dme-card-head">
                    <h2>Diagnoses (ICD-10)</h2>
                    <span class="dme-muted" style="font-size:12px">CMS-1500 box 21</span>
                </div>
                <div class="dme-card-body">
                    @foreach (var d in diagnoses)
                    {
                        <div style="padding:5px 0;display:flex;justify-content:space-between;align-items:center;gap:8px">
                            <span>
                                <span class="dme-chip blue dme-mono">@F.S(d["IcdCode"])</span>
                                @F.S(d["Description"])
                                @if (F.B(d["IsPrimary"])) { <span class="dme-chip gray">primary</span> }
                            </span>
                            <form method="post" action="/Dme/RemoveDiagnosis" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="customerId" value="@customerId" />
                                <input type="hidden" name="diagnosisId" value="@F.I(d["DiagnosisId"])" />
                                <button type="submit" class="dme-btn dme-btn-light dme-btn-sm">remove</button>
                            </form>
                        </div>
                    }
                    @if (diagnoses.Count == 0) { <div class="dme-muted">No diagnoses recorded.</div> }

                    @* The code is posted and the WORDING is read from the CMS catalog, so a
                       mistyped code files nothing rather than a diagnosis with no description.
                       The description is then stored on the row, because CMS rewords codes
                       every October and what a claim was billed under must not move. *@
                    <form method="post" action="/Dme/AddDiagnosis" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="customerId" value="@customerId" />
                        <label class="form-label">Add a diagnosis</label>
                        <div class="d-flex gap-2 align-items-start">
                            <div style="flex:1">
                                <div class="dme-typeahead">
                                    <input type="text" id="dxSearch" class="form-control" autocomplete="off"
                                           placeholder="Search by condition, or the ICD-10 code…" />
                                    <input type="hidden" name="code" id="dxCode" />
                                    <div id="dxResults" class="dme-typeahead-list" hidden></div>
                                </div>
                                <div id="dxChosen" class="form-text" style="font-size:11px" hidden></div>
                            </div>
                            <button type="submit" class="dme-btn dme-btn-light">Add</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="dme-card">
                <div class="dme-card-head"><h2>Orders</h2></div>
                <table class="dme-table">
                    <tbody>
                        @foreach (var o in orders)
                        {
                            <tr class="clickable" onclick="location.href='/Dme/Order/@F.I(o["OrderId"])'"><td class="dme-mono"><strong>@F.S(o["OrderNumber"])</strong></td><td>@Html.Raw(F.StatusChip(o["Status"]))</td></tr>
                        }
                        @if (orders.Count == 0) { <tr><td class="dme-empty">No orders.</td></tr> }
                    </tbody>
                </table>
            </div>

            @* The insurance card and the photo ID: the documents about the PERSON.
               Everything that defends a claim (written order, CMN, records, prior
               auth, proof of delivery) is attached on the order instead, because it
               is per item and per period. See Services/DmeCustomerDocuments.cs. *@
            <div class="dme-card" id="documents">
                <div class="dme-card-head">
                    <h2>Documents</h2>
                    <span class="dme-muted" style="font-size:12px">insurance card, photo ID</span>
                </div>
                <div class="dme-card-body">
                    @if (TempData["DocError"] != null)
                    {
                        <div class="alert alert-danger" style="font-size:13px">@TempData["DocError"]</div>
                    }

                    @if (documents.Count == 0)
                    {
                        <div class="dme-muted" style="font-size:13px;margin-bottom:12px">Nothing attached yet.</div>
                    }
                    else
                    {
                        <table class="dme-table" style="margin-bottom:12px">
                            <tbody>
                            @foreach (var d in documents)
                            {
                                <tr>
                                    <td>
                                        @* Through our own controller, not a storage URL: it
                                           authenticates, checks the tenant and writes an audit row. *@
                                        <a href="/Dme/DownloadCustomerDoc/@d.DocumentId" target="_blank" rel="noopener">
                                            <i class="bi bi-paperclip"></i> @d.FileName
                                        </a>
                                    </td>
                                    <td><span class="dme-chip gray">@d.KindName</span></td>
                                    <td class="dme-muted">@d.UploadedAt.ToLocalTime().ToString("MMM d, yyyy")</td>
                                    <td style="text-align:right">
                                        <form method="post" action="/Dme/RemoveCustomerDoc" style="display:inline"
                                              onsubmit="return confirm('Remove this document from the customer?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.DocumentId" />
                                            <input type="hidden" name="customerId" value="@customerId" />
                                            <button type="submit" class="dme-btn dme-btn-light dme-btn-sm requires-admin">remove</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }

                    <form method="post" action="/Dme/AttachCustomerDoc" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@customerId" />
                        <select name="kind" class="form-select" style="max-width:170px">
                            @foreach (var k in documentKinds)
                            {
                                <option value="@k.Value">@k.Name</option>
                            }
                        </select>
                        <input type="file" name="file" class="form-control" style="max-width:260px"
                               accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" required />
                        <button type="submit" class="dme-btn dme-btn-light"><i class="bi bi-upload"></i> Attach</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@* Typeaheads. Inline and at the end of the markup, because dmeTypeahead is
   loaded in the <head> and an inline script runs during parsing: a tag at the
   end of <body> would define the function AFTER this call needs it. *@
<script>
    dmeTypeahead({
        input: '#insPayerSearch', hidden: '#insPayerIdField', results: '#insPayerResults', chosen: '#insPayerChosen',
        url: '/Lookups/Payers',
        emptyValue: '0',
        value: function (p) { return p.id; },
        label: function (p) { return p.name; },
        side:  function (p) { return p.code; },
        note:  function (p) { return 'Payer ID ' + p.code; },
        empty: 'No payer matches that. Check the spelling, or the Payer ID on the card.'
    });

    dmeTypeahead({
        input: '#dxSearch', hidden: '#dxCode', results: '#dxResults', chosen: '#dxChosen',
        url: '/Lookups/Icd',
        value: function (d) { return d.code; },
        label: function (d) { return d.name; },
        side:  function (d) { return d.code; },
        note:  function (d) { return 'ICD-10 ' + d.code; },
        empty: 'No diagnosis matches that. Try a condition, or the ICD-10 code.'
    });
</script>
