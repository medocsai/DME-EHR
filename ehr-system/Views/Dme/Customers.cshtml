@model List<Dictionary<string, object?>>
@using EHR.Helpers
@{ ViewData["ActivePage"] = "customers"; var q = (string)(ViewBag.Query ?? ""); }

<div class="dme-wrap">
    <div class="dme-head">
        <div>
            <h1>Customers</h1>
            <div class="dme-sub">@Model.Count customers</div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <form method="get" action="/Dme/Customers" class="d-flex gap-2 align-items-center">
                <input name="q" value="@q" placeholder="Search name, account, phone" class="form-control form-control-sm" style="width:240px" />
                <button class="dme-btn dme-btn-light dme-btn-sm" type="submit"><i class="bi bi-search"></i></button>
            </form>
            <a href="/Dme/NewCustomer" class="dme-btn dme-btn-primary dme-btn-sm"><i class="bi bi-person-plus"></i> New Customer</a>
        </div>
    </div>

    <div class="dme-card">
        <table class="dme-table">
            <thead>
                <tr><th>Customer</th><th>Account</th><th>Age / DOB</th><th>Phone</th><th>Primary insurance</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="clickable" onclick="location.href='/Dme/Customer/@F.I(c["CustomerId"])'">
                        <td><span class="dme-avatar">@F.Initials(c["FirstName"], c["LastName"])</span> <strong>@F.S(c["LastName"]), @F.S(c["FirstName"])</strong></td>
                        <td class="dme-mono dme-muted">@F.S(c["AccountNo"])</td>
                        <td>@F.Age(c["Dob"]) <span class="dme-muted">· @F.Date(c["Dob"])</span></td>
                        <td class="dme-muted">@F.S(c["Phone"])</td>
                        <td>@(c["PrimaryPayer"] == null ? "—" : F.S(c["PrimaryPayer"]))</td>
                        <td><span class="dme-chip green">Active</span></td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="dme-empty"><i class="bi bi-people"></i><div>No customers match.</div></td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
