@using EHR.Helpers
@using EHR.Services
@{
    ViewData["ActivePage"] = "dashboard";
    var rentals = (List<Dictionary<string, object?>>)ViewBag.Rentals;
    var orders = (List<Dictionary<string, object?>>)ViewBag.Orders;
    var money = (MonthlyMoney)ViewBag.Money;
    var months = (List<DateTime>)ViewBag.MonthOptions;
    var monthLabel = money.MonthStart.ToString("MMMM yyyy");
}

<div class="dme-wrap">
    <div class="dme-head">
        <div><h1>Dashboard</h1><div class="dme-sub">DME operations overview · Lakeview Medical Supply</div></div>
        <div class="d-flex gap-2">
            <a href="/Dme/Customers" class="dme-btn dme-btn-light"><i class="bi bi-people"></i> Customers</a>
            <a href="/Dme/NewOrder" class="dme-btn dme-btn-primary"><i class="bi bi-box-seam"></i> New Order</a>
        </div>
    </div>

    @*
        The three monthly money figures. Every tile carries a one line
        definition, because a number an accountant has to guess at is a number
        they will read wrong. All three are by POSTING date and describe the
        same set of postings, so they can be compared against each other and
        against a bank statement for the month.
    *@
    <div class="dme-card" style="margin-bottom:18px">
        <div class="dme-card-head">
            <div>
                <h2>Money this month</h2>
                <div class="dme-sub" style="margin-top:2px">
                    Insurance and customer payments posted in @monthLabel. Counted by the date the
                    payment was posted, which is when you received it, not when the equipment was delivered.
                </div>
            </div>
            <form method="get" action="/Dme/Dashboard">
                <select name="month" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
                    @foreach (var m in months)
                    {
                        <option value="@m.ToString("yyyy-MM")" selected="@(m == money.MonthStart)">@m.ToString("MMMM yyyy")</option>
                    }
                </select>
            </form>
        </div>
        <div class="dme-card-body">
            <div class="dme-kpis" style="grid-template-columns:repeat(3,1fr);margin-bottom:0">
                <div class="dme-kpi">
                    <div class="k-label">Amount paid</div>
                    <div class="k-value" style="color:#0f6e56">@F.Money(money.AmountPaid)</div>
                    <div class="k-foot">Money received from payers and customers and applied to claims.</div>
                    @if (money.Unapplied > 0)
                    {
                        <div class="k-foot" style="color:#854f0b;font-weight:600">
                            <i class="bi bi-exclamation-triangle"></i>
                            @F.Money(money.Unapplied) received but not yet applied to any claim
                            (<a href="/Dme/Payments">review</a>)
                        </div>
                    }
                </div>
                <div class="dme-kpi">
                    <div class="k-label">Amount denied</div>
                    <div class="k-value" style="color:@(money.AmountDenied > 0 ? "#a32d2d" : "inherit")">@F.Money(money.AmountDenied)</div>
                    <div class="k-foot">
                        Billed value of the @money.DeniedLineCount claim line(s) the payer refused.
                        Contractual discounts and patient balances are not counted here.
                    </div>
                </div>
                <div class="dme-kpi">
                    <div class="k-label">Most frequent denial code</div>
                    <div class="k-value">@(money.TopDenialCode ?? "—")</div>
                    <div class="k-foot">
                        @if (money.TopDenialCode == null)
                        {
                            <text>No denials posted in @monthLabel.</text>
                        }
                        else
                        {
                            <text>@money.TopDenialDescription (@money.TopDenialCount time(s))</text>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dme-kpis">
        <div class="dme-kpi"><div class="k-label">Active rentals</div><div class="k-value">@ViewBag.ActiveRentals</div><div class="k-foot">recurring monthly revenue</div></div>
        <div class="dme-kpi"><div class="k-label">Due to bill (7d)</div><div class="k-value">@ViewBag.DueSoon</div><div class="k-foot">needs a rental claim</div></div>
        <div class="dme-kpi"><div class="k-label">Open orders</div><div class="k-value">@ViewBag.OpenOrders</div><div class="k-foot">draft + confirmed</div></div>
        <div class="dme-kpi"><div class="k-label">Ready to bill</div><div class="k-value">@F.Money(ViewBag.ReadyTotal)</div><div class="k-foot">@ViewBag.ReadyCount claim(s) queued</div></div>
    </div>

    <div class="dme-grid2">
        <div class="dme-card">
            <div class="dme-card-head"><h2>Rentals due to bill</h2><a href="/Dme/Rentals" style="font-size:12px">View all</a></div>
            <table class="dme-table">
                <thead><tr><th>Customer / Equipment</th><th>Rate</th><th>Next bill</th><th>Months</th></tr></thead>
                <tbody>
                    @foreach (var r in rentals)
                    {
                        var d = F.DaysUntil(r["NextBillDate"]);
                        <tr class="clickable" onclick="location.href='/Dme/Customer/@F.I(r["CustomerId"])'">
                            <td><strong>@F.S(r["CustomerName"])</strong><div class="dme-muted" style="font-size:12px">@F.S(r["ItemName"]) · @F.S(r["Serial"])</div></td>
                            <td class="dme-mono">@F.Money(r["MonthlyRate"])/mo</td>
                            <td><span class="dme-chip @((d ?? 9) <= 2 ? "amber" : "gray")">@F.Date(r["NextBillDate"])</span></td>
                            <td class="dme-mono dme-muted">@F.I(r["MonthsBilled"])@(r["CapMonths"] == null ? "" : "/" + F.I(r["CapMonths"])) mo</td>
                        </tr>
                    }
                    @if (rentals.Count == 0)
                    {
                        <tr><td colspan="4" class="dme-empty">No active rentals</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="dme-card">
            <div class="dme-card-head"><h2>Recent orders</h2><a href="/Dme/Orders" style="font-size:12px">View all</a></div>
            <table class="dme-table">
                <thead><tr><th>Order</th><th>Customer</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var o in orders)
                    {
                        <tr class="clickable" onclick="location.href='/Dme/Order/@F.I(o["OrderId"])'">
                            <td class="dme-mono"><strong>@F.S(o["OrderNumber"])</strong></td>
                            <td>@F.S(o["CustomerName"])</td>
                            <td>@Html.Raw(F.StatusChip(o["Status"]))</td>
                        </tr>
                    }
                    @if (orders.Count == 0)
                    {
                        <tr><td colspan="3" class="dme-empty">No orders</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
