@using EHR.Helpers
@*
    The heading and the error banner. Everything else is _OrderForm, which
    New Order renders too: see the note at the top of that file for why these
    two screens are one form.
*@
@{
    ViewData["ActivePage"] = "orders";
    var order = (Dictionary<string, object?>)ViewBag.Order;
    var id = F.I(order["OrderId"]);
}

<div class="dme-wrap">
    <a href="/Dme/Order/@id" class="dme-muted" style="font-size:13px;text-decoration:none"><i class="bi bi-arrow-left"></i> Back to order</a>
    <div class="dme-head" style="margin-top:6px">
        <div>
            <h1>Edit order</h1>
            <div class="dme-sub">@F.S(order["OrderNumber"])</div>
        </div>
    </div>

    @if (TempData["OrderError"] != null)
    {
        <div class="dme-banner" style="background:#fdecea;border-color:#f5c2c0;color:#8a1c13">
            <i class="bi bi-exclamation-triangle"></i> @TempData["OrderError"]
        </div>
    }

    @* Editing stops the moment the van leaves. Said here rather than discovered
       on save, because somebody halfway through changing a quantity should know
       the window closes. *@
    <div class="dme-banner" style="font-size:12.5px">
        <i class="bi bi-info-circle"></i>
        Changes are possible until this order is delivered. Delivery raises the claim,
        moves the stock and starts any rental, and none of that can be undone from here.
    </div>

    @await Html.PartialAsync("_OrderForm")
</div>
