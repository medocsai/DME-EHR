@using EHR.Helpers
@*
    The heading and the error banner. Everything else is _CustomerForm, which
    Edit customer renders too: see the note at the top of that file for why
    these two screens are one form.
*@
@{
    ViewData["ActivePage"] = "customers";
}

<div class="dme-wrap">
    <a href="/Dme/Customers" class="dme-muted" style="font-size:13px;text-decoration:none"><i class="bi bi-arrow-left"></i> Customers</a>
    <div class="dme-head" style="margin-top:6px"><div><h1>New Customer</h1><div class="dme-sub">DME customer record</div></div></div>

    @if (TempData["CustomerError"] != null)
    {
        <div class="dme-banner" style="background:#fdecea;color:#8a1c13">
            <i class="bi bi-exclamation-triangle"></i> @TempData["CustomerError"]
        </div>
    }

    @await Html.PartialAsync("_CustomerForm")
</div>
