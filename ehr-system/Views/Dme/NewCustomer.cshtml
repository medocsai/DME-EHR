@using EHR.Helpers
@{
    ViewData["ActivePage"] = "customers";
    var locations = (List<Dictionary<string, object?>>)ViewBag.Locations;
    var currentLocationId = (int?)ViewBag.CurrentLocationId;
    // Falls back to the primary branch when the user is viewing all of them,
    // because "all locations" is not somewhere a customer can be filed.
    var defaultLocationId = currentLocationId
        ?? (locations.Count > 0 ? F.I(locations[0]["LocationId"]) : 0);

    // After a refusal the form comes back with what was typed. Files cannot be
    // put back into a file input, so those have to be picked again.
    var posted = ViewBag.Posted as Microsoft.AspNetCore.Http.IFormCollection;
    string V(string name) => posted?[name].ToString() ?? "";
    if (posted != null && int.TryParse(V("locationId"), out var postedBranch)) defaultLocationId = postedBranch;
    var error = (string?)ViewBag.CustomerError ?? (string?)TempData["CustomerError"];
    string Money(string name) => posted == null ? "0" : V(name);
}

<div class="dme-wrap">
    <a href="/Dme/Customers" class="dme-muted" style="font-size:13px;text-decoration:none"><i class="bi bi-arrow-left"></i> Customers</a>
    <div class="dme-head" style="margin-top:6px"><div><h1>New Customer</h1><div class="dme-sub">DME customer record</div></div></div>

    @if (error != null)
    {
        <div class="dme-banner" style="background:#fdecea;color:#8a1c13">
            <i class="bi bi-exclamation-triangle"></i> @error
        </div>
    }

    @* multipart because the insurance card and photo ID can be picked here. *@
    <form method="post" action="/Dme/CreateCustomer" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="dme-grid2">
            <div>
                <div class="dme-card">
                    <div class="dme-card-head"><h2>Basic Info</h2></div>
                    <div class="dme-card-body">
                        <div class="row g-3">
                            @*
                                The branch is the ONE place a location is stored for a person.
                                Orders, rentals, claims and payments all derive theirs from here,
                                so this field is the only one that has to be right.
                            *@
                            <div class="col-12">
                                <label class="form-label">Location <span style="color:#d6453f">*</span></label>
                                <select name="locationId" class="form-select" required>
                                    @foreach (var l in locations)
                                    {
                                        <option value="@F.I(l["LocationId"])" selected="@(F.I(l["LocationId"]) == defaultLocationId)">
                                            @F.S(l["Name"])@(F.B(l["IsPrimary"]) ? " (primary)" : "")
                                        </option>
                                    }
                                </select>
                                <div class="form-text" style="font-size:11px">
                                    Which branch this customer belongs to. Their orders, rentals, claims and
                                    payments all follow it.
                                </div>
                            </div>
                            @*
                                The js-* classes are wwwroot/js/dme/FormFields.js: letters out of a
                                phone, digits out of a name, two capital letters for a state. A
                                courtesy only; CustomerFieldProblem in DmeController is the rule.
                            *@
                            <div class="col-md-6"><label class="form-label">First Name <span style="color:#d6453f">*</span></label><input name="firstName" class="form-control js-name" maxlength="100" value="@V("firstName")" required /></div>
                            <div class="col-md-6"><label class="form-label">Last Name <span style="color:#d6453f">*</span></label><input name="lastName" class="form-control js-name" maxlength="100" value="@V("lastName")" required /></div>
                            <div class="col-md-5">
                                <label class="form-label">Date of Birth</label>
                                @* Plain text, not type="date": Chrome refuses a paste into the
                                   native date control, and a DOB is usually copied off a referral
                                   rather than typed. Helpers/DateInput.cs reads it server side. *@
                                <input name="dob" class="form-control js-dateinput" placeholder="mm/dd/yyyy" autocomplete="bday" value="@V("dob")" />
                                <div class="form-text js-field-error" style="font-size:11px;color:#d6453f" hidden>That date could not be read. Use mm/dd/yyyy.</div>
                                <div class="form-text" style="font-size:11px">Type or paste. mm/dd/yyyy</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Gender</label>
                                <select name="gender" class="form-select">
                                    <option value="">Select&hellip;</option>
                                    @foreach (var g in new[] { "Male", "Female", "Other" })
                                    {
                                        <option selected="@(V("gender") == g)">@g</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3"><label class="form-label">SSN <span class="dme-muted" style="font-size:11px">(optional)</span></label><input name="ssnLast4" class="form-control js-digits" placeholder="last 4" maxlength="4" inputmode="numeric" value="@V("ssnLast4")" /></div>
                            <div class="col-md-3"><label class="form-label">Height (in)</label><input type="number" name="heightInches" class="form-control" min="0" max="120" value="@V("heightInches")" /></div>
                            <div class="col-md-3"><label class="form-label">Weight (lb)</label><input type="number" name="weightLbs" class="form-control" min="0" max="1500" value="@V("weightLbs")" /></div>
                            <div class="col-md-6"><label class="form-label">Phone</label><input name="phone" class="form-control js-phone" placeholder="(214) 555-0101" inputmode="tel" value="@V("phone")" /></div>
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control js-email" value="@V("email")" />
                                <div class="form-text js-field-error" style="font-size:11px;color:#d6453f" hidden>That is not an email address.</div>
                            </div>
                            <div class="col-md-6"><label class="form-label">Address</label><input name="addressLine1" class="form-control" value="@V("addressLine1")" /></div>
                            <div class="col-md-3"><label class="form-label">City</label><input name="city" class="form-control js-name" value="@V("city")" /></div>
                            <div class="col-md-1"><label class="form-label">State</label><input name="state" class="form-control js-upper" maxlength="2" placeholder="TX" value="@V("state")" /></div>
                            <div class="col-md-2"><label class="form-label">ZIP</label><input name="zip" class="form-control js-digits" maxlength="9" inputmode="numeric" value="@V("zip")" /></div>
                        </div>
                    </div>
                </div>
                <div class="dme-card">
                    <div class="dme-card-head"><h2>Emergency Contact</h2></div>
                    <div class="dme-card-body">
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Contact Name</label><input name="emergencyName" class="form-control js-name" value="@V("emergencyName")" /></div>
                            <div class="col-md-6"><label class="form-label">Relationship</label><input name="emergencyRel" class="form-control js-name" value="@V("emergencyRel")" /></div>
                            <div class="col-md-6"><label class="form-label">Phone</label><input name="emergencyPhone" class="form-control js-phone" placeholder="(214) 555-0101" inputmode="tel" value="@V("emergencyPhone")" /></div>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <div class="dme-card">
                    <div class="dme-card-head"><h2>Insurance</h2></div>
                    <div class="dme-card-body">
                        <div class="dme-banner"><i class="bi bi-shield-check"></i> Primary insurance is required to bill 3rd-party for DME.</div>
                        <div class="row g-3">
                            @* Payer: a typeahead over Office Ally's national list, not a
                               <select>. 4,017 options in the markup is a 400KB page and
                               unusable with a mouse. The visible box is a search field; the
                               hidden field carries the catalog id, which is the only thing
                               the server trusts. See Services/DmePayerCatalog.cs.
                               After a refusal the payer and diagnosis are picked again: the
                               hidden id alone would post a choice the box no longer shows. *@
                            <div class="col-12">
                                <label class="form-label">Payer</label>
                                <div class="dme-typeahead">
                                    <input type="text" id="payerSearch" class="form-control" autocomplete="off"
                                           placeholder="Search insurance by name or Payer ID…" />
                                    <input type="hidden" name="insPayerId" id="insPayerId" value="0" />
                                    <div id="payerResults" class="dme-typeahead-list" hidden></div>
                                </div>
                                <div id="payerChosen" class="form-text" style="font-size:11px" hidden></div>
                            </div>
                            <div class="col-md-6"><label class="form-label">Member ID</label><input name="insMemberId" class="form-control" value="@V("insMemberId")" /></div>
                            <div class="col-md-6"><label class="form-label">Group #</label><input name="insGroup" class="form-control" value="@V("insGroup")" /></div>
                            <div class="col-md-4"><label class="form-label">Copay ($)</label><input type="number" step="0.01" min="0" name="insCopay" class="form-control" value="@Money("insCopay")" /></div>
                            <div class="col-md-4"><label class="form-label">Coinsurance (%)</label><input type="number" min="0" max="100" name="insCoins" class="form-control" value="@Money("insCoins")" /></div>
                            <div class="col-md-4"><label class="form-label">Deductible ($)</label><input type="number" step="0.01" min="0" name="insDeductible" class="form-control" value="@Money("insDeductible")" /></div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-3">
                            <span class="dme-muted" style="font-size:12.5px">
                                <i class="bi bi-info-circle"></i>
                                Enter the copay, coinsurance and deductible from the payer's portal or the member's card.
                                This product does not check eligibility with the payer.
                            </span>
                        </div>
                    </div>
                </div>
                <div class="dme-card">
                    <div class="dme-card-head"><h2>Diagnosis (ICD-10)</h2></div>
                    <div class="dme-card-body">
                        <div class="dme-banner"><i class="bi bi-clipboard2-pulse"></i> ICD-10 diagnosis is required for DME insurance billing.</div>
                        @* The whole CMS ICD-10-CM code set, searched as you type.
                           74,719 options cannot be a <select>. The hidden field
                           carries the code, which is all the server trusts, and it
                           re-reads the description from the catalog. *@
                        <label class="form-label">Primary diagnosis</label>
                        <div class="dme-typeahead">
                            <input type="text" id="dxSearch" class="form-control" autocomplete="off"
                                   placeholder="Search by condition or ICD-10 code…" />
                            <input type="hidden" name="dxCode" id="dxCode" value="" />
                            <div id="dxResults" class="dme-typeahead-list" hidden></div>
                        </div>
                        <div id="dxChosen" class="form-text" style="font-size:11px" hidden></div>
                    </div>
                </div>
                <div class="dme-card">
                    <div class="dme-card-head"><h2>Documents</h2></div>
                    <div class="dme-card-body">
                        @* The two documents about the PERSON, stored by
                           Services/DmeCustomerDocuments.cs once the customer is saved. *@
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Insurance card</label>
                                <input type="file" name="insuranceCardFile" class="form-control"
                                       accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Photo ID</label>
                                <input type="file" name="photoIdFile" class="form-control"
                                       accept=".pdf,.jpg,.jpeg,.png,.tif,.tiff" />
                            </div>
                        </div>
                        <div class="dme-muted" style="font-size:12px;margin-top:6px">PDF, JPG, PNG or TIFF, up to 25MB each. Optional.</div>
                        @if (posted != null)
                        {
                            <div style="font-size:12px;color:#8a1c13">Files are not kept when the form comes back. Pick them again.</div>
                        }
                        <div class="dme-banner" style="margin-top:12px">
                            <i class="bi bi-paperclip"></i>
                            The written order, the CMN, medical records, prior authorisation and
                            proof of delivery are attached to the <strong>order</strong>, because a
                            CMN covers one item for one period. Raise the order, then attach them there.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a href="/Dme/Customers" class="dme-btn dme-btn-light">Cancel</a>
            <button type="submit" class="dme-btn dme-btn-primary"><i class="bi bi-check-lg"></i> Save Customer</button>
        </div>
    </form>
</div>

<script>
    // Payer: Office Ally's 4,017. The hidden insPayerId is the only thing
    // posted; the server reads the name and Payer ID back out of the catalog.
    dmeTypeahead({
        input: '#payerSearch', hidden: '#insPayerId', results: '#payerResults', chosen: '#payerChosen',
        url: '/Lookups/Payers',
        emptyValue: '0',
        value: function (p) { return p.id; },
        label: function (p) { return p.name; },
        side:  function (p) { return p.code; },
        note:  function (p) { return 'Payer ID ' + p.code; },
        empty: 'No payer matches that. Check the spelling, or the Payer ID on the card.'
    });

    // Diagnosis: the whole CMS ICD-10-CM code set. The code is posted and the
    // description is read from the catalog, so a mistyped code files nothing
    // rather than a diagnosis with no wording.
    dmeTypeahead({
        input: '#dxSearch', hidden: '#dxCode', results: '#dxResults', chosen: '#dxChosen',
        url: '/Lookups/Icd',
        value: function (d) { return d.code; },
        label: function (d) { return d.name; },
        side:  function (d) { return d.code; },
        note:  function (d) { return 'ICD-10 ' + d.code; },
        empty: 'No diagnosis matches that. Try a condition, or the ICD-10 code.'
    });
</script>
