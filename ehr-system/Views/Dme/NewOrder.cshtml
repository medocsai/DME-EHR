@using EHR.Helpers
@{
    ViewData["ActivePage"] = "orders";
    var customers = (List<Dictionary<string, object?>>)ViewBag.Customers;
    var doctors = (List<Dictionary<string, object?>>)ViewBag.Doctors;
    var catalog = (List<Dictionary<string, object?>>)ViewBag.Catalog;
    int pre = ViewBag.PreCustomer == null ? 0 : (int)ViewBag.PreCustomer;
}

<div class="dme-wrap">
    <a href="/Dme/Orders" class="dme-muted" style="font-size:13px;text-decoration:none"><i class="bi bi-arrow-left"></i> Orders</a>
    <div class="dme-head" style="margin-top:6px"><div><h1>New Order</h1><div class="dme-sub">Customer → items → delivery</div></div></div>

    @if (TempData["OrderError"] != null)
    {
        <div class="dme-banner" style="background:#fdecea;border-color:#f5c2c0;color:#8a1c13">
            <i class="bi bi-exclamation-triangle"></i> @TempData["OrderError"]
        </div>
    }

    <form method="post" action="/Dme/CreateOrder" id="orderForm">
        @Html.AntiForgeryToken()
        <div class="dme-grid2">
            <div class="dme-card">
                <div class="dme-card-head"><h2>Order details</h2></div>
                <div class="dme-card-body">
                    <div class="mb-3">
                        <label class="form-label">Customer <span style="color:#d6453f">*</span></label>
                        <select name="customerId" class="form-select" required>
                            <option value="">Choose a customer…</option>
                            @foreach (var c in customers)
                            {
                                <option value="@F.I(c["CustomerId"])" selected="@(F.I(c["CustomerId"]) == pre)">@F.S(c["LastName"]), @F.S(c["FirstName"]) — @F.S(c["AccountNo"])</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Referring doctor</label>
                        <select name="doctorId" class="form-select">
                            <option value="">Select…</option>
                            @foreach (var d in doctors)
                            {
                                <option value="@F.I(d["DoctorId"])">Dr. @F.S(d["FirstName"]) @F.S(d["LastName"]) (NPI @F.S(d["Npi"]))</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        <div class="col-6"><label class="form-label">Delivery date</label><input type="date" name="deliveryDate" class="form-control" /></div>
                        <div class="col-6"><label class="form-label">Deposit ($)</label><input type="number" step="0.01" name="deposit" class="form-control" value="0" /></div>
                    </div>
                </div>
            </div>

            <div class="dme-card">
                <div class="dme-card-head"><h2>Items</h2></div>
                <div class="dme-card-body">
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-12">
                            <label class="form-label">Add HCPCS item</label>
                            <select id="itemSel" class="form-select">
                                @foreach (var x in catalog)
                                {
                                    <option value="@F.S(x["Hcpcs"])"
                                            data-name="@F.S(x["Name"])"
                                            data-rentable="@(F.B(x["Rentable"]) ? "1" : "0")"
                                            data-purchasable="@(F.B(x["Purchasable"]) ? "1" : "0")"
                                            data-buy="@F.Dec(x["PurchasePrice"]).ToString("0.00")"
                                            data-rent="@F.Dec(x["MonthlyRate"]).ToString("0.00")">@F.S(x["Hcpcs"]) — @F.S(x["Name"])</option>
                                }
                            </select>
                        </div>
                        <div class="col-5"><label class="form-label">Mode</label><select id="modeSel" class="form-select"></select></div>
                        <div class="col-3"><label class="form-label">Qty</label><input type="number" id="qtyIn" class="form-control" value="1" min="1" /></div>
                        <div class="col-4"><button type="button" id="addBtn" class="dme-btn dme-btn-light w-100">Add item</button></div>
                    </div>
                    <table class="dme-table" id="lineTable"><tbody></tbody></table>
                    <div id="noLines" class="dme-muted" style="font-size:13px">No items added yet.</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a href="/Dme/Orders" class="dme-btn dme-btn-light">Cancel</a>
            <button type="submit" class="dme-btn dme-btn-primary"><i class="bi bi-check-lg"></i> Create Order</button>
        </div>
    </form>
</div>

<script>
    (function () {
        var itemSel = document.getElementById('itemSel'), modeSel = document.getElementById('modeSel');
        function refreshModes() {
            var o = itemSel.options[itemSel.selectedIndex]; modeSel.innerHTML = '';
            if (o.dataset.purchasable === '1') modeSel.add(new Option('Buy $' + o.dataset.buy, 'purchase'));
            if (o.dataset.rentable === '1') modeSel.add(new Option('Rent $' + o.dataset.rent + '/mo', 'rental'));
            if (!modeSel.options.length) modeSel.add(new Option('Buy $' + o.dataset.buy, 'purchase'));
        }
        itemSel.addEventListener('change', refreshModes); refreshModes();
        document.getElementById('addBtn').addEventListener('click', function () {
            var o = itemSel.options[itemSel.selectedIndex];
            var mode = modeSel.value, qty = Math.max(1, parseInt(document.getElementById('qtyIn').value) || 1);
            var price = mode === 'purchase' ? ('$' + o.dataset.buy) : ('$' + o.dataset.rent + '/mo');
            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td><span class="dme-chip blue dme-mono">' + o.value + '</span> ' + o.dataset.name +
                '<input type="hidden" name="hcpcs" value="' + o.value + '"><input type="hidden" name="mode" value="' + mode + '"><input type="hidden" name="qty" value="' + qty + '"></td>' +
                '<td>' + (mode === 'purchase' ? 'Purchase' : 'Rental') + '</td><td class="dme-mono">' + qty + '</td><td class="dme-mono">' + price + '</td>' +
                '<td style="text-align:right"><button type="button" class="dme-btn dme-btn-light dme-btn-sm rm">remove</button></td>';
            tr.querySelector('.rm').onclick = function () { tr.remove(); toggleEmpty(); };
            document.querySelector('#lineTable tbody').appendChild(tr); toggleEmpty();
        });
        function toggleEmpty() { document.getElementById('noLines').style.display = document.querySelector('#lineTable tbody').children.length ? 'none' : 'block'; }
    })();
</script>
