@using EHR.Helpers
@*
    The heading and the error banner. Everything else is _OrderForm, which
    Edit order renders too: see the note at the top of that file for why these
    two screens are one form.
*@
@{
    ViewData["ActivePage"] = "orders";
}

<div class="dme-wrap">
    <a href="/Dme/Orders" class="dme-muted" style="font-size:13px;text-decoration:none"><i class="bi bi-arrow-left"></i> Orders</a>
    <div class="dme-head" style="margin-top:6px"><div><h1>New Order</h1><div class="dme-sub">Customer &rarr; items &rarr; delivery</div></div></div>

    @if (TempData["OrderError"] != null)
    {
        <div class="dme-banner" style="background:#fdecea;border-color:#f5c2c0;color:#8a1c13">
            <i class="bi bi-exclamation-triangle"></i> @TempData["OrderError"]
        </div>
    }

    @await Html.PartialAsync("_OrderForm")
</div>
