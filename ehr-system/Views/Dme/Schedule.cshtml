@{ ViewData["ActivePage"] = "schedule"; }

<div class="dme-wrap">
    <div class="dme-head">
        <div><h1>Schedule</h1><div class="dme-sub">Deliveries · pickups · setups · service visits</div></div>
        <a href="/Dme/NewOrder" class="dme-btn dme-btn-primary"><i class="bi bi-truck"></i> New Delivery</a>
    </div>

    <div class="dme-card">
        <div class="dme-card-body">
            <div style="display:flex;gap:18px;flex-wrap:wrap;margin-bottom:12px;font-size:12.5px" class="dme-muted">
                <span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:#2f6bdf;vertical-align:middle"></span> Delivery</span>
                <span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:#ba7517;vertical-align:middle"></span> Pickup</span>
                <span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:#0c7d72;vertical-align:middle"></span> Maintenance / O2 check</span>
                <span><span style="display:inline-block;width:11px;height:11px;border-radius:3px;background:#7a3ff2;vertical-align:middle"></span> Setup / Rental billing</span>
            </div>
            <div id="dmeCalendar"></div>
        </div>
    </div>
</div>

<script>
    (function () {
        var EVENTS = @Html.Raw(ViewBag.EventsJson);
        function init() {
            var el = document.getElementById('dmeCalendar');
            if (!el) return;
            if (!window.FullCalendar) { setTimeout(init, 200); return; }
            var cal = new FullCalendar.Calendar(el, {
                initialView: 'timeGridWeek',
                height: 'auto',
                nowIndicator: true,
                slotMinTime: '07:00:00',
                slotMaxTime: '19:00:00',
                allDaySlot: true,
                headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,timeGridWeek,timeGridDay' },
                eventTimeFormat: { hour: 'numeric', minute: '2-digit', meridiem: 'short' },
                events: EVENTS,
                eventContent: function (arg) {
                    var time = arg.timeText ? '<span style="opacity:.9;font-weight:500">' + arg.timeText + '</span> · ' : '';
                    return { html: '<div style="padding:2px 6px;color:#fff;font-size:11px;line-height:1.3;font-weight:600;overflow:hidden;white-space:normal">' + time + (arg.event.title || '') + '</div>' };
                }
            });
            cal.render();
            setTimeout(function () { cal.updateSize(); }, 500);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(init, 300); });
        else setTimeout(init, 300);
    })();
</script>
