@{
    ViewData["Title"] = "Encounter Workspace";
    ViewData["ActivePage"] = "encounter";
}

<!-- Encounter Workspace Page -->
<div class="page active" id="encounterWorkspacePage">

    <!-- Loading State -->
    <div id="encounterLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3 text-muted">Loading encounter...</p>
    </div>

    <!-- Error State -->
    <div id="encounterError" class="d-none text-center py-5">
        <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
        <h5 class="mt-3">Encounter Not Found</h5>
        <p class="text-muted">The encounter could not be loaded.</p>
        <a href="/Home/Dashboard" class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>

    <!-- Main Encounter Content (hidden until loaded) -->
    <div id="encounterContent" class="d-none">

        <!-- Header Bar -->
        <div id="encounterHeader"></div>

        <!-- Body: Sidebar + Main Area -->
        <div class="d-flex" id="encounterBody">
            <!-- Wizard Sidebar -->
            <div id="encounterSidebar"></div>
            <!-- Main Step Content -->
            <div id="encounterMain" class="flex-grow-1"></div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_Modals" />
    <partial name="_ModalsPrescription" />
    <partial name="_ModalsOrders" />
}

@section Scripts {
}
