@model List<EHR.Controllers.HcpcsRow>
@{
    ViewData["ActivePage"] = "hcpcs";
}

<div class="dme-wrap" style="padding:22px 26px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;">
        <div>
            <h1 style="font-size:22px;font-weight:700;margin:0;">HCPCS Catalog</h1>
            <div style="color:#6b7280;font-size:13px;margin-top:2px;">
                @Model.Count items · HCPCS Level II · purchase / rental pricing
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span style="background:#eaf1fd;color:#1f4fb0;font-weight:700;font-size:12px;padding:5px 12px;border-radius:999px;">DME</span>
            <button type="button" class="dme-btn dme-btn-primary dme-btn-sm" id="addItemToggle">
                <i class="bi bi-plus-lg"></i> Add item
            </button>
        </div>
    </div>

    @if (ViewBag.ItemError != null)
    {
        <div class="alert alert-danger" style="font-size:13px">@ViewBag.ItemError</div>
    }
    @if (ViewBag.ItemAdded != null)
    {
        <div class="alert alert-success" style="font-size:13px">@ViewBag.ItemAdded</div>
    }

    @* Add an item to THIS supplier's catalog by naming a code from the CMS
       national list of 8,623. The catalog used to hold 22 items with no way to
       add a 23rd, which is what the client reported. What is saved here is the
       supplier's own fact: their name for the item, their price, their terms. *@
    <div class="dme-card" id="addItemCard" style="display:none;">
        <div class="dme-card-head"><h2 id="itemCardTitle">Add an item to your catalog</h2></div>
        <div class="dme-card-body">
            <form method="post" action="/Hcpcs/AddItem" id="itemForm">
                @Html.AntiForgeryToken()
                @* Empty when adding. Filled by the edit button, which also points
                   the form at EditItem. *@
                <input type="hidden" name="id" id="itemId" value="" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">HCPCS code</label>
                        <div class="dme-typeahead">
                            <input type="text" id="hcpcsSearch" class="form-control" autocomplete="off"
                                   placeholder="Search the national list by description or code…" />
                            <input type="hidden" name="hcpcs" id="hcpcsCode" value="" />
                            <div id="hcpcsResults" class="dme-typeahead-list" hidden></div>
                        </div>
                        <div id="hcpcsChosen" class="form-text" style="font-size:11px" hidden></div>
                        @* Shown instead of the picker while editing. The code is CMS's and
                           past orders point at it, so it is not something to retype. *@
                        <div id="hcpcsFixed" class="form-text dme-mono" style="font-size:13px" hidden></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Category</label>
                        <input name="category" class="form-control" placeholder="e.g. Respiratory" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Your name for it</label>
                        <input name="name" id="hcpcsName" class="form-control"
                               placeholder="Defaults to the CMS short description" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Purchase price ($)</label>
                        <input type="number" step="0.01" name="purchasePrice" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Monthly rate ($)</label>
                        <input type="number" step="0.01" name="monthlyRate" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Rental cap (months)</label>
                        <input type="number" name="cappedRentalMonths" class="form-control" value="0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Reorder point</label>
                        <input type="number" name="reorderPoint" class="form-control" value="0" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Modifiers</label>
                        <input name="modifiers" class="form-control" placeholder="e.g. RR, KX" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end gap-3 pb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="purchasable" value="true" id="chkBuy" checked />
                            <label class="form-check-label" for="chkBuy">Sold</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="rentable" value="true" id="chkRent" />
                            <label class="form-check-label" for="chkRent">Rented</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isSerialized" value="true" id="chkSer" />
                            <label class="form-check-label" for="chkSer">Serialized</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button type="button" class="dme-btn dme-btn-light" id="addItemCancel">Cancel</button>
                    <button type="submit" class="dme-btn dme-btn-primary" id="itemSubmit"><i class="bi bi-check-lg"></i> Add to catalog</button>
                </div>
            </form>
        </div>
    </div>

    <div style="background:#fff;border:1px solid #e6e9ef;border-radius:14px;box-shadow:0 1px 2px rgba(20,30,50,.05),0 8px 24px rgba(20,30,50,.05);overflow:hidden;">
        <table class="table" style="margin:0;font-size:13.5px;">
            <thead>
                <tr style="background:#f6f8fb;">
                    <th style="padding:12px 14px;">HCPCS</th>
                    <th style="padding:12px 14px;">Item</th>
                    <th style="padding:12px 14px;">Category</th>
                    <th style="padding:12px 14px;">Type</th>
                    <th style="padding:12px 14px;">Pricing</th>
                    <th style="padding:12px 14px;">Cap</th>
                    <th style="padding:12px 14px;">On hand</th>
                    <th style="padding:12px 14px;">Mods</th>
                    <th style="padding:12px 14px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td style="padding:11px 14px;font-weight:600;font-variant-numeric:tabular-nums;">@i.Hcpcs</td>
                        <td style="padding:11px 14px;">@i.Name</td>
                        <td style="padding:11px 14px;"><span style="background:#eef1f5;color:#5b6776;font-size:11.5px;font-weight:600;padding:3px 10px;border-radius:999px;">@i.Category</span></td>
                        <td style="padding:11px 14px;">
                            @if (i.IsSerialized)
                            {
                                <span style="background:#eaf1fd;color:#1f4fb0;font-size:11.5px;font-weight:600;padding:3px 10px;border-radius:999px;">Serialized</span>
                            }
                            else
                            {
                                <span style="color:#9aa3af;">Bulk</span>
                            }
                        </td>
                        <td style="padding:11px 14px;font-variant-numeric:tabular-nums;">
                            @if (i.Purchasable)
                            {
                                <span>Sell $@i.PurchasePrice.ToString("N2")</span>
                            }
                            @if (i.Rentable)
                            {
                                <span style="color:#0c7d72;">@(i.Purchasable ? " · " : "")Rent $@i.MonthlyRate.ToString("N2")/mo</span>
                            }
                        </td>
                        <td style="padding:11px 14px;color:#6b7280;">@(i.CappedRentalMonths > 0 ? i.CappedRentalMonths + " mo" : "—")</td>
                        <td style="padding:11px 14px;font-variant-numeric:tabular-nums;">
                            @i.OnHand
                            @if (i.ReorderPoint > 0 && i.OnHand <= i.ReorderPoint)
                            {
                                <span style="background:#faeeda;color:#854f0b;font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:999px;margin-left:4px;">reorder</span>
                            }
                        </td>
                        <td style="padding:11px 14px;color:#6b7280;font-size:12px;">@i.Modifiers</td>
                        <td style="padding:11px 14px;text-align:right;">
                            @* Everything the form needs travels on the button, so opening it
                               costs no round trip. The HCPCS code is shown, never posted. *@
                            <button type="button" class="dme-btn dme-btn-light dme-btn-sm js-edit-item requires-admin"
                                    data-id="@i.HcpcsCodeId"
                                    data-code="@i.Hcpcs"
                                    data-name="@i.Name"
                                    data-category="@i.Category"
                                    data-buy="@i.PurchasePrice.ToString("0.00")"
                                    data-rate="@i.MonthlyRate.ToString("0.00")"
                                    data-cap="@i.CappedRentalMonths"
                                    data-reorder="@i.ReorderPoint"
                                    data-mods="@i.Modifiers"
                                    data-purchasable="@(i.Purchasable ? "1" : "0")"
                                    data-rentable="@(i.Rentable ? "1" : "0")"
                                    data-serialized="@(i.IsSerialized ? "1" : "0")">edit</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="color:#9aa3af;font-size:12px;margin-top:10px;">
        <i class="bi bi-info-circle"></i> Your catalog: what you stock, at your prices. Codes and their official
        wording come from the CMS national HCPCS Level II list, refreshed quarterly.
    </div>
</div>

<script>
    (function () {
        var card = document.getElementById('addItemCard');
        // One card, two jobs. addMode() is what the card looks like for a new
        // item; the edit buttons switch it over and back.
        var form   = document.getElementById('itemForm');
        var title  = document.getElementById('itemCardTitle');
        var submit = document.getElementById('itemSubmit');
        var idBox  = document.getElementById('itemId');
        var picker = document.querySelector('.dme-typeahead');
        var fixed_ = document.getElementById('hcpcsFixed');

        function setChecked(id, on) { document.getElementById(id).checked = on; }
        function setValue(name, v)  { form.querySelector('[name="' + name + '"]').value = v; }

        function addMode() {
            form.action = '/Hcpcs/AddItem';
            title.textContent = 'Add an item to your catalog';
            submit.innerHTML = '<i class="bi bi-check-lg"></i> Add to catalog';
            idBox.value = '';

            // The code picker only belongs in add mode.
            picker.hidden = false;
            fixed_.hidden = true;
            document.getElementById('hcpcsSearch').value = '';
            document.getElementById('hcpcsCode').value = '';
            document.getElementById('hcpcsChosen').hidden = true;

            ['name', 'category', 'modifiers'].forEach(function (n) { setValue(n, ''); });
            ['purchasePrice', 'monthlyRate', 'cappedRentalMonths', 'reorderPoint']
                .forEach(function (n) { setValue(n, '0'); });
            setChecked('chkBuy', true);
            setChecked('chkRent', false);
            setChecked('chkSer', false);
        }

        function editMode(b) {
            form.action = '/Hcpcs/EditItem';
            title.textContent = 'Edit ' + b.dataset.code;
            submit.innerHTML = '<i class="bi bi-check-lg"></i> Save changes';
            idBox.value = b.dataset.id;

            // The code is CMS's and past orders point at it, so it is shown, not
            // offered for editing. Changing a code is really "retire this item
            // and add the right one".
            picker.hidden = true;
            fixed_.hidden = false;
            fixed_.textContent = b.dataset.code;

            setValue('name', b.dataset.name);
            setValue('category', b.dataset.category);
            setValue('purchasePrice', b.dataset.buy);
            setValue('monthlyRate', b.dataset.rate);
            setValue('cappedRentalMonths', b.dataset.cap);
            setValue('reorderPoint', b.dataset.reorder);
            setValue('modifiers', b.dataset.mods);
            setChecked('chkBuy', b.dataset.purchasable === '1');
            setChecked('chkRent', b.dataset.rentable === '1');
            setChecked('chkSer', b.dataset.serialized === '1');
        }

        document.getElementById('addItemToggle').addEventListener('click', function () {
            var opening = card.style.display === 'none';
            addMode();
            card.style.display = opening ? '' : 'none';
            if (opening) document.getElementById('hcpcsSearch').focus();
        });

        document.getElementById('addItemCancel').addEventListener('click', function () {
            card.style.display = 'none';
            addMode();
        });

        Array.prototype.forEach.call(document.querySelectorAll('.js-edit-item'), function (b) {
            b.addEventListener('click', function () {
                editMode(b);
                card.style.display = '';
                card.scrollIntoView({ behavior: 'smooth', block: 'start' });
                form.querySelector('[name="name"]').focus();
            });
        });
    })();

    // The national list. Only the code is posted; the server checks it is real
    // and still billable before anything is filed.
    dmeTypeahead({
        input: '#hcpcsSearch', hidden: '#hcpcsCode', results: '#hcpcsResults', chosen: '#hcpcsChosen',
        url: '/Lookups/Hcpcs',
        value: function (h) { return h.code; },
        label: function (h) { return h.name; },
        side:  function (h) { return h.code + (h.retired ? ' · retired' : (h.noPay ? ' · Medicare N/A' : '')); },
        note:  function (h) {
            // Pre-fill the item name with CMS's short description, which the
            // supplier is then free to overwrite with what they call it.
            var nameBox = document.getElementById('hcpcsName');
            if (nameBox && !nameBox.value) nameBox.value = h.shortName;
            return h.code + (h.retired ? ' — retired, cannot be billed'
                                       : (h.noPay ? ' — Medicare does not pay for this' : ''));
        },
        empty: 'No HCPCS code matches that.'
    });
</script>
