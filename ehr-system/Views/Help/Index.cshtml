@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IMEHR Documentation</title>
    <link rel="icon" type="image/png" href="/medocslogo.png">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        /* ======================================== */
        /* Documentation Page Styles                */
        /* ======================================== */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f8f9fc;
            color: #1f2937;
            line-height: 1.6;
        }

        /* --- Header --- */
        .doc-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 56px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            padding: 0 24px;
            z-index: 100;
            gap: 16px;
        }

        .doc-header-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #1f2937;
            font-weight: 700;
            font-size: 16px;
            flex-shrink: 0;
        }

        .doc-header-brand img {
            height: 28px;
        }

        .doc-header-divider {
            width: 1px;
            height: 24px;
            background: #e5e7eb;
            flex-shrink: 0;
        }

        .doc-header-title {
            font-size: 15px;
            font-weight: 600;
            color: #6366f1;
            flex-shrink: 0;
        }

        .doc-search-wrapper {
            flex: 1;
            max-width: 400px;
            margin-left: auto;
            position: relative;
        }

        .doc-search-input {
            width: 100%;
            padding: 7px 36px 7px 34px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            font-size: 13.5px;
            outline: none;
            transition: border-color 0.15s;
            font-family: inherit;
        }

        .doc-search-input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
        }

        .doc-search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 14px;
            pointer-events: none;
        }

        .doc-search-clear {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #9ca3af;
            cursor: pointer;
            font-size: 13px;
            display: none;
            padding: 2px 4px;
        }

        .doc-search-clear:hover { color: #6b7280; }

        .doc-search-count {
            position: absolute;
            right: 30px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 11px;
            color: #9ca3af;
            display: none;
        }

        .doc-back-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            color: #374151;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.15s;
            flex-shrink: 0;
        }

        .doc-back-btn:hover {
            background: #e5e7eb;
            color: #1f2937;
        }

        /* --- Layout --- */
        .doc-container {
            display: flex;
            margin-top: 56px;
            min-height: calc(100vh - 56px);
        }

        /* --- Sidebar / TOC --- */
        .doc-sidebar {
            width: 280px;
            background: white;
            border-right: 1px solid #e5e7eb;
            position: fixed;
            top: 56px;
            bottom: 0;
            left: 0;
            overflow-y: auto;
            padding: 20px 0;
            flex-shrink: 0;
        }

        .doc-sidebar::-webkit-scrollbar { width: 5px; }
        .doc-sidebar::-webkit-scrollbar-track { background: transparent; }
        .doc-sidebar::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 3px; }

        .doc-sidebar-title {
            padding: 0 20px 12px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #9ca3af;
        }

        .doc-toc-item {
            display: flex;
            align-items: center;
            padding: 8px 20px;
            color: #4b5563;
            text-decoration: none;
            font-size: 13.5px;
            transition: all 0.15s;
            border-left: 3px solid transparent;
            cursor: pointer;
        }

        .doc-toc-item:hover {
            background: #f8f9fc;
            color: #1f2937;
        }

        .doc-toc-item.active {
            background: #eff0ff;
            color: #4f46e5;
            border-left-color: #6366f1;
            font-weight: 600;
        }

        .doc-toc-number {
            width: 24px;
            height: 24px;
            background: #f3f4f6;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            color: #6b7280;
            margin-right: 10px;
            flex-shrink: 0;
        }

        .doc-toc-item.active .doc-toc-number {
            background: #6366f1;
            color: white;
        }

        /* --- Main Content --- */
        .doc-main {
            flex: 1;
            margin-left: 280px;
            padding: 32px 48px 80px;
            max-width: 900px;
        }

        .doc-main h1 {
            font-size: 30px;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 8px;
            padding-bottom: 16px;
            border-bottom: 3px solid #6366f1;
        }

        .doc-main h2 {
            font-size: 22px;
            font-weight: 700;
            color: #1f2937;
            margin: 40px 0 16px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e5e7eb;
            scroll-margin-top: 80px;
        }

        .doc-main h3 {
            font-size: 17px;
            font-weight: 600;
            color: #374151;
            margin: 28px 0 10px;
            scroll-margin-top: 80px;
        }

        .doc-main h4 {
            font-size: 15px;
            font-weight: 600;
            color: #4b5563;
            margin: 20px 0 8px;
            scroll-margin-top: 80px;
        }

        .doc-main p {
            margin-bottom: 12px;
            color: #374151;
            line-height: 1.7;
        }

        .doc-main ul, .doc-main ol {
            margin: 8px 0 16px;
            padding-left: 24px;
        }

        .doc-main li {
            margin-bottom: 6px;
            color: #374151;
            line-height: 1.6;
        }

        .doc-main code {
            background: #fef2f2;
            color: #dc2626;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.9em;
            font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
        }

        .doc-main pre {
            background: #1f2937;
            color: #e5e7eb;
            padding: 16px 20px;
            border-radius: 8px;
            overflow-x: auto;
            margin: 12px 0 16px;
            font-size: 13px;
            line-height: 1.5;
        }

        .doc-main pre code {
            background: none;
            color: inherit;
            padding: 0;
        }

        .doc-main blockquote {
            border-left: 4px solid #6366f1;
            background: #eff0ff;
            padding: 12px 20px;
            margin: 12px 0 16px;
            border-radius: 0 8px 8px 0;
            color: #4b5563;
            font-style: italic;
        }

        .doc-main blockquote p { margin-bottom: 0; }

        .doc-main table {
            width: 100%;
            border-collapse: collapse;
            margin: 12px 0 20px;
            font-size: 14px;
        }

        .doc-main th {
            background: #f3f4f6;
            padding: 10px 14px;
            text-align: left;
            font-weight: 600;
            border: 1px solid #e5e7eb;
        }

        .doc-main td {
            padding: 10px 14px;
            border: 1px solid #e5e7eb;
        }

        .doc-main tr:hover td {
            background: #f8f9fc;
        }

        .doc-main hr {
            border: none;
            border-top: 1px solid #e5e7eb;
            margin: 32px 0;
        }

        .doc-main a {
            color: #6366f1;
            text-decoration: none;
        }

        .doc-main a:hover { text-decoration: underline; }

        /* --- Search Highlighting --- */
        .doc-search-highlight {
            background: #fef08a;
            padding: 1px 2px;
            border-radius: 2px;
        }

        .doc-search-highlight.current {
            background: #fb923c;
            color: white;
        }

        /* --- Scroll to Top --- */
        .doc-scroll-top {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 40px;
            height: 40px;
            background: #6366f1;
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
            transition: all 0.15s;
            z-index: 50;
        }

        .doc-scroll-top:hover {
            background: #4f46e5;
            transform: translateY(-2px);
        }

        /* --- Need More Help Button --- */
        .doc-open-help-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: linear-gradient(135deg, #6366f1, #4f46e5);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s;
            margin-top: 8px;
        }

        .doc-open-help-btn:hover {
            box-shadow: 0 4px 16px rgba(99, 102, 241, 0.4);
            transform: translateY(-1px);
            color: white;
            text-decoration: none;
        }

        /* --- Loading State --- */
        .doc-loading {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 80px 20px;
            color: #6b7280;
        }

        .doc-loading-spinner {
            width: 40px;
            height: 40px;
            border: 3px solid #e5e7eb;
            border-top-color: #6366f1;
            border-radius: 50%;
            animation: docSpin 0.8s linear infinite;
            margin-bottom: 16px;
        }

        @@keyframes docSpin {
            to { transform: rotate(360deg); }
        }

        /* --- Mobile Sidebar Toggle --- */
        .doc-sidebar-toggle {
            display: none;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            color: #374151;
            flex-shrink: 0;
        }

        .doc-sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
            z-index: 89;
        }

        /* --- Responsive --- */
        @@media (max-width: 992px) {
            .doc-sidebar {
                transform: translateX(-100%);
                z-index: 90;
                transition: transform 0.2s ease;
            }

            .doc-sidebar.open {
                transform: translateX(0);
            }

            .doc-sidebar-toggle {
                display: flex;
            }

            .doc-sidebar-overlay.open {
                display: block;
            }

            .doc-main {
                margin-left: 0;
                padding: 24px 20px 60px;
            }
        }

        @@media (max-width: 575px) {
            .doc-header {
                padding: 0 12px;
                gap: 8px;
            }

            .doc-header-brand span { display: none; }
            .doc-header-divider { display: none; }

            .doc-main h1 { font-size: 24px; }
            .doc-main h2 { font-size: 19px; }
            .doc-main { padding: 20px 16px 60px; }
        }

        @@media print {
            .doc-header, .doc-sidebar, .doc-scroll-top, .doc-sidebar-toggle { display: none !important; }
            .doc-main { margin-left: 0; padding: 20px; max-width: 100%; }
            .doc-container { margin-top: 0; }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="doc-header">
        <button class="doc-sidebar-toggle" id="sidebarToggle" title="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>
        <a href="/" class="doc-header-brand">
            <img src="/medocslogo.png" alt="MEDOCS"> <span>IMEHR</span>
        </a>
        <div class="doc-header-divider"></div>
        <div class="doc-header-title">Documentation</div>
        <div class="doc-search-wrapper">
            <i class="bi bi-search doc-search-icon"></i>
            <input type="text" class="doc-search-input" id="searchInput" placeholder="Search documentation..." autocomplete="off">
            <span class="doc-search-count" id="searchCount"></span>
            <button class="doc-search-clear" id="searchClear"><i class="bi bi-x"></i></button>
        </div>
        <a href="/" class="doc-back-btn">
            <i class="bi bi-arrow-left"></i> Back to App
        </a>
    </header>

    <!-- Sidebar Overlay (mobile) -->
    <div class="doc-sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Layout -->
    <div class="doc-container">
        <!-- Sidebar / TOC -->
        <aside class="doc-sidebar" id="docSidebar">
            <div class="doc-sidebar-title">Table of Contents</div>
            <nav id="tocNav"></nav>
        </aside>

        <!-- Main Content -->
        <main class="doc-main" id="docContent">
            <div class="doc-loading" id="docLoading">
                <div class="doc-loading-spinner"></div>
                <p>Loading documentation...</p>
            </div>
        </main>
    </div>

    <!-- Scroll to Top -->
    <button class="doc-scroll-top" id="scrollTopBtn" title="Scroll to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script>
        (function () {
            // ============================================
            // Auth Check
            // ============================================
            const token = localStorage.getItem('authToken') || sessionStorage.getItem('authToken');
            const docContent = document.getElementById('docContent');
            const docLoading = document.getElementById('docLoading');

            if (!token) {
                docLoading.innerHTML = `
                    <p style="color: #dc2626;">You must be logged in to view documentation.</p>
                    <a href="/" style="color: #6366f1; margin-top: 12px; display: inline-block;">Go to Login</a>
                `;
                return;
            }

            // ============================================
            // Load Guide Content
            // ============================================
            fetch('/api/IMEHRHelp/guide', {
                headers: { 'Authorization': `Bearer ${token}` }
            })
                .then(res => {
                    if (res.status === 401) {
                        throw new Error('Session expired');
                    }
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    return res.json();
                })
                .then(data => {
                    if (!data.content) {
                        docLoading.innerHTML = '<p style="color: #6b7280;">Documentation not available.</p>';
                        return;
                    }
                    renderDocumentation(data.content);
                })
                .catch(err => {
                    console.error('Error loading documentation:', err);
                    const isAuthErr = err.message.includes('401') || err.message.includes('Session expired');
                    docLoading.innerHTML = isAuthErr
                        ? `<p style="color: #dc2626;">Session expired. Please log in again.</p>
                           <a href="/" style="color: #6366f1; margin-top: 12px; display: inline-block;">Go to Login</a>`
                        : `<p style="color: #dc2626;">Failed to load documentation. Please try again.</p>`;
                });

            // ============================================
            // Render Documentation
            // ============================================
            function renderDocumentation(markdown) {
                // Remove the "knowledge source for AI" line from blockquote
                markdown = markdown.replace(/^>.*knowledge source.*$/gim, '');

                // Configure marked
                marked.setOptions({ gfm: true, breaks: false });

                const html = marked.parse(markdown);
                docContent.innerHTML = html;

                buildTOC();
                initScrollSpy();
                initSearch();
                initScrollToTop();
                addHelpButton();
            }

            // ============================================
            // Build Table of Contents
            // ============================================
            function buildTOC() {
                const tocNav = document.getElementById('tocNav');
                const headings = docContent.querySelectorAll('h2');

                headings.forEach((h2, idx) => {
                    const text = h2.textContent.trim();
                    // Create slug ID
                    const slug = 'section-' + text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
                    h2.id = slug;

                    // Extract number prefix if present (e.g., "1. Getting Started")
                    const numMatch = text.match(/^(\d+)\.\s*(.+)/);
                    const number = numMatch ? numMatch[1] : String(idx + 1);
                    const title = numMatch ? numMatch[2] : text;

                    const item = document.createElement('a');
                    item.className = 'doc-toc-item';
                    item.href = '#' + slug;
                    item.innerHTML = `<span class="doc-toc-number">${number}</span><span>${escapeHtml(title)}</span>`;
                    item.addEventListener('click', (e) => {
                        e.preventDefault();
                        h2.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        closeSidebar();
                    });

                    tocNav.appendChild(item);
                });
            }

            // ============================================
            // Scroll Spy
            // ============================================
            function initScrollSpy() {
                const tocItems = document.querySelectorAll('.doc-toc-item');
                const headings = docContent.querySelectorAll('h2[id]');

                let ticking = false;
                window.addEventListener('scroll', () => {
                    if (!ticking) {
                        requestAnimationFrame(() => {
                            let currentId = '';
                            headings.forEach(h => {
                                if (h.getBoundingClientRect().top <= 100) {
                                    currentId = h.id;
                                }
                            });

                            tocItems.forEach(item => {
                                const isActive = item.getAttribute('href') === '#' + currentId;
                                item.classList.toggle('active', isActive);
                                if (isActive) {
                                    item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                                }
                            });

                            ticking = false;
                        });
                        ticking = true;
                    }
                });
            }

            // ============================================
            // Search / Find
            // ============================================
            function initSearch() {
                const searchInput = document.getElementById('searchInput');
                const searchCount = document.getElementById('searchCount');
                const searchClear = document.getElementById('searchClear');
                let debounceTimer = null;
                let currentMatchIndex = -1;
                let totalMatches = 0;

                searchInput.addEventListener('input', () => {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        performSearch(searchInput.value.trim());
                        currentMatchIndex = -1;
                    }, 250);
                });

                searchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && totalMatches > 0) {
                        e.preventDefault();
                        currentMatchIndex = (currentMatchIndex + 1) % totalMatches;
                        highlightCurrentMatch(currentMatchIndex);
                        searchCount.textContent = `${currentMatchIndex + 1} of ${totalMatches}`;
                    }
                    if (e.key === 'Escape') {
                        clearSearch();
                        searchInput.blur();
                    }
                });

                searchClear.addEventListener('click', clearSearch);

                // Ctrl+F / Cmd+F focus search
                document.addEventListener('keydown', (e) => {
                    if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
                        e.preventDefault();
                        searchInput.focus();
                        searchInput.select();
                    }
                });

                function performSearch(query) {
                    clearHighlights();
                    totalMatches = 0;

                    if (!query) {
                        searchCount.style.display = 'none';
                        searchClear.style.display = 'none';
                        return;
                    }

                    searchClear.style.display = 'block';
                    const regex = new RegExp(escapeRegex(query), 'gi');
                    const walker = document.createTreeWalker(docContent, NodeFilter.SHOW_TEXT, null);

                    const matches = [];
                    while (walker.nextNode()) {
                        const node = walker.currentNode;
                        if (node.parentElement.closest('.doc-loading')) continue;
                        if (regex.test(node.textContent)) {
                            matches.push(node);
                        }
                        regex.lastIndex = 0;
                    }

                    matches.forEach(node => {
                        const text = node.textContent;
                        const parts = text.split(regex);
                        if (parts.length <= 1) return;

                        const frag = document.createDocumentFragment();
                        let matchIdx = 0;
                        regex.lastIndex = 0;
                        let match;
                        let lastIdx = 0;

                        while ((match = regex.exec(text)) !== null) {
                            // Text before match
                            if (match.index > lastIdx) {
                                frag.appendChild(document.createTextNode(text.slice(lastIdx, match.index)));
                            }
                            // Highlighted match
                            const span = document.createElement('span');
                            span.className = 'doc-search-highlight';
                            span.textContent = match[0];
                            frag.appendChild(span);
                            totalMatches++;
                            lastIdx = regex.lastIndex;
                        }
                        // Remaining text
                        if (lastIdx < text.length) {
                            frag.appendChild(document.createTextNode(text.slice(lastIdx)));
                        }

                        node.parentNode.replaceChild(frag, node);
                    });

                    searchCount.textContent = totalMatches > 0 ? `${totalMatches} found` : 'No results';
                    searchCount.style.display = 'inline';

                    // Scroll to first match
                    if (totalMatches > 0) {
                        const first = docContent.querySelector('.doc-search-highlight');
                        if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }

                function highlightCurrentMatch(index) {
                    const highlights = docContent.querySelectorAll('.doc-search-highlight');
                    highlights.forEach(h => h.classList.remove('current'));
                    if (highlights[index]) {
                        highlights[index].classList.add('current');
                        highlights[index].scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }

                function clearSearch() {
                    searchInput.value = '';
                    searchCount.style.display = 'none';
                    searchClear.style.display = 'none';
                    totalMatches = 0;
                    currentMatchIndex = -1;
                    clearHighlights();
                }

                function clearHighlights() {
                    docContent.querySelectorAll('.doc-search-highlight').forEach(span => {
                        const text = document.createTextNode(span.textContent);
                        span.parentNode.replaceChild(text, span);
                    });
                    // Normalize text nodes
                    docContent.normalize();
                }
            }

            // ============================================
            // Scroll to Top
            // ============================================
            function initScrollToTop() {
                const btn = document.getElementById('scrollTopBtn');
                window.addEventListener('scroll', () => {
                    btn.style.display = window.scrollY > 400 ? 'flex' : 'none';
                });
                btn.addEventListener('click', () => {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // ============================================
            // Need More Help Button
            // ============================================
            function addHelpButton() {
                const headings = docContent.querySelectorAll('h2');
                headings.forEach(h => {
                    if (h.textContent.toLowerCase().includes('need more help')) {
                        // Insert button after the section content
                        const next = h.nextElementSibling;
                        if (next) {
                            const wrapper = document.createElement('div');
                            wrapper.style.marginTop = '16px';
                            wrapper.innerHTML = `<a href="/?openHelp=1" class="doc-open-help-btn">
                                <i class="bi bi-robot"></i> Open MEDOCS AI Help
                            </a>`;
                            // Insert after last element in this section (before next h2)
                            let el = h.nextElementSibling;
                            let lastEl = el;
                            while (el && el.tagName !== 'H2') {
                                lastEl = el;
                                el = el.nextElementSibling;
                            }
                            if (lastEl) {
                                lastEl.parentNode.insertBefore(wrapper, lastEl.nextSibling);
                            }
                        }
                    }
                });
            }

            // ============================================
            // Mobile Sidebar
            // ============================================
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('docSidebar');
            const overlay = document.getElementById('sidebarOverlay');

            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.toggle('open');
                overlay.classList.toggle('open');
            });

            overlay.addEventListener('click', closeSidebar);

            function closeSidebar() {
                sidebar.classList.remove('open');
                overlay.classList.remove('open');
            }

            // ============================================
            // Utilities
            // ============================================
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }

            function escapeRegex(string) {
                return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            }
        })();
    </script>
</body>
</html>
