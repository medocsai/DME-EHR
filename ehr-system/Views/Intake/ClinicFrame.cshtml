@{
    Layout = null;
    var patientId = ViewBag.PatientId as int? ?? 0;
}
<!--
    Patient Intake — Clinic Staff Iframe Host (Step 1)

    Embedded inside the encounter via <iframe src="/clinic/patients/{id}/intake-frame">.
    Loads the same wizard renderer as the patient tablet view (TabletWizard.cshtml),
    but configured with staff endpoints under /api/clinic/patients/{id}/intake/...

    Auth: staff JWT/cookie validated by IntakeViewController.ClinicFrame.
    No "Hi, {firstName}" header, no "Save & Exit" link — staff is already authenticated
    in the parent encounter chrome; double chrome would be ugly.

    Spec: rules/technical/intake-on-clinical-note.md §3.1, §4.2.
-->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Intake</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background: #F8FAFC; margin: 0; min-height: 100vh; }
        .clinic-wizard-shell { padding: 16px; max-width: 1200px; margin: 0 auto; }
        .clinic-wizard-shell .form-control,
        .clinic-wizard-shell .form-select { min-height: 38px; }

        /*
         * Patient-only signoff customizations for the staff iframe view.
         *
         * The wizard's Review & Finish section ends with a "Submit Intake" button
         * that calls /submit on the patient/tablet API. The staff endpoint group
         * has no /submit by design (staff editing is not a submission event), so
         * clicking it would 405. Hide the button and replace it with a quiet
         * "Changes are saved." indicator — staff still see the section completion
         * summary cards (the actual value of Review & Finish for them) and the
         * Back button to navigate sections.
         *
         * Spec rule: do not change the wizard. CSS in this iframe-host view is
         * the cleanest deviation point — patient/tablet wizards are untouched.
         */
        #iwSubmitBtn { display: none !important; }
        /* Scope the "Changes are saved." indicator to the Review & Finish section
           only. .iw-actions is the action-button row used on every section, so a
           bare ::after would ghost the message onto every page. The :has() selector
           narrows it to the row that contains #iwSubmitBtn — which the wizard only
           renders on Review & Finish. :has() is supported in all modern browsers
           since late 2023. */
        .iw-actions:has(#iwSubmitBtn)::after {
            content: "Changes are saved.";
            color: #6c757d;
            font-size: 0.875rem;
            align-self: center;
            margin-left: auto;
        }
    </style>
</head>
<body>
    <div id="intakeWizardRoot"
         data-patient-id="@patientId"
         class="clinic-wizard-shell">
        <div class="text-center text-muted py-5">
            <div class="spinner-border spinner-border-sm me-2"></div> Loading intake form...
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Same wizard scaffolding as TabletWizard.cshtml. Section renderers + form
         renderer are unchanged (Step 1 hard rule: do not touch the wizard). -->
    <script src="~/js/modules/intake/IntakeFormRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeDemographicsRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeHealthConcernsRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeMedicalHistoryRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeLifestyleRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeMedicationsRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeGenderHealthRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeLongevityRenderer.js?v=1778510406"></script>
    <script src="~/js/modules/intake/sections/IntakeReviewRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/ClinicIntakeFrameModule.js?v=1777999100"></script>
</body>
</html>
