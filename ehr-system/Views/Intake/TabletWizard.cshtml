@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Patient Intake</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { background: #F8FAFC; margin: 0; min-height: 100vh; }
        .tablet-wizard-header {
            background: #fff; border-bottom: 1px solid #E2E8F0;
            padding: 12px 20px;
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 10;
        }
        .tablet-wizard-header .brand {
            font-weight: 600; color: #1B72BE; display: flex; align-items: center; gap: 8px;
        }
        .tablet-wizard-header .hello { font-weight: 600; color: #334155; }
        .tablet-wizard-shell { padding: 20px; max-width: 1200px; margin: 0 auto; }
        /* Touch-friendly sizing on tablet */
        .tablet-wizard-shell .btn { min-height: 48px; }
        .tablet-wizard-shell .form-control, .tablet-wizard-shell .form-select { min-height: 44px; }
        .tablet-thankyou {
            max-width: 520px; margin: 60px auto; text-align: center;
            background: #fff; border-radius: 16px; padding: 48px 32px;
            box-shadow: 0 8px 32px rgba(15, 23, 42, 0.08);
        }
        .tablet-thankyou .check {
            width: 90px; height: 90px; border-radius: 50%;
            background: #DCFCE7; color: #16A34A;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 46px; margin-bottom: 18px;
        }
    </style>
</head>
<body>
    <div class="tablet-wizard-header">
        <div class="brand"><i class="bi bi-clipboard-check"></i> Patient Intake</div>
        <div class="hello" id="tabletHello"></div>
    </div>

    <div id="intakeWizardRoot"
         data-token="@token"
         class="tablet-wizard-shell">
        <div class="text-center text-muted py-5">
            <div class="spinner-border spinner-border-sm me-2"></div> Loading intake form...
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Intake Contractor + Section Employees + Tablet host -->
    <script src="~/js/modules/intake/IntakeFormRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeDemographicsRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeHealthConcernsRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeMedicalHistoryRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeLifestyleRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeMedicationsRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeGenderHealthRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/sections/IntakeLongevityRenderer.js?v=1778510406"></script>
    <script src="~/js/modules/intake/sections/IntakeReviewRenderer.js?v=1777290055"></script>
    <script src="~/js/modules/intake/TabletIntakeWizardModule.js?v=1777422830"></script>
</body>
</html>
