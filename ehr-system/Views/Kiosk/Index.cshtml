@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Patient Check-In</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Kiosk CSS -->
    <link href="~/css/kiosk.css" rel="stylesheet">
    <!-- Signature Pad -->
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
</head>
<body>
    <div id="kioskPage">
        <!-- Loading Overlay -->
        <div id="loadingOverlay" class="kiosk-loading">
            <div class="kiosk-spinner"></div>
            <p class="mt-4" id="loadingMessage">Loading...</p>
        </div>

        <!-- Session Timeout Warning -->
        <div id="timeoutWarning" class="timeout-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Your session will expire in <strong id="timeoutCountdown">60</strong> seconds</span>
            <button class="kiosk-btn kiosk-btn-primary ms-3" onclick="extendSession()" style="height: 40px; padding: 8px 16px; font-size: 14px;">
                Continue
            </button>
        </div>

        <div class="kiosk-container">
            <!-- Header removed - clinic/location info takes too much space -->

            <!-- App-mode admin sign-out button (only visible when loaded in the Android kiosk app via ?app=1) -->
            <button type="button" id="kioskAppLogoutBtn" class="kiosk-app-logout" aria-label="Admin sign out" style="display:none;">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </button>

            <!-- Content -->
            <div class="kiosk-content">
                <!-- Error Screen -->
                <div id="errorScreen" class="screen kiosk-card">
                    <div class="error-screen">
                        <div class="error-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <h2 id="errorTitle" class="kiosk-card-title">Something Went Wrong</h2>
                        <p id="errorMessage" class="kiosk-card-subtitle">Please contact clinic staff for assistance.</p>
                    </div>
                </div>

                <!-- Verification Screen -->
                <div id="verificationScreen" class="screen kiosk-card">
                    <h2 class="kiosk-card-title">Patient Check-In</h2>
                    <p class="kiosk-card-subtitle">Please verify your identity to continue</p>

                    <div id="verificationError" class="kiosk-alert kiosk-alert-error" style="display: none;">
                        <i class="bi bi-exclamation-circle"></i>
                        <span id="verificationErrorText"></span>
                    </div>

                    <form id="verificationForm" autocomplete="off">
                        <!-- Last Name -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold" for="lastName">Last Name</label>
                            <input type="text" class="kiosk-input w-100" id="lastName" maxlength="100" autocomplete="off" autocapitalize="words" required>
                        </div>

                        <!-- Date of Birth -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Date of Birth</label>
                            <div class="dob-input-group">
                                <div class="dob-input">
                                    <label>Month</label>
                                    <input type="tel" class="kiosk-input" id="dobMonth" placeholder="MM" maxlength="2" inputmode="numeric" autocomplete="off" required>
                                </div>
                                <div class="dob-input">
                                    <label>Day</label>
                                    <input type="tel" class="kiosk-input" id="dobDay" placeholder="DD" maxlength="2" inputmode="numeric" autocomplete="off" required>
                                </div>
                                <div class="dob-input">
                                    <label>Year</label>
                                    <input type="tel" class="kiosk-input" id="dobYear" placeholder="YYYY" maxlength="4" inputmode="numeric" autocomplete="off" required>
                                </div>
                            </div>
                        </div>

                        <!-- ZIP Code -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold" for="zipCode">ZIP Code</label>
                            <input type="tel" class="kiosk-input w-100" id="zipCode" maxlength="10" inputmode="numeric" autocomplete="off" placeholder="12345" required>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-3">
                            <button type="submit" class="kiosk-btn kiosk-btn-primary" id="verifyBtn">
                                <i class="bi bi-shield-check"></i>
                                Verify & Continue
                            </button>
                            <button type="button" class="kiosk-btn kiosk-btn-secondary" onclick="clearVerificationForm()">
                                <i class="bi bi-arrow-counterclockwise"></i>
                                Clear
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Welcome Screen (after verification) -->
                <div id="welcomeScreen" class="screen kiosk-card">
                    <h2 class="kiosk-card-title">Welcome, <span id="patientFirstName"></span>!</h2>
                    <p class="kiosk-card-subtitle">Please review and sign the following consent forms</p>

                    <div class="kiosk-alert kiosk-alert-info">
                        <i class="bi bi-info-circle"></i>
                        <div>
                            <strong>Your appointment:</strong><br>
                            <span id="appointmentDetails"></span>
                        </div>
                    </div>

                    <div id="kioskWelcomeBalance" class="kiosk-alert kiosk-alert-warning mt-3" style="display:none;">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div>
                            <strong>Outstanding Balance:</strong> You have an outstanding balance of <strong id="kioskWelcomeBalanceAmount">$0.00</strong>. Please check with the front desk.
                        </div>
                    </div>

                    <div class="d-grid gap-3 mt-4">
                        <button class="kiosk-btn kiosk-btn-primary" onclick="startConsentForms()">
                            <i class="bi bi-file-text"></i>
                            Begin Consent Forms
                        </button>
                        <button class="kiosk-btn kiosk-btn-secondary" onclick="cancelSession()">
                            <i class="bi bi-x-lg"></i>
                            Not Me - Start Over
                        </button>
                    </div>
                </div>

                <!-- Already Consented Screen — patient signed consent from the
                     portal before arriving. Just confirm arrival. 2026-05. -->
                <div id="alreadyConsentedScreen" class="screen kiosk-card">
                    <h2 class="kiosk-card-title">Welcome, <span id="alreadyConsentedFirstName"></span>!</h2>
                    <p class="kiosk-card-subtitle">Your consent forms are already on file. Just confirm you're here and we'll be with you shortly.</p>

                    <div class="kiosk-alert kiosk-alert-info">
                        <i class="bi bi-check-circle"></i>
                        <div>
                            <strong>Your appointment:</strong><br>
                            <span id="alreadyConsentedApptDetails"></span>
                        </div>
                    </div>

                    <div id="alreadyConsentedBalance" class="kiosk-alert kiosk-alert-warning mt-3" style="display:none;">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div>
                            <strong>Outstanding Balance:</strong> You have an outstanding balance of <strong id="alreadyConsentedBalanceAmount">$0.00</strong>. Please check with the front desk.
                        </div>
                    </div>

                    <div class="d-grid gap-3 mt-4">
                        <button class="kiosk-btn kiosk-btn-success" id="btnYesIAmHere" onclick="confirmPresence()">
                            <i class="bi bi-check-circle"></i>
                            Yes, I am Here
                        </button>
                        <button class="kiosk-btn kiosk-btn-secondary" onclick="cancelSession()">
                            <i class="bi bi-x-lg"></i>
                            Not Me, Start Over
                        </button>
                    </div>
                </div>

                <!-- Consent Form Screen -->
                <div id="consentFormScreen" class="screen consent-form-container">
                    <!-- Compact Progress and Page Number on same line -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-progress" id="formProgress"></div>
                        <small class="text-muted">Form <span id="currentFormNumber">1</span> of <span id="totalForms">1</span></small>
                    </div>

                    <!-- Template name heading removed - template HTML contains its own heading -->

                    <!-- Form Content -->
                    <div class="consent-form-content" id="consentFormContent">
                        <!-- Form HTML will be inserted here -->
                    </div>

                    <!-- Navigation -->
                    <div class="form-navigation">
                        <button class="kiosk-btn kiosk-btn-secondary" id="prevFormBtn" onclick="previousForm()" style="display: none;">
                            <i class="bi bi-arrow-left"></i>
                            Previous
                        </button>
                        <button class="kiosk-btn kiosk-btn-primary" id="nextFormBtn" onclick="nextForm()">
                            Next
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Review Screen -->
                <div id="reviewScreen" class="screen kiosk-card" style="max-width: 600px;">
                    <h2 class="kiosk-card-title">Review & Submit</h2>
                    <p class="kiosk-card-subtitle">Please review your signed forms before submitting</p>

                    <div class="review-section" id="reviewFormsList">
                        <!-- Form review items will be inserted here -->
                    </div>

                    <!-- Confirmation Checkbox -->
                    <label class="kiosk-checkbox mb-4">
                        <input type="checkbox" id="confirmationCheckbox" onchange="updateSubmitButton()">
                        <span class="kiosk-checkbox-label">
                            I confirm that I am <strong id="confirmPatientName"></strong>, I have read and understand all the consent forms above, and I agree to the terms described.
                        </span>
                    </label>

                    <div class="d-grid gap-3">
                        <button class="kiosk-btn kiosk-btn-success" id="submitBtn" onclick="submitConsent()" disabled>
                            <i class="bi bi-check-circle"></i>
                            Submit & Check In
                        </button>
                        <button class="kiosk-btn kiosk-btn-secondary" onclick="goBackToForms()">
                            <i class="bi bi-arrow-left"></i>
                            Back to Forms
                        </button>
                    </div>
                </div>

                <!-- Success Screen -->
                <div id="successScreen" class="screen kiosk-card" style="max-width: 600px;">
                    <div class="success-screen">
                        <div class="success-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <h2 class="success-title">Thank You!</h2>
                        <p class="success-message">Your consent forms have been submitted and you are now checked in.</p>

                        <div class="success-details">
                            <p class="mb-2"><strong id="successPatientName"></strong></p>
                            <p class="mb-2">Appointment: <span id="successAppointmentTime"></span></p>
                            <p class="mb-0">Provider: <span id="successProviderName"></span></p>
                        </div>

                        <!-- Outstanding Balance Notification (soft — patient can skip) -->
                        <div id="kioskBalanceNotice" class="mt-3 p-3 rounded" style="display:none; background:#FFF7ED; border:1px solid #FDBA74;">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-info-circle" style="color:#EA580C; font-size:18px;"></i>
                                <span class="fw-semibold" style="color:#9A3412;">Account Balance</span>
                            </div>
                            <p class="mb-1" style="color:#9A3412; font-size:14px;">You have an outstanding balance of <strong id="kioskBalanceAmount">$0.00</strong></p>
                            <p class="mb-0 text-muted" style="font-size:12px;">Please check with the front desk for payment options.</p>
                        </div>

                        <p class="text-muted">Please have a seat. We will call you shortly.</p>

                        <!--
                            Consent → Intake handoff block.
                            Hidden by default; KioskModule.submitConsent() shows it when the submit
                            response includes a non-null Intake block (patient has not yet finished
                            their intake form). The auto-advance countdown is cancelled when this is
                            shown so the patient can tap into the wizard.
                            See rules/technical/consent-to-intake-handoff.md.
                        -->
                        <div id="successIntakeBlock" class="mt-4" style="display:none;">
                            <p class="mb-3 fw-semibold" id="successIntakeHeading"></p>
                            <button type="button" class="kiosk-btn kiosk-btn-success" id="btnStartIntake">
                                <i class="bi bi-clipboard-check me-1"></i>
                                <span id="btnStartIntakeLabel">Start Intake Form</span>
                            </button>
                        </div>

                        <p class="text-muted mt-3" id="autoAdvanceCountdown">
                            Moving to next patient in <span id="countdownSeconds" class="fw-bold">5</span> seconds...
                        </p>

                        <button class="kiosk-btn kiosk-btn-primary mt-2" onclick="resetKiosk()">
                            <i class="bi bi-person-plus"></i>
                            Next Patient
                        </button>
                    </div>
                </div>

                <!-- Already Completed Screen -->
                <div id="alreadyCompletedScreen" class="screen kiosk-card">
                    <div class="success-screen">
                        <div class="success-icon">
                            <i class="bi bi-check-lg"></i>
                        </div>
                        <h2 class="success-title">Already Checked In</h2>
                        <p class="success-message">You have already completed the consent forms for this appointment.</p>
                        <p class="text-muted">Please have a seat. We will call you shortly.</p>

                        <button class="kiosk-btn kiosk-btn-primary mt-4" onclick="resetKiosk()">
                            <i class="bi bi-arrow-counterclockwise"></i>
                            Start Over
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- App-mode admin sign-out confirmation modal -->
        <div class="modal fade" id="kioskAppLogoutModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content kiosk-app-logout-modal">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">
                            <i class="bi bi-box-arrow-right me-2" style="color:#6366F1;"></i>
                            Admin Sign Out
                        </h5>
                    </div>
                    <div class="modal-body pt-2">
                        <p class="mb-3 text-muted" style="font-size:14px;">
                            Signed in as <strong id="kioskAppLogoutEmail">&mdash;</strong>
                        </p>
                        <form id="kioskAppLogoutForm" autocomplete="off" novalidate>
                            <label class="form-label fw-semibold" for="kioskAppLogoutPassword" style="font-size:13px;">
                                Enter your password to confirm
                            </label>
                            <div class="kiosk-app-logout-input-wrap">
                                <i class="bi bi-lock kiosk-app-logout-icon"></i>
                                <input type="password" class="form-control kiosk-app-logout-input" id="kioskAppLogoutPassword" autocomplete="current-password" placeholder="Password" required>
                            </div>
                            <div id="kioskAppLogoutError" class="alert alert-danger mt-3 mb-0 d-none" style="font-size:13px;"></div>
                        </form>
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex gap-2">
                        <button type="button" class="kiosk-btn kiosk-btn-secondary flex-fill" data-bs-dismiss="modal" id="kioskAppLogoutCancelBtn">
                            Cancel
                        </button>
                        <button type="button" class="kiosk-btn kiosk-btn-primary flex-fill" id="kioskAppLogoutConfirmBtn">
                            <i class="bi bi-check-lg me-1"></i>Confirm Sign Out
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Validation Alert Modal -->
        <div class="modal fade" id="kioskAlertModal" tabindex="-1" aria-labelledby="kioskAlertModalLabel" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title" id="kioskAlertModalLabel">
                            <i class="bi bi-exclamation-circle text-warning me-2"></i>
                            <span id="kioskAlertTitle">Signature Required</span>
                        </h5>
                    </div>
                    <div class="modal-body pt-2">
                        <p id="kioskAlertMessage" class="mb-0 fs-5"></p>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="kiosk-btn kiosk-btn-primary" data-bs-dismiss="modal">
                            <i class="bi bi-check-lg me-1"></i>OK
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modules/kiosk/KioskModule.js?v=1778672252"></script>
</body>
</html>
