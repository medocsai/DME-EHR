@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>Kiosk Setup | IMEHR</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Inter font to match existing admin UI -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="~/css/kiosksetup.css?v=4" rel="stylesheet">
</head>
<body>
    <div id="kioskSetupPage">

        <!-- Background brand mark (decorative "+" watermark) -->
        <div class="ks-watermark" aria-hidden="true">
            <img src="~/medocslogo_+.png" alt="">
        </div>

        <!-- Loading overlay -->
        <div id="ksLoading" class="ks-loading hidden">
            <div class="ks-spinner"></div>
            <p id="ksLoadingMessage">Loading...</p>
        </div>

        <!-- ============================================================
             SCREEN: SIGN IN
             ============================================================ -->
        <section id="ksSignInScreen" class="ks-screen active">
            <div class="ks-card">
                <div class="ks-brand">
                    <img src="~/medocslogo.png" alt="Medocs" class="ks-brand-logo">
                    <div class="ks-brand-sub">Kiosk Setup</div>
                </div>

                <h1 class="ks-title">Sign in to continue</h1>
                <p class="ks-subtitle">Clinic staff only. This tablet will run the patient check-in kiosk.</p>

                <div id="ksSignInError" class="ks-alert ks-alert-error hidden">
                    <i class="bi bi-exclamation-circle"></i>
                    <span id="ksSignInErrorText"></span>
                </div>

                <form id="ksSignInForm" autocomplete="off" novalidate>
                    <div class="ks-field">
                        <label for="ksEmail" class="ks-label">Email</label>
                        <div class="ks-input-wrap">
                            <i class="bi bi-envelope ks-input-icon"></i>
                            <input type="email" id="ksEmail" class="ks-input" autocomplete="username" required>
                        </div>
                    </div>

                    <div class="ks-field">
                        <label for="ksPassword" class="ks-label">Password</label>
                        <div class="ks-input-wrap">
                            <i class="bi bi-lock ks-input-icon"></i>
                            <input type="password" id="ksPassword" class="ks-input" autocomplete="current-password" required>
                            <button type="button" class="ks-input-toggle" data-toggle-password="ksPassword" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="ks-btn ks-btn-primary" id="ksSignInBtn">
                        <span class="ks-btn-label">Sign In</span>
                        <i class="bi bi-arrow-right ks-btn-icon"></i>
                    </button>
                </form>
            </div>

            <div class="ks-footer">
                <i class="bi bi-shield-lock"></i>
                HIPAA-secure clinic device
            </div>
        </section>

        <!-- ============================================================
             SCREEN: OTP VERIFICATION
             ============================================================ -->
        <section id="ksOtpScreen" class="ks-screen">
            <div class="ks-card">
                <div class="ks-brand">
                    <img src="~/medocslogo.png" alt="Medocs" class="ks-brand-logo">
                    <div class="ks-brand-sub">Kiosk Setup</div>
                </div>

                <div class="ks-otp-illustration">
                    <i class="bi bi-shield-lock"></i>
                </div>

                <h1 class="ks-title">Verify your identity</h1>
                <p class="ks-subtitle">
                    We sent a 6-digit code to <strong id="ksOtpEmailDisplay">your email</strong>.
                    Enter it below to continue.
                </p>

                <div id="ksOtpError" class="ks-alert ks-alert-error hidden">
                    <i class="bi bi-exclamation-circle"></i>
                    <span id="ksOtpErrorText"></span>
                </div>

                <div id="ksOtpInfo" class="ks-alert ks-alert-info hidden">
                    <i class="bi bi-check-circle"></i>
                    <span id="ksOtpInfoText"></span>
                </div>

                <form id="ksOtpForm" autocomplete="off" novalidate>
                    <div class="ks-otp-inputs" id="ksOtpInputs">
                        <input type="tel" maxlength="1" class="ks-otp-box" inputmode="numeric" aria-label="Digit 1">
                        <input type="tel" maxlength="1" class="ks-otp-box" inputmode="numeric" aria-label="Digit 2">
                        <input type="tel" maxlength="1" class="ks-otp-box" inputmode="numeric" aria-label="Digit 3">
                        <input type="tel" maxlength="1" class="ks-otp-box" inputmode="numeric" aria-label="Digit 4">
                        <input type="tel" maxlength="1" class="ks-otp-box" inputmode="numeric" aria-label="Digit 5">
                        <input type="tel" maxlength="1" class="ks-otp-box" inputmode="numeric" aria-label="Digit 6">
                    </div>

                    <button type="submit" class="ks-btn ks-btn-primary" id="ksOtpVerifyBtn">
                        <span class="ks-btn-label">Verify &amp; Continue</span>
                        <i class="bi bi-arrow-right ks-btn-icon"></i>
                    </button>
                </form>

                <div class="ks-otp-actions">
                    <button type="button" class="ks-btn-text" id="ksOtpResendBtn">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span id="ksOtpResendLabel">Resend code</span>
                    </button>
                    <button type="button" class="ks-btn-text ks-btn-text-muted" id="ksOtpBackBtn">
                        <i class="bi bi-arrow-left"></i>
                        Use a different account
                    </button>
                </div>
            </div>
        </section>

        <!-- ============================================================
             SCREEN: LOCATION PICKER
             ============================================================ -->
        <section id="ksLocationScreen" class="ks-screen">
            <div class="ks-card ks-card-wide">
                <div class="ks-brand">
                    <img src="~/medocslogo.png" alt="Medocs" class="ks-brand-logo">
                    <div class="ks-brand-sub">Kiosk Setup</div>
                </div>

                <div class="ks-user-chip" id="ksUserChip">
                    <i class="bi bi-person-circle"></i>
                    <span id="ksUserName"></span>
                    <button type="button" class="ks-user-chip-action" id="ksSignOutLink">Sign out</button>
                </div>

                <h1 class="ks-title">Choose clinic location</h1>
                <p class="ks-subtitle">Pick the location this tablet will serve. You can sign out later to change it.</p>

                <div id="ksLocationError" class="ks-alert ks-alert-error hidden">
                    <i class="bi bi-exclamation-circle"></i>
                    <span id="ksLocationErrorText"></span>
                </div>

                <div class="ks-location-list" id="ksLocationList" role="radiogroup" aria-label="Clinic locations">
                    <!-- Locations injected by JS -->
                </div>

                <div id="ksLocationEmpty" class="ks-empty hidden">
                    <i class="bi bi-geo-alt"></i>
                    <p>No active locations available for your account.</p>
                </div>

                <button type="button" class="ks-btn ks-btn-primary" id="ksContinueBtn" disabled>
                    <span class="ks-btn-label">Continue to Kiosk</span>
                    <i class="bi bi-arrow-right ks-btn-icon"></i>
                </button>
            </div>
        </section>

        <!-- ============================================================
             SCREEN: NO CONSENT FORM CONFIGURED
             ============================================================ -->
        <section id="ksNoFormScreen" class="ks-screen">
            <div class="ks-card">
                <div class="ks-noform-illustration">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <h1 class="ks-title">No consent form set up</h1>
                <p class="ks-subtitle">
                    Your clinic doesn't have a consent form configured yet.
                    Please create one from the admin panel, then come back here.
                </p>

                <div class="ks-btn-row">
                    <button type="button" class="ks-btn ks-btn-primary" id="ksNoFormRetryBtn">
                        <i class="bi bi-arrow-clockwise"></i>
                        <span class="ks-btn-label">I've created it. Retry</span>
                    </button>
                    <button type="button" class="ks-btn ks-btn-secondary" id="ksNoFormSignOutBtn">
                        <i class="bi bi-box-arrow-left"></i>
                        <span class="ks-btn-label">Sign out</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- ============================================================
             SCREEN: ERROR
             ============================================================ -->
        <section id="ksErrorScreen" class="ks-screen">
            <div class="ks-card">
                <div class="ks-error-illustration">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h1 class="ks-title" id="ksErrorTitle">Something went wrong</h1>
                <p class="ks-subtitle" id="ksErrorMessage">Please try again.</p>
                <button type="button" class="ks-btn ks-btn-secondary" id="ksErrorRetryBtn">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span class="ks-btn-label">Try Again</span>
                </button>
            </div>
        </section>

    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/modules/kiosksetup/KioskSetupModule.js?v=4"></script>
</body>
</html>
