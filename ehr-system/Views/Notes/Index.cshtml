@{
    ViewData["Title"] = "Clinical Notes";
    ViewData["ActivePage"] = "notes";
}

<!-- Clinical Notes Page -->
<div class="page active" id="notesPage">
    <div class="card">
        <div class="card-header">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="noteFilterSearch" placeholder="Search patient or provider..." autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" id="noteFilterStartDate" title="From Date" autocomplete="off">
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" id="noteFilterEndDate" title="To Date" autocomplete="off">
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="noteFilterProvider">
                        <option value="">All Providers</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="noteFilterStatus">
                        <option value="">All Statuses</option>
                        <option value="0">Draft</option>
                        <option value="2">Signed</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" onclick="clearNoteFilters()" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="clinicalNotesTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Provider</th>
                            <th>Template Name</th>
                            <th>Status</th>
                            <th>Signed At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center" id="notesPagination">
                <small class="text-muted" id="notesPageInfo">Showing 0 of 0 notes</small>
                <nav aria-label="Notes pagination">
                    <ul class="pagination pagination-sm mb-0" id="notesPaginationControls"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_Modals" />
}

@section Scripts {
}
