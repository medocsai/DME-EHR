@{
    ViewData["Title"] = "Orders";
    ViewData["ActivePage"] = "orders";
}

<!-- Orders Page -->
<div class="page active" id="ordersPage">
    <div class="card">
        <div class="card-header">
            <!-- Type Tabs -->
            <ul class="nav nav-pills mb-3" id="orderTypeTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-type="" href="#">All</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-type="0" href="#">
                        <i class="bi bi-droplet-half"></i> Labs
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-type="1" href="#">
                        <i class="bi bi-image"></i> Imaging
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-type="2" href="#">
                        <i class="bi bi-arrow-right-circle"></i> Referrals
                    </a>
                </li>
            </ul>
            <!-- Filter Row -->
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="orderFilterSearch" placeholder="Search patient, diagnosis..." autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" id="orderFilterStartDate" title="From Date" autocomplete="off">
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" id="orderFilterEndDate" title="To Date" autocomplete="off">
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="orderFilterStatus">
                        <option value="">All Statuses</option>
                        <option value="0">Draft</option>
                        <option value="1">Pending</option>
                        <option value="2">Sent</option>
                        <option value="3">In Progress</option>
                        <option value="4">Results Received</option>
                        <option value="5">Completed</option>
                        <option value="6">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100 hide-from-ma-nurse" id="btnNewOrder">
                        <i class="bi bi-plus-lg"></i> New Order
                    </button>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" id="btnClearOrderFilters" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="ordersTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Type</th>
                            <th>Description</th>
                            <th>Priority</th>
                            <th>Provider</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center" id="orderPagination">
                <small class="text-muted" id="orderPageInfo">Showing 0 orders</small>
                <nav aria-label="Orders pagination">
                    <ul class="pagination pagination-sm mb-0" id="orderPaginationControls"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_ModalsOrders" />
    <partial name="_Modals" />
}

@section Scripts {
}
