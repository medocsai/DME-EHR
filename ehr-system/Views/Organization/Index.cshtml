@{
    ViewData["Title"] = "Organization";
    ViewData["ActivePage"] = "organization";
}

<div class="page active" id="organizationPage">
    <div class="page-header">
        <h4><i class="bi bi-hospital me-2"></i>Organization Settings</h4>
    </div>
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-building me-2"></i>Practice Information</h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">Configure your practice details. The NPI is used for insurance eligibility verification with Office Ally.</p>
            <form id="organizationForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Practice Name</label>
                        <input type="text" class="form-control" id="orgName" placeholder="Practice name">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">NPI <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="orgNpi" placeholder="10-digit NPI" maxlength="10">
                        <small class="text-muted">Required for eligibility checks</small>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Tax ID</label>
                        <input type="text" class="form-control" id="orgTaxId" placeholder="XX-XXXXXXX">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address</label>
                        <input type="text" class="form-control" id="orgAddress" placeholder="Street address">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">City</label>
                        <input type="text" class="form-control" id="orgCity">
                    </div>
                    <div class="col-md-1">
                        <label class="form-label">State</label>
                        <input type="text" class="form-control" id="orgState" maxlength="2" placeholder="CA">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Zip</label>
                        <input type="text" class="form-control" id="orgZip" maxlength="10">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Phone</label>
                        <input type="text" class="form-control" id="orgPhone" placeholder="(xxx) xxx-xxxx">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="orgEmail">
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-primary" id="saveOrgBtn">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <span id="orgSaveStatus" class="ms-2"></span>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_Modals" />
}

@section Scripts {
    <script src="~/js/modules/organization/OrganizationModule.js"></script>
}
