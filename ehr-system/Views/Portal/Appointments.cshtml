@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "My Appointments";
    ViewData["PortalPage"] = "appointments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>My Appointments</h5>
    <a href="/Portal/Booking" class="btn" style="background:var(--portal-primary);color:#fff;border-radius:8px;font-weight:600;font-size:14px;">
        <i class="bi bi-calendar-plus me-1"></i> Book Appointment
    </a>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-pills nav-fill mb-3 portal-filter-tabs" id="apptFilterTabs">
    <li class="nav-item">
        <button class="nav-link active" data-filter="upcoming">Upcoming</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-filter="past">Past</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-filter="all">All</button>
    </li>
</ul>

<!-- Appointments List -->
<div id="appointmentsList">
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm"></div> Loading appointments...
    </div>
</div>
