@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "My Documents";
    ViewData["PortalPage"] = "documents";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="mb-0"><i class="bi bi-folder2-open me-2" style="color: var(--portal-primary);"></i>My Documents</h5>
        <p class="text-muted small mb-0 mt-1"><i class="bi bi-cloud-arrow-up me-1"></i>Drag & drop files anywhere on this page, or use the Upload button</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-primary" id="portalUploadBtn">
            <i class="bi bi-cloud-arrow-up me-1"></i>Upload
        </button>
        <input type="file" id="portalFileInput" multiple style="display: none;"
               accept=".pdf,.jpg,.jpeg,.png,.gif,.webp,.doc,.docx,.xls,.xlsx,.txt">
    </div>
</div>

<!-- Document List -->
<div class="portal-card" id="portalDocList">
    <div class="card-header">
        <h6 class="mb-0">
            <i class="bi bi-file-earmark-text me-2"></i>Your Documents
            <span class="badge rounded-pill d-none" id="portalDocCount" style="background: var(--portal-primary); font-size: 11px; vertical-align: middle;">0</span>
        </h6>
    </div>
    <div class="card-body p-0" id="portalDocListBody">
        <div class="text-center text-muted py-4" id="portalDocLoading">
            <div class="spinner-border spinner-border-sm"></div> Loading documents...
        </div>
    </div>
</div>

<!-- Upload Progress Card (hidden by default) -->
<div class="portal-card mb-3 d-none" id="portalUploadProgress">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-cloud-arrow-up me-2"></i>Uploading...</h6>
        <span class="text-muted small" id="portalUploadCount"></span>
    </div>
    <div class="card-body p-0" id="portalUploadList"></div>
</div>

<!-- Drag & Drop Overlay -->
<div id="portalDragOverlay" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:9999; background:rgba(27,114,190,0.08); backdrop-filter:blur(2px); align-items:center; justify-content:center;">
    <div style="background:#fff; border:3px dashed var(--portal-primary); border-radius:20px; padding:60px 80px; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.15); pointer-events:none;">
        <div style="width:72px; height:72px; border-radius:14px; background:#DBEAFE; color:#1B72BE; display:inline-flex; align-items:center; justify-content:center; font-size:32px; margin-bottom:16px;">
            <i class="bi bi-cloud-arrow-up"></i>
        </div>
        <div class="fw-semibold fs-5 mb-1">Drop files to upload</div>
        <div class="text-muted small">PDF, Images, Documents up to 30MB each</div>
    </div>
</div>

<style>
    .portal-doc-item {
        display: grid;
        grid-template-columns: 1fr 120px 80px;
        padding: 10px 16px;
        align-items: center;
        border-bottom: 1px solid #F3F4F6;
        transition: background 100ms;
    }
    .portal-doc-item:hover { background: #F9FAFB; }
    .portal-doc-item:last-child { border-bottom: none; }
    .portal-doc-file-info { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .portal-doc-icon {
        width: 36px; height: 36px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; flex-shrink: 0;
    }
    .portal-doc-icon.pdf { background: #FEE2E2; color: #DC2626; }
    .portal-doc-icon.image { background: #DBEAFE; color: #2563EB; }
    .portal-doc-icon.doc { background: #E0E7FF; color: #4F46E5; }
    .portal-doc-icon.other { background: #F3F4F6; color: #6B7280; }
    .portal-doc-name { font-size: 13px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .portal-doc-size { font-size: 11px; color: var(--portal-text-muted); }
    .portal-doc-meta { font-size: 12px; color: var(--portal-text-muted); }
    .portal-doc-header {
        display: grid; grid-template-columns: 1fr 120px 80px;
        padding: 8px 16px; font-size: 11px; font-weight: 600;
        color: var(--portal-text-muted); text-transform: uppercase; letter-spacing: 0.3px;
        border-bottom: 1px solid var(--portal-border);
    }
    .portal-upload-item {
        display: flex; align-items: center; gap: 12px; padding: 10px 16px;
        border-bottom: 1px solid #F3F4F6;
    }
    .portal-upload-item:last-child { border-bottom: none; }
    .portal-upload-bar { height: 4px; border-radius: 2px; background: #E5E7EB; flex: 1; overflow: hidden; }
    .portal-upload-fill { height: 100%; background: var(--portal-primary); border-radius: 2px; transition: width 300ms ease; }
    .portal-empty-state { text-align: center; padding: 48px 16px; }
    .portal-empty-icon {
        width: 64px; height: 64px; border-radius: 16px; background: #DBEAFE; color: #1B72BE;
        display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 12px;
    }
    @@media (max-width: 768px) {
        .portal-doc-header { display: none; }
        .portal-doc-item { grid-template-columns: 1fr auto; }
        .portal-doc-item .portal-doc-meta { display: none; }
    }
</style>

<script>
(function() {
    const API_BASE = '/api/portal/documents';
    let authToken = localStorage.getItem('portalAuthToken');

    function apiFetch(url, options = {}) {
        return fetch(url, {
            ...options,
            headers: { 'Authorization': `Bearer ${authToken}`, ...(options.headers || {}) }
        }).then(r => r.ok ? r.json() : r.json().then(e => { throw new Error(e.message || 'Request failed'); }));
    }

    function getFileIcon(contentType, fileName) {
        if (contentType?.includes('pdf') || fileName?.endsWith('.pdf')) return { cls: 'pdf', icon: 'bi-file-earmark-pdf' };
        if (contentType?.startsWith('image/') || /\.(jpg|jpeg|png|gif|webp)$/i.test(fileName)) return { cls: 'image', icon: 'bi-file-earmark-image' };
        if (/\.(doc|docx|xls|xlsx)$/i.test(fileName)) return { cls: 'doc', icon: 'bi-file-earmark-word' };
        return { cls: 'other', icon: 'bi-file-earmark' };
    }

    function formatSize(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1048576) return (bytes / 1024).toFixed(0) + ' KB';
        return (bytes / 1048576).toFixed(1) + ' MB';
    }

    function formatDate(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr.endsWith('Z') ? dateStr : dateStr + 'Z');
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    async function loadDocuments() {
        const body = document.getElementById('portalDocListBody');
        const countBadge = document.getElementById('portalDocCount');
        try {
            const docs = await apiFetch(API_BASE);
            body.innerHTML = '';

            if (!docs?.length) {
                body.innerHTML = `
                    <div class="portal-empty-state">
                        <div class="portal-empty-icon"><i class="bi bi-folder2"></i></div>
                        <h6 class="mb-1">No documents yet</h6>
                        <p class="text-muted small mb-3">Upload your medical records, insurance cards, referral letters, or any other documents your provider may need.</p>
                        <button class="btn btn-primary px-4" onclick="document.getElementById('portalFileInput').click()">
                            <i class="bi bi-cloud-arrow-up me-1"></i>Upload Your First Document
                        </button>
                    </div>`;
                countBadge.classList.add('d-none');
                return;
            }

            countBadge.textContent = docs.length;
            countBadge.classList.remove('d-none');

            let html = `<div class="portal-doc-header"><span>Name</span><span>Uploaded</span><span class="text-end">Actions</span></div>`;
            docs.forEach(d => {
                const fi = getFileIcon(d.ContentType, d.FileName);
                html += `
                <div class="portal-doc-item">
                    <div class="portal-doc-file-info">
                        <div class="portal-doc-icon ${fi.cls}"><i class="bi ${fi.icon}"></i></div>
                        <div>
                            <div class="portal-doc-name">${escapeHtml(d.FileName)}</div>
                            <div class="portal-doc-size">${formatSize(d.FileSize)}</div>
                        </div>
                    </div>
                    <div class="portal-doc-meta">${formatDate(d.CreatedAt)}</div>
                    <div class="text-end">
                        <button class="btn btn-outline-info btn-sm me-1" title="View" onclick="FileViewerModal.showFromFetch({fetchUrl:'${API_BASE}/${d.DocumentId}',fileName:'${escapeHtml(d.FileName).replace(/'/g, "\\'")}',token:'${authToken}'});">
                            <i class="bi bi-eye"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm" title="Delete" onclick="deletePortalDoc(${d.DocumentId})">
                            <i class="bi bi-trash3"></i>
                        </button>
                    </div>
                </div>`;
            });
            body.innerHTML = html;
        } catch (e) {
            body.innerHTML = `<div class="text-center text-danger py-3">${e.message || 'Failed to load documents'}</div>`;
        }
    }

    function escapeHtml(t) { const d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; }

    // Upload files
    async function uploadFiles(files) {
        if (!files?.length) return;
        const progressCard = document.getElementById('portalUploadProgress');
        const progressList = document.getElementById('portalUploadList');
        const countEl = document.getElementById('portalUploadCount');

        progressCard.classList.remove('d-none');
        progressList.innerHTML = '';
        countEl.textContent = `0 of ${files.length} files`;

        let completed = 0;
        for (const file of files) {
            if (file.size > 31457280) {
                progressList.innerHTML += `<div class="portal-upload-item"><span class="text-danger small">${escapeHtml(file.name)}: exceeds 30MB limit</span></div>`;
                completed++;
                continue;
            }

            const itemEl = document.createElement('div');
            itemEl.className = 'portal-upload-item';
            itemEl.innerHTML = `
                <div class="portal-doc-icon ${getFileIcon(file.type, file.name).cls}" style="width:32px;height:32px;font-size:14px;">
                    <i class="bi ${getFileIcon(file.type, file.name).icon}"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="portal-doc-name" style="font-size:12px;">${escapeHtml(file.name)}</span>
                        <span class="text-muted small upload-status">Uploading...</span>
                    </div>
                    <div class="portal-upload-bar"><div class="portal-upload-fill" style="width:30%;"></div></div>
                </div>`;
            progressList.appendChild(itemEl);

            try {
                const formData = new FormData();
                formData.append('file', file);
                const resp = await fetch(`${API_BASE}/upload`, {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${authToken}` },
                    body: formData
                });
                const result = await resp.json();
                const status = itemEl.querySelector('.upload-status');
                const bar = itemEl.querySelector('.portal-upload-fill');
                if (result.success) {
                    status.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i> Done</span>';
                    bar.style.width = '100%';
                } else {
                    status.innerHTML = `<span class="text-danger">${result.message || 'Failed'}</span>`;
                    bar.style.width = '100%';
                    bar.style.background = '#DC2626';
                }
            } catch {
                const status = itemEl.querySelector('.upload-status');
                status.innerHTML = '<span class="text-danger">Error</span>';
            }
            completed++;
            countEl.textContent = `${completed} of ${files.length} files`;
        }

        // Reload document list after all uploads
        await loadDocuments();

        // Hide progress after 3 seconds
        setTimeout(() => progressCard.classList.add('d-none'), 3000);
    }

    // Delete document
    window.deletePortalDoc = async function(docId) {
        if (!confirm('Delete this document?')) return;
        try {
            await fetch(`${API_BASE}/${docId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${authToken}` }
            });
            await loadDocuments();
        } catch (e) {
            alert('Failed to delete document');
        }
    };

    // Upload button
    document.getElementById('portalUploadBtn')?.addEventListener('click', () => {
        document.getElementById('portalFileInput').click();
    });

    // File input change
    document.getElementById('portalFileInput')?.addEventListener('change', function() {
        if (this.files?.length) uploadFiles(Array.from(this.files));
        this.value = '';
    });

    // Drag & drop overlay
    const overlay = document.getElementById('portalDragOverlay');
    let dragCounter = 0;
    document.addEventListener('dragenter', (e) => { e.preventDefault(); dragCounter++; overlay.style.display = 'flex'; });
    document.addEventListener('dragleave', (e) => { e.preventDefault(); dragCounter--; if (dragCounter <= 0) { dragCounter = 0; overlay.style.display = 'none'; } });
    document.addEventListener('dragover', (e) => e.preventDefault());
    document.addEventListener('drop', (e) => {
        e.preventDefault(); dragCounter = 0; overlay.style.display = 'none';
        if (e.dataTransfer?.files?.length) uploadFiles(Array.from(e.dataTransfer.files));
    });

    // Load on page ready
    if (authToken) loadDocuments();
})();
</script>
