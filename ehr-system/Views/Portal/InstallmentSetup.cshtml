@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Plan - Patient Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/patient-portal.css" rel="stylesheet">
    <style>
        .setup-container { max-width: 550px; margin: 40px auto; }
        .setup-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,.08); overflow: hidden; }
        .setup-header { background: var(--portal-primary, #1B72BE); color: #fff; padding: 24px; text-align: center; }
        .setup-body { padding: 32px; }
        .month-option { cursor: pointer; border: 2px solid #e5e7eb; border-radius: 10px; padding: 16px; text-align: center; transition: all 0.2s; }
        .month-option:hover { border-color: #1B72BE; background: #EFF6FF; }
        .month-option.selected { border-color: #1B72BE; background: #1B72BE; color: #fff; }
        .month-option .months { font-size: 24px; font-weight: 700; }
        .month-option .per-month { font-size: 14px; opacity: 0.8; }
        #payment-element { min-height: 120px; }
    </style>
</head>
<body style="background: var(--portal-bg, #EFF6FF);">
    <div class="setup-container">
        <div class="setup-card">
            <div class="setup-header">
                <img src="/medocslogo.png" alt="MEDOCS" style="height:32px; filter:brightness(0) invert(1); margin-bottom:8px;" onerror="this.style.display='none'">
                <div style="font-size:14px; opacity:0.9;" id="clinicName"></div>
            </div>
            <div class="setup-body">
                <div class="text-center mb-4">
                    <div class="text-muted small">Total Balance</div>
                    <div class="fs-2 fw-bold text-primary" id="displayTotal">$0.00</div>
                    <div class="text-muted small mt-1" id="displayPatientName"></div>
                </div>

                <!-- Step 1: Select months -->
                <div id="step1">
                    <h6 class="fw-semibold mb-3">Choose Your Payment Plan</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-4">
                            <div class="month-option" data-months="3">
                                <div class="months">3</div>
                                <div class="per-month">months</div>
                                <div class="fw-semibold mt-1" id="monthly3">$0/mo</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="month-option" data-months="6">
                                <div class="months">6</div>
                                <div class="per-month">months</div>
                                <div class="fw-semibold mt-1" id="monthly6">$0/mo</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="month-option" data-months="12">
                                <div class="months">12</div>
                                <div class="per-month">months</div>
                                <div class="fw-semibold mt-1" id="monthly12">$0/mo</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Card + Confirm (shown after selecting months) -->
                <div id="step2" style="display:none;">
                    <div class="alert alert-info mb-3 py-2" id="planSummary"></div>

                    <div id="loadingStripe" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <span class="ms-2 text-muted small">Loading card form...</span>
                    </div>

                    <form id="setup-form" style="display:none;">
                        <div id="payment-element" class="mb-3 p-3 border rounded"></div>
                        <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3" style="font-size:16px;" disabled>
                            <span id="btn-text"><i class="bi bi-calendar-check me-2"></i>Start Plan & Pay First Installment</span>
                            <span id="btn-spinner" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Setting up plan...</span>
                        </button>
                    </form>
                </div>

                <div class="text-center mt-3">
                    <a href="/Portal/Billing" class="text-muted text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Back to Billing
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <script>
    document.addEventListener('DOMContentLoaded', async () => {
        const params = new URLSearchParams(window.location.search);
        const amount = parseFloat(params.get('amount') || '0');
        const authToken = localStorage.getItem('portalAuthToken');
        const patientData = JSON.parse(localStorage.getItem('portalPatient') || '{}');

        if (!authToken || !amount) { window.location.href = '/Portal/Billing'; return; }

        document.getElementById('displayTotal').textContent = '$' + amount.toFixed(2);
        document.getElementById('displayPatientName').textContent = patientData.PatientName || '';
        document.getElementById('clinicName').textContent = patientData.TenantName || '';

        // Calculate monthly amounts
        [3, 6, 12].forEach(m => {
            const monthly = Math.ceil(amount / m * 100) / 100;
            document.getElementById('monthly' + m).textContent = '$' + monthly.toFixed(2) + '/mo';
        });

        let selectedMonths = null;
        let stripeInstance = null;
        let stripeElements = null;

        // Month selection
        document.querySelectorAll('.month-option').forEach(opt => {
            opt.addEventListener('click', async function() {
                document.querySelectorAll('.month-option').forEach(o => o.classList.remove('selected'));
                this.classList.add('selected');
                selectedMonths = parseInt(this.dataset.months);

                const monthly = Math.ceil(amount / selectedMonths * 100) / 100;
                document.getElementById('planSummary').innerHTML =
                    `<strong>${selectedMonths} monthly payments</strong> of <strong>$${monthly.toFixed(2)}</strong><br>
                    <small class="text-muted">First payment charged today. Card saved for remaining payments.</small>`;

                document.getElementById('step2').style.display = 'block';

                // Initialize Stripe SetupIntent if not already done
                if (!stripeInstance) {
                    try {
                        const resp = await fetch('/api/portal/billing/setup-intent', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + authToken }
                        }).then(r => r.json());

                        // Second arg { stripeAccount } is REQUIRED for Connect Direct Charge.
                        // See note in Views/Portal/Payment.cshtml for the full explanation.
                        stripeInstance = Stripe(resp.PublishableKey, { stripeAccount: resp.StripeAccountId });
                        stripeElements = stripeInstance.elements({ clientSecret: resp.ClientSecret });
                        const paymentElement = stripeElements.create('payment');
                        paymentElement.mount('#payment-element');

                        document.getElementById('loadingStripe').style.display = 'none';
                        document.getElementById('setup-form').style.display = 'block';

                        paymentElement.on('ready', () => {
                            document.getElementById('submitBtn').disabled = false;
                        });
                    } catch (e) {
                        document.getElementById('loadingStripe').innerHTML = '<p class="text-danger">Failed to load card form.</p>';
                    }
                }
            });
        });

        // Submit — confirm setup and create plan
        document.getElementById('setup-form')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            if (!selectedMonths) return;

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            document.getElementById('btn-text').classList.add('d-none');
            document.getElementById('btn-spinner').classList.remove('d-none');

            const { setupIntent, error } = await stripeInstance.confirmSetup({
                elements: stripeElements,
                redirect: 'if_required'
            });

            if (error) {
                btn.disabled = false;
                document.getElementById('btn-text').classList.remove('d-none');
                document.getElementById('btn-spinner').classList.add('d-none');
                alert(error.message);
                return;
            }

            // Create installment plan via API
            try {
                const planResp = await fetch('/api/portal/billing/installment-plan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + authToken },
                    body: JSON.stringify({
                        TotalAmount: amount,
                        NumberOfInstallments: selectedMonths,
                        StripePaymentMethodId: setupIntent.payment_method
                    })
                }).then(r => r.json());

                if (planResp && !planResp.message) {
                    // Success — redirect to billing with success message
                    window.location.href = '/Portal/Billing?planCreated=1';
                } else {
                    alert(planResp?.message || 'Failed to create plan.');
                    btn.disabled = false;
                    document.getElementById('btn-text').classList.remove('d-none');
                    document.getElementById('btn-spinner').classList.add('d-none');
                }
            } catch (err) {
                alert('An error occurred. Please try again.');
                btn.disabled = false;
                document.getElementById('btn-text').classList.remove('d-none');
                document.getElementById('btn-spinner').classList.add('d-none');
            }
        });
    });
    </script>
</body>
</html>
