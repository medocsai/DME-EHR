@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "Sign In";
    ViewData["PortalPage"] = "login";
}

<!-- Portal Login Form -->
<div class="portal-login-wrapper">
    <div class="portal-login-card">
        <div class="text-center mb-4">
            <img src="/medocslogo.png" alt="MEDOCS" class="portal-login-logo" onerror="this.style.display='none'">
            <h4 class="mt-3 mb-1">Patient Portal</h4>
            <p class="text-muted small">Access your medical records securely</p>
        </div>

        <!-- Step 1: Identity Verification -->
        <form id="portalVerifyForm">
            <div class="alert alert-danger d-none" id="portalLoginError"></div>

            <div class="mb-3">
                <label class="form-label" for="portalDob">Date of Birth</label>
                <input type="date" class="form-control" id="portalDob" required
                       max="2099-12-31" placeholder="MM/DD/YYYY">
            </div>

            <div class="mb-3">
                <label class="form-label" for="portalSsn4">Last 4 Digits of SSN</label>
                <input type="password" class="form-control" id="portalSsn4" required
                       maxlength="4" minlength="4" pattern="[0-9]{4}" inputmode="numeric"
                       placeholder="****" autocomplete="off">
            </div>

            <button type="submit" class="btn btn-primary w-100" id="portalVerifyBtn">
                <i class="bi bi-shield-check me-2"></i>Verify Identity
            </button>
        </form>

        <!-- Step 2: Clinic Selection (hidden by default) -->
        <div id="portalClinicSelection" class="d-none">
            <div class="text-center mb-3">
                <p class="mb-1">Welcome back,</p>
                <h5 id="portalClinicUserName" class="mb-2"></h5>
                <p class="text-muted small">Select your clinic:</p>
            </div>
            <div id="portalClinicList" class="d-grid gap-2"></div>
            <div class="text-center mt-3">
                <button type="button" class="btn btn-link text-muted btn-sm" id="portalBackToVerify">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </button>
            </div>
        </div>

        <!-- Step 3: Location Selection (hidden by default) -->
        <div id="portalLocationSelection" class="d-none">
            <div class="text-center mb-3">
                <p class="mb-1">Welcome back,</p>
                <h5 id="portalLocationUserName" class="mb-2"></h5>
                <p class="text-muted small">Select your location:</p>
            </div>
            <div id="portalLocationList" class="d-grid gap-2"></div>
            <div class="text-center mt-3">
                <button type="button" class="btn btn-link text-muted btn-sm" id="portalBackToClinic">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </button>
            </div>
        </div>

        <div class="text-center mt-4">
            <small class="text-muted">
                <i class="bi bi-shield-lock me-1"></i>HIPAA Compliant - Secure Access
            </small>
        </div>
    </div>
</div>
