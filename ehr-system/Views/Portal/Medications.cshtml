@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "My Medications";
    ViewData["PortalPage"] = "medications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-capsule me-2"></i>My Medications</h5>
</div>

<!-- Filter Tabs -->
<ul class="nav nav-pills nav-fill mb-3 portal-filter-tabs">
    <li class="nav-item">
        <button class="nav-link active" data-filter="active" id="medFilterActive">Active</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-filter="all" id="medFilterAll">All</button>
    </li>
</ul>

<!-- Medications List -->
<div id="medicationsList">
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm"></div> Loading medications...
    </div>
</div>
