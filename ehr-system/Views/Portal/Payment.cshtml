@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Complete Payment - Patient Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/patient-portal.css" rel="stylesheet">
    <style>
        .payment-container { max-width: 550px; margin: 40px auto; }
        .payment-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,.08); overflow: hidden; }
        .payment-header { background: var(--portal-primary, #1B72BE); color: #fff; padding: 24px; text-align: center; }
        .payment-body { padding: 32px; }
        .payment-amount { font-size: 36px; font-weight: 700; letter-spacing: -0.5px; }
        #payment-element { min-height: 120px; }
        #payment-message { color: #dc3545; margin-top: 12px; font-size: 14px; }
        #payment-message.hidden { display: none; }
    </style>
</head>
<body style="background: var(--portal-bg, #EFF6FF);">
    <div class="payment-container">
        <div class="payment-card">
            <div class="payment-header">
                <img src="/medocslogo.png" alt="MEDOCS" style="height:32px; filter:brightness(0) invert(1); margin-bottom:8px;" onerror="this.style.display='none'">
                <div style="font-size:14px; opacity:0.9;" id="clinicName"></div>
            </div>
            <div class="payment-body">
                <div class="text-center mb-4">
                    <div class="text-muted small">Payment Amount</div>
                    <div class="payment-amount text-primary" id="displayAmount">$0.00</div>
                    <div class="text-muted small mt-1" id="displayPatientName"></div>
                </div>

                <div id="loadingState" class="text-center py-4">
                    <div class="spinner-border text-primary"></div>
                    <p class="text-muted mt-2 small">Setting up payment...</p>
                </div>

                <form id="payment-form" style="display:none;">
                    <div id="payment-element" class="mb-3 p-3 border rounded"></div>
                    <div id="payment-message" class="hidden"></div>
                    <button id="submitBtn" type="submit" class="btn btn-primary w-100 py-3 mt-2" style="font-size:16px;" disabled>
                        <span id="btn-text"><i class="bi bi-lock-fill me-2"></i>Pay Securely</span>
                        <span id="btn-spinner" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Processing...</span>
                    </button>
                </form>

                <div id="errorState" class="text-center py-4" style="display:none;">
                    <i class="bi bi-exclamation-circle text-danger" style="font-size:48px;"></i>
                    <p class="text-danger mt-2" id="errorMessage">Something went wrong.</p>
                </div>

                <div class="text-center mt-3">
                    <small class="text-muted"><i class="bi bi-shield-check me-1"></i>Secured by Stripe</small>
                </div>

                <div class="text-center mt-3">
                    <a href="/Portal/Billing" class="text-muted text-decoration-none small">
                        <i class="bi bi-arrow-left me-1"></i>Back to Billing
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <script>
    document.addEventListener('DOMContentLoaded', async () => {
        const params = new URLSearchParams(window.location.search);
        const amount = parseFloat(params.get('amount') || '0');

        // Get auth from localStorage (same keys as PatientPortalModule)
        const authToken = localStorage.getItem('portalAuthToken');
        const patientData = JSON.parse(localStorage.getItem('portalPatient') || '{}');

        if (!authToken || !amount) {
            window.location.href = '/Portal/Billing';
            return;
        }

        document.getElementById('displayAmount').textContent = '$' + amount.toFixed(2);
        document.getElementById('displayPatientName').textContent = patientData.PatientName || '';
        document.getElementById('clinicName').textContent = patientData.TenantName || '';

        try {
            // Create PaymentIntent via API
            const resp = await fetch('/api/portal/billing/create-payment-intent', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + authToken
                },
                body: JSON.stringify({ Amount: amount, PaymentType: 0 })
            });

            if (!resp.ok) {
                const err = await resp.json().catch(() => ({}));
                throw new Error(err.message || 'Failed to create payment session');
            }

            const data = await resp.json();

            // Initialize Stripe. The second arg { stripeAccount } is REQUIRED
            // because the PaymentIntent was created on the clinic's connected
            // account (Direct Charge model). Without it, Stripe Elements
            // validates the client_secret against the platform account and
            // rejects it with "The client_secret provided does not match any
            // associated PaymentIntent on this account."
            const stripe = Stripe(data.PublishableKey, { stripeAccount: data.StripeAccountId });
            const elements = stripe.elements({ clientSecret: data.ClientSecret });
            const paymentElement = elements.create('payment');
            paymentElement.mount('#payment-element');

            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('payment-form').style.display = 'block';

            paymentElement.on('ready', () => {
                document.getElementById('submitBtn').disabled = false;
            });

            // Handle form submit
            document.getElementById('payment-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                setLoading(true);

                const { error, paymentIntent } = await stripe.confirmPayment({
                    elements,
                    redirect: 'if_required'
                });

                if (error) {
                    setLoading(false);
                    showMessage(error.message);
                } else if (paymentIntent && paymentIntent.status === 'succeeded') {
                    // Pass stripe_account so the success page can fetch the
                    // PaymentIntent from Stripe API directly if our webhook
                    // hasn't yet written the local Payment row (race condition:
                    // Stripe redirects the user faster than the webhook lands).
                    const acct = encodeURIComponent(data.StripeAccountId || '');
                    window.location.href = '/Portal/PaymentSuccess?payment_intent='
                        + paymentIntent.id + '&stripe_account=' + acct;
                } else {
                    window.location.href = '/Portal/PaymentFailed';
                }
            });

        } catch (e) {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('errorState').style.display = 'block';
            document.getElementById('errorMessage').textContent = e.message || 'Failed to initialize payment.';
        }

        function setLoading(isLoading) {
            document.getElementById('submitBtn').disabled = isLoading;
            document.getElementById('btn-text').classList.toggle('d-none', isLoading);
            document.getElementById('btn-spinner').classList.toggle('d-none', !isLoading);
        }

        function showMessage(msg) {
            const el = document.getElementById('payment-message');
            el.textContent = msg;
            el.classList.remove('hidden');
            setTimeout(() => el.classList.add('hidden'), 5000);
        }
    });
    </script>
</body>
</html>
