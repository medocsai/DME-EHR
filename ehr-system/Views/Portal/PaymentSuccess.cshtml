@{
    Layout = null;
    var amount = ViewData["AmountPaid"]?.ToString() ?? "0.00";
    var patientName = ViewData["PatientName"]?.ToString() ?? "Patient";
    var clinicName = ViewData["ClinicName"]?.ToString() ?? "";
    var transactionId = ViewData["TransactionId"]?.ToString() ?? "";
    var transactionDate = ViewData["TransactionDate"]?.ToString() ?? DateTime.Now.ToString("MMMM d, yyyy");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Successful - Patient Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/patient-portal.css" rel="stylesheet">
    <style>
        .receipt-container { max-width: 550px; margin: 40px auto; }
        .receipt-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,.08); border-left: 5px solid #10B981; overflow: hidden; }
        .receipt-body { padding: 32px; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body style="background: var(--portal-bg, #EFF6FF);">
    <div class="receipt-container">
        <div class="receipt-card">
            <div class="receipt-body">
                <div class="text-center mb-4">
                    <i class="bi bi-check-circle-fill" style="font-size:64px; color:#10B981;"></i>
                    <h3 class="mt-3 fw-bold" style="color:#10B981;">Payment Successful</h3>
                    <p class="text-muted">Thank you for your payment. Here is your receipt.</p>
                </div>

                <div class="bg-light rounded p-3 mb-3">
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Patient</span>
                        <strong>@patientName</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Clinic</span>
                        <strong>@clinicName</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Amount Paid</span>
                        <strong class="text-success fs-5">$@amount</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Date</span>
                        <strong>@transactionDate</strong>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Transaction ID</span>
                        <strong style="font-size:12px;">@transactionId</strong>
                    </div>
                </div>

                <div class="no-print">
                    <button onclick="window.print()" class="btn btn-success w-100 py-2 mb-2">
                        <i class="bi bi-printer me-2"></i>Print Receipt
                    </button>
                    <a href="/Portal/Billing" class="btn btn-outline-secondary w-100 py-2">
                        <i class="bi bi-arrow-left me-2"></i>Back to Billing
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
