@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "Sign In";
    ViewData["PortalPage"] = "login";
    var portalCode = ViewData["PortalCode"]?.ToString() ?? "";
}

<!-- Location-Branded Portal Login -->
<div class="portal-login-wrapper">
    <div class="portal-login-card">
        <!-- Branding (loaded dynamically via JS) -->
        <div class="text-center mb-4" id="portalBranding">
            <div class="d-flex justify-content-center align-items-center gap-3 mb-3">
                <img src="/medocslogo.png" alt="MEDOCS" class="portal-login-logo" style="max-height: 40px;" onerror="this.style.display='none'">
                <img id="tenantLogo" src="" alt="" class="portal-login-logo d-none" style="max-height: 40px;" onerror="this.style.display='none'">
            </div>
            <h5 class="mb-1" id="portalTenantName">Patient Portal</h5>
            <p class="text-muted small mb-0" id="portalLocationName"></p>
        </div>

        <!-- Tab Switcher: Sign In | Set Up Account -->
        <ul class="nav nav-pills nav-fill mb-3" id="portalAuthTabs" style="border-radius: 8px; background: #f3f4f6; padding: 3px;">
            <li class="nav-item">
                <button class="nav-link active" id="tabSignIn" onclick="showAuthTab('signin')"
                    style="border-radius: 6px; font-size: 13px; font-weight: 600;">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="tabSetup" onclick="showAuthTab('setup')"
                    style="border-radius: 6px; font-size: 13px; font-weight: 600;">
                    <i class="bi bi-person-plus me-1"></i>Set Up Account
                </button>
            </li>
        </ul>

        <!-- ========== SIGN IN TAB ========== -->
        <div id="signinSection">
            <!-- Step 1: Email + Password Login -->
            <form id="portalEmailLoginForm">
                <div class="alert alert-danger d-none" id="portalLoginError"></div>
                <div class="alert alert-success d-none" id="portalLoginSuccess"></div>

                <div class="mb-3">
                    <label class="form-label" for="portalEmail">Email Address</label>
                    <input type="email" class="form-control" id="portalEmail" required
                           placeholder="your.email@example.com" autocomplete="email">
                </div>

                <div class="mb-3">
                    <label class="form-label" for="portalPassword">Password</label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="portalPassword" required
                               placeholder="Enter password" autocomplete="current-password">
                        <button class="btn btn-outline-secondary" type="button" id="togglePassword" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100" id="portalLoginBtn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>

                <div class="text-center mt-3">
                    <a href="javascript:void(0)" id="forgotPasswordLink" class="text-muted small">Forgot Password?</a>
                </div>
            </form>

            <!-- Step 2: OTP Verification (for Sign In) -->
            <div id="portalOtpSection" class="d-none">
                <div class="text-center mb-3">
                    <i class="bi bi-envelope-check" style="font-size: 2.5rem; color: var(--bs-primary);"></i>
                    <h5 class="mt-2 mb-1">Check Your Email</h5>
                    <p class="text-muted small" id="otpSentMessage">A verification code has been sent to your email.</p>
                </div>

                <form id="portalOtpForm">
                    <div class="alert alert-danger d-none" id="portalOtpError"></div>

                    <div class="mb-3">
                        <label class="form-label" for="portalOtpCode">Verification Code</label>
                        <input type="text" class="form-control text-center" id="portalOtpCode" required
                               maxlength="6" minlength="6" pattern="[0-9]{6}" inputmode="numeric"
                               placeholder="000000" autocomplete="one-time-code"
                               style="font-size: 1.5rem; letter-spacing: 0.5em;">
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="portalVerifyOtpBtn">
                        <i class="bi bi-shield-check me-2"></i>Verify Code
                    </button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-muted small">Didn't receive a code?</span>
                    <button class="btn btn-link btn-sm p-0 ms-1" id="resendOtpBtn">Resend</button>
                </div>
                <div class="text-center mt-2">
                    <button class="btn btn-link text-muted btn-sm" id="backToLoginBtn">
                        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
                    </button>
                </div>
            </div>

            <!-- Forgot Password Section -->
            <div id="portalForgotPasswordSection" class="d-none">
                <div class="text-center mb-3">
                    <i class="bi bi-key" style="font-size: 2.5rem; color: var(--bs-warning);"></i>
                    <h5 class="mt-2 mb-1">Reset Password</h5>
                    <p class="text-muted small">Enter your email and we'll send a reset link.</p>
                </div>

                <form id="portalForgotPasswordForm">
                    <div class="alert alert-danger d-none" id="forgotPasswordError"></div>
                    <div class="alert alert-success d-none" id="forgotPasswordSuccess"></div>

                    <div class="mb-3">
                        <label class="form-label" for="forgotEmail">Email Address</label>
                        <input type="email" class="form-control" id="forgotEmail" required
                               placeholder="your.email@example.com" autocomplete="email">
                    </div>

                    <button type="submit" class="btn btn-warning w-100" id="forgotPasswordBtn">
                        <i class="bi bi-envelope me-2"></i>Send Reset Link
                    </button>
                </form>

                <div class="text-center mt-3">
                    <button class="btn btn-link text-muted btn-sm" id="backToLoginFromForgot">
                        <i class="bi bi-arrow-left me-1"></i>Back to Sign In
                    </button>
                </div>
            </div>
        </div>

        <!-- ========== SET UP ACCOUNT TAB ========== -->
        <div id="setupSection" class="d-none">
            <!-- Step 1: DOB + SSN Last 4 -->
            <form id="setupVerifyForm">
                <div class="alert alert-danger d-none" id="setupError"></div>
                <div class="alert alert-info d-none" id="setupHasAccountMsg">
                    <i class="bi bi-info-circle me-1"></i>
                    <span></span>
                </div>

                <p class="text-muted small mb-3">Verify your identity to set up your portal account.</p>

                <div class="mb-3">
                    <label class="form-label" for="setupLastName">Last Name</label>
                    <input type="text" class="form-control" id="setupLastName" required
                           maxlength="100" autocomplete="off" autocapitalize="words">
                </div>

                <div class="mb-3">
                    <label class="form-label" for="setupDob">Date of Birth</label>
                    <input type="date" class="form-control" id="setupDob" required>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="setupZip">ZIP Code</label>
                    <input type="text" class="form-control" id="setupZip" required
                           maxlength="10" minlength="5" inputmode="numeric"
                           placeholder="12345" autocomplete="off">
                </div>

                <button type="submit" class="btn btn-primary w-100" id="setupVerifyBtn">
                    <i class="bi bi-shield-check me-2"></i>Verify Identity
                </button>
            </form>

            <!-- Step 2: OTP Verification + Set Password -->
            <div id="setupOtpSection" class="d-none">
                <div class="text-center mb-3">
                    <i class="bi bi-envelope-check" style="font-size: 2.5rem; color: var(--bs-primary);"></i>
                    <h5 class="mt-2 mb-1">Verify Your Email</h5>
                    <p class="text-muted small" id="setupOtpMessage">A verification code has been sent to your email.</p>
                </div>

                <form id="setupCompleteForm">
                    <div class="alert alert-danger d-none" id="setupOtpError"></div>

                    <div class="mb-3">
                        <label class="form-label" for="setupOtpCode">Verification Code</label>
                        <input type="text" class="form-control text-center" id="setupOtpCode" required
                               maxlength="6" minlength="6" pattern="[0-9]{6}" inputmode="numeric"
                               placeholder="000000" autocomplete="one-time-code"
                               style="font-size: 1.5rem; letter-spacing: 0.5em;">
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="setupNewPassword">Create Password</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="setupNewPassword" required
                                   minlength="8" placeholder="Minimum 8 characters" autocomplete="new-password">
                            <button class="btn btn-outline-secondary" type="button" id="toggleSetupPassword" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="setupConfirmPassword">Confirm Password</label>
                        <input type="password" class="form-control" id="setupConfirmPassword" required
                               minlength="8" placeholder="Re-enter password" autocomplete="new-password">
                    </div>

                    <button type="submit" class="btn btn-primary w-100" id="setupCompleteBtn">
                        <i class="bi bi-check-circle me-2"></i>Set Up Account
                    </button>
                </form>

                <div class="text-center mt-3">
                    <span class="text-muted small">Didn't receive a code?</span>
                    <button class="btn btn-link btn-sm p-0 ms-1" id="setupResendOtpBtn">Resend</button>
                </div>
                <div class="text-center mt-2">
                    <button class="btn btn-link text-muted btn-sm" id="backToSetupBtn">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </button>
                </div>
            </div>
        </div>

        <!-- Location Contact Info -->
        <div id="portalContactInfo" class="text-center mt-4 d-none">
            <hr>
            <small class="text-muted" id="portalLocationAddress"></small>
            <br>
            <small class="text-muted" id="portalLocationPhone"></small>
        </div>

        <div class="text-center mt-3">
            <small class="text-muted">
                <i class="bi bi-shield-lock me-1"></i>HIPAA Compliant - Secure Access
            </small>
        </div>
    </div>
</div>

<!-- Hidden data for JS -->
<input type="hidden" id="portalCodeData" value="@portalCode" />

<script>
    // Portal login page initialization with branding
    (function() {
        const portalCode = document.getElementById('portalCodeData')?.value;
        if (!portalCode) return;

        // Store portal code globally for the module
        window._portalCode = portalCode;

        // Load location branding
        fetch(`/api/portal/location/${portalCode}`)
            .then(r => r.ok ? r.json() : null)
            .then(info => {
                if (!info) {
                    document.getElementById('portalLoginError').textContent = 'This portal link is invalid or expired.';
                    document.getElementById('portalLoginError').classList.remove('d-none');
                    document.getElementById('portalEmailLoginForm').querySelector('button[type=submit]').disabled = true;
                    return;
                }
                // Set branding
                document.getElementById('portalTenantName').textContent = info.TenantName || 'Patient Portal';
                document.getElementById('portalLocationName').textContent = info.LocationName || '';

                if (info.TenantLogoUrl) {
                    const logo = document.getElementById('tenantLogo');
                    logo.src = info.TenantLogoUrl;
                    logo.alt = info.TenantName || '';
                    logo.classList.remove('d-none');
                }

                // Contact info
                const contactSection = document.getElementById('portalContactInfo');
                const addressEl = document.getElementById('portalLocationAddress');
                const phoneEl = document.getElementById('portalLocationPhone');

                let hasContact = false;
                if (info.Address) {
                    addressEl.textContent = info.Address;
                    hasContact = true;
                }
                if (info.Phone) {
                    phoneEl.textContent = info.Phone;
                    hasContact = true;
                }
                if (hasContact) contactSection.classList.remove('d-none');

                // Store for use in JS module
                window._portalLocationInfo = info;
            })
            .catch(() => {});
    })();

    // Tab switching
    function showAuthTab(tab) {
        const signinSection = document.getElementById('signinSection');
        const setupSection = document.getElementById('setupSection');
        const tabSignIn = document.getElementById('tabSignIn');
        const tabSetup = document.getElementById('tabSetup');

        // Hide all sub-sections and reset
        document.getElementById('portalOtpSection')?.classList.add('d-none');
        document.getElementById('portalForgotPasswordSection')?.classList.add('d-none');
        document.getElementById('portalEmailLoginForm')?.classList.remove('d-none');
        document.getElementById('setupOtpSection')?.classList.add('d-none');
        document.getElementById('setupVerifyForm')?.classList.remove('d-none');

        // Clear errors
        document.querySelectorAll('.alert').forEach(a => a.classList.add('d-none'));

        if (tab === 'signin') {
            signinSection.classList.remove('d-none');
            setupSection.classList.add('d-none');
            tabSignIn.classList.add('active');
            tabSetup.classList.remove('active');
        } else {
            signinSection.classList.add('d-none');
            setupSection.classList.remove('d-none');
            tabSignIn.classList.remove('active');
            tabSetup.classList.add('active');
        }
    }

    // Setup account: toggle password visibility
    document.getElementById('toggleSetupPassword')?.addEventListener('click', function() {
        const input = document.getElementById('setupNewPassword');
        const icon = this.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('bi-eye-slash', 'bi-eye');
        }
    });

    // Setup account: Step 1 — Verify identity
    let pendingSetupAccountId = null;
    let pendingSetupPortalCode = null;

    document.getElementById('setupVerifyForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const errorEl = document.getElementById('setupError');
        const hasAccountEl = document.getElementById('setupHasAccountMsg');
        const btn = document.getElementById('setupVerifyBtn');
        errorEl?.classList.add('d-none');
        hasAccountEl?.classList.add('d-none');

        const lastName = document.getElementById('setupLastName')?.value?.trim();
        const dob = document.getElementById('setupDob')?.value;
        const zip = document.getElementById('setupZip')?.value?.trim();
        const portalCode = window._portalCode;

        if (!lastName || !dob || !zip || zip.length < 5) {
            errorEl.textContent = 'Please enter your last name, date of birth, and ZIP code.';
            errorEl.classList.remove('d-none');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Verifying...';

        try {
            const resp = await fetch('/api/portal/auth/setup-verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ LastName: lastName, DateOfBirth: dob, ZipCode: zip, PortalCode: portalCode })
            });
            const result = await resp.json();

            if (result.HasAccount) {
                // Account already exists — tell them to sign in
                hasAccountEl.querySelector('span').textContent = result.Message || 'Your account is already set up. Please sign in.';
                hasAccountEl.classList.remove('d-none');
                return;
            }

            if (!result.Success) {
                errorEl.textContent = result.Message || 'Verification failed.';
                errorEl.classList.remove('d-none');
                return;
            }

            if (result.RequiresOtp) {
                pendingSetupAccountId = result.AccountId;
                pendingSetupPortalCode = portalCode;

                // Show OTP + password section
                document.getElementById('setupVerifyForm').classList.add('d-none');
                document.getElementById('setupOtpSection').classList.remove('d-none');

                if (result.MaskedEmail) {
                    document.getElementById('setupOtpMessage').textContent =
                        `A verification code has been sent to ${result.MaskedEmail}`;
                }

                setTimeout(() => document.getElementById('setupOtpCode')?.focus(), 100);
            }
        } catch (err) {
            errorEl.textContent = 'An error occurred. Please try again.';
            errorEl.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-shield-check me-2"></i>Verify Identity';
        }
    });

    // Setup account: Step 2 — OTP + Set Password
    document.getElementById('setupCompleteForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const errorEl = document.getElementById('setupOtpError');
        const btn = document.getElementById('setupCompleteBtn');
        errorEl?.classList.add('d-none');

        const code = document.getElementById('setupOtpCode')?.value?.trim();
        const password = document.getElementById('setupNewPassword')?.value;
        const confirmPassword = document.getElementById('setupConfirmPassword')?.value;

        if (!code || code.length !== 6) {
            errorEl.textContent = 'Please enter the 6-digit verification code.';
            errorEl.classList.remove('d-none');
            return;
        }

        if (!password || password.length < 8) {
            errorEl.textContent = 'Password must be at least 8 characters.';
            errorEl.classList.remove('d-none');
            return;
        }

        if (password !== confirmPassword) {
            errorEl.textContent = 'Passwords do not match.';
            errorEl.classList.remove('d-none');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Setting up...';

        try {
            const resp = await fetch('/api/portal/auth/setup-complete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    AccountId: pendingSetupAccountId,
                    Code: code,
                    Password: password,
                    PortalCode: pendingSetupPortalCode
                })
            });
            const result = await resp.json();

            if (!result.Success) {
                errorEl.textContent = result.Message || 'Setup failed.';
                errorEl.classList.remove('d-none');
                return;
            }

            // Success — auto-login
            if (result.Token && window.PatientPortalModule) {
                window.PatientPortalModule.completeLogin(result);
            } else if (result.Token) {
                localStorage.setItem('portalAuthToken', result.Token);
                localStorage.setItem('portalPatient', JSON.stringify({
                    PatientId: result.PatientId,
                    PatientName: result.PatientName,
                    TenantId: result.TenantId,
                    PortalCode: result.PortalCode
                }));
                window.location.href = '/Portal/Dashboard';
            }
        } catch (err) {
            errorEl.textContent = 'An error occurred. Please try again.';
            errorEl.classList.remove('d-none');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle me-2"></i>Set Up Account';
        }
    });

    // Setup: Resend OTP
    document.getElementById('setupResendOtpBtn')?.addEventListener('click', async function() {
        this.disabled = true;
        this.textContent = 'Sending...';
        try {
            await fetch('/api/portal/auth/resend-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ AccountId: pendingSetupAccountId, PortalCode: pendingSetupPortalCode })
            });
            this.textContent = 'Sent!';
            setTimeout(() => { this.textContent = 'Resend'; this.disabled = false; }, 3000);
        } catch {
            this.textContent = 'Resend';
            this.disabled = false;
        }
    });

    // Setup: Back button
    document.getElementById('backToSetupBtn')?.addEventListener('click', function() {
        document.getElementById('setupOtpSection').classList.add('d-none');
        document.getElementById('setupVerifyForm').classList.remove('d-none');
        document.querySelectorAll('#setupSection .alert').forEach(a => a.classList.add('d-none'));
    });
</script>
