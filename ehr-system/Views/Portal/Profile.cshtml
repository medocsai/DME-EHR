@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["PortalPage"] = "profile";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-person me-2"></i>My Profile</h5>
</div>

<p class="text-muted small mb-3">Your profile picture is the only field you can update from the portal. To change other information, please contact your clinic.</p>

<!-- Profile Picture (editable by patient) -->
<div id="portalProfilePictureSection" class="card portal-card mb-3">
    <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <div id="portalProfilePictureAvatar">
            <div class="profile-avatar avatar-xl avatar-initials-patient">
                <span class="profile-avatar-initials">?</span>
            </div>
        </div>
        <div class="flex-grow-1">
            <h6 class="mb-1">Profile Picture</h6>
            <p class="text-muted small mb-2">JPG, PNG, or WebP. Max 5MB.</p>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-primary" id="portalProfilePictureChangeBtn">
                    <i class="bi bi-camera me-1"></i><span id="portalProfilePictureChangeLabel">Add Photo</span>
                </button>
                <button type="button" class="btn btn-outline-danger d-none" id="portalProfilePictureRemoveBtn">
                    <i class="bi bi-trash me-1"></i>Remove
                </button>
            </div>
            <input type="file" id="portalProfilePictureInput" accept=".jpg,.jpeg,.png,.webp" class="d-none">
        </div>
    </div>
</div>

<!-- Profile Content (view-only) -->
<div id="profileContent">
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm"></div> Loading profile...
    </div>
</div>
