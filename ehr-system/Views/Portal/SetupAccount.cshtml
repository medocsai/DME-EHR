@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Up Account - Patient Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/patient-portal.css" rel="stylesheet">
</head>
<body>
<div class="portal-login-wrapper">
    <div class="portal-login-card" style="max-width: 450px;">
        <div class="text-center mb-4">
            <img src="/medocslogo.png" alt="MEDOCS" class="portal-login-logo" style="max-height: 40px;" onerror="this.style.display='none'">
            <h5 class="mt-3 mb-1" id="setupClinicName">Patient Portal</h5>
            <p class="text-muted small" id="setupClinicLocation"></p>
        </div>

        <!-- Loading -->
        <div id="setupLoading" class="text-center py-4">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted small">Validating link...</p>
        </div>

        <!-- Invalid/Expired -->
        <div id="setupInvalid" class="d-none text-center py-4">
            <i class="bi bi-exclamation-circle" style="font-size: 3rem; color: var(--bs-danger);"></i>
            <h5 class="mt-3">Link Expired</h5>
            <p class="text-muted">This link has expired or is no longer valid. Please contact your clinic.</p>
        </div>

        <!-- Already Has Account -->
        <div id="setupAlreadyExists" class="d-none text-center py-4">
            <i class="bi bi-check-circle" style="font-size: 3rem; color: var(--bs-success);"></i>
            <h5 class="mt-3">Account Already Exists</h5>
            <p class="text-muted">You already have an account. Please sign in.</p>
            <a href="#" id="goToLoginFromSetup" class="btn btn-primary mt-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </a>
        </div>

        <!-- Setup Form -->
        <div id="setupFormSection" class="d-none">
            <div class="text-center mb-4">
                <h5>Set Up Your Account</h5>
                <p class="text-muted small mb-0">Welcome, <strong id="setupPatientName"></strong>!</p>
                <p class="text-muted small">Create a password to access your patient portal.</p>
            </div>

            <form id="setupForm">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <input type="email" class="form-control" id="setupEmail" readonly style="background:#f9fafb;">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Create Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control" id="setupPassword" placeholder="Minimum 8 characters" minlength="8" required>
                        <button class="btn btn-outline-secondary" type="button" id="toggleSetupPassword">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <div class="form-text" id="setupPasswordStrength"></div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="setupConfirmPassword" placeholder="Re-enter password" required>
                </div>

                <div id="setupError" class="alert alert-danger d-none small"></div>

                <button type="submit" class="btn btn-primary w-100 py-2" id="setupSubmitBtn">
                    <i class="bi bi-shield-check me-2"></i>Create Account
                </button>
            </form>
        </div>

        <!-- Success -->
        <div id="setupSuccess" class="d-none text-center py-4">
            <i class="bi bi-check-circle" style="font-size: 3rem; color: var(--bs-success);"></i>
            <h5 class="mt-3">Account Created!</h5>
            <p class="text-muted">Your portal account is ready. You can now sign in.</p>
            <a href="#" id="goToLoginAfterSetup" class="btn btn-primary mt-2 px-4 py-2">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In Now
            </a>
        </div>
    </div>
</div>

<script>
(function() {
    const token = new URLSearchParams(window.location.search).get('token');
    const action = new URLSearchParams(window.location.search).get('action');

    const loadingEl = document.getElementById('setupLoading');
    const invalidEl = document.getElementById('setupInvalid');
    const alreadyEl = document.getElementById('setupAlreadyExists');
    const formSection = document.getElementById('setupFormSection');
    const successEl = document.getElementById('setupSuccess');
    const errorEl = document.getElementById('setupError');

    if (!token) {
        loadingEl.classList.add('d-none');
        invalidEl.classList.remove('d-none');
        return;
    }

    // Validate token by calling the pay endpoint info
    fetch(`/api/portal/auth/validate-setup-token?token=${encodeURIComponent(token)}`)
        .then(r => r.json())
        .then(data => {
            loadingEl.classList.add('d-none');
            if (!data.Valid) {
                if (data.HasAccount) {
                    alreadyEl.classList.remove('d-none');
                    if (data.PortalCode) {
                        const actionSuffix = action ? `?action=${action}` : '';
                        document.getElementById('goToLoginFromSetup').href = `/Portal/${data.PortalCode}${actionSuffix}`;
                    }
                } else {
                    invalidEl.classList.remove('d-none');
                }
                return;
            }
            // Show form
            document.getElementById('setupPatientName').textContent = data.PatientName || 'Patient';
            document.getElementById('setupEmail').value = data.Email || '';
            if (data.ClinicName) document.getElementById('setupClinicName').textContent = data.ClinicName;
            formSection.classList.remove('d-none');
        })
        .catch(() => {
            loadingEl.classList.add('d-none');
            invalidEl.classList.remove('d-none');
        });

    // Toggle password visibility
    document.getElementById('toggleSetupPassword')?.addEventListener('click', function() {
        const input = document.getElementById('setupPassword');
        const icon = this.querySelector('i');
        if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
        else { input.type = 'password'; icon.className = 'bi bi-eye'; }
    });

    // Password strength
    document.getElementById('setupPassword')?.addEventListener('input', function() {
        const el = document.getElementById('setupPasswordStrength');
        if (this.value.length < 8) { el.textContent = 'Too short'; el.className = 'form-text text-danger'; }
        else if (this.value.length >= 12 && /[!@@#$%^&*]/.test(this.value)) { el.textContent = 'Strong'; el.className = 'form-text text-success'; }
        else { el.textContent = 'Good'; el.className = 'form-text text-info'; }
    });

    // Submit
    document.getElementById('setupForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        const password = document.getElementById('setupPassword').value;
        const confirm = document.getElementById('setupConfirmPassword').value;

        errorEl.classList.add('d-none');

        if (password.length < 8) {
            errorEl.textContent = 'Password must be at least 8 characters.';
            errorEl.classList.remove('d-none');
            return;
        }
        if (password !== confirm) {
            errorEl.textContent = 'Passwords do not match.';
            errorEl.classList.remove('d-none');
            return;
        }

        const btn = document.getElementById('setupSubmitBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';

        try {
            const resp = await fetch('/api/portal/auth/setup-account', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Token: token, Password: password })
            });
            const result = await resp.json();
            if (!resp.ok) {
                errorEl.textContent = result.message || 'Failed to create account.';
                errorEl.classList.remove('d-none');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-shield-check me-2"></i>Create Account';
                return;
            }

            // Auto-login: store JWT token and redirect directly to billing
            if (result.token) {
                localStorage.setItem('portalAuthToken', result.token);
                localStorage.setItem('portalPatient', JSON.stringify({
                    PatientId: result.patientId,
                    PatientName: result.patientName,
                    TenantId: result.tenantId,
                    PortalCode: result.portalCode
                }));
                // Redirect directly to billing (or dashboard)
                const target = action === 'billing' ? '/Portal/Billing' : '/Portal/Dashboard';
                window.location.href = target;
                return;
            }

            // Fallback: show success with login link
            formSection.classList.add('d-none');
            successEl.classList.remove('d-none');
            if (result.portalCode) {
                document.getElementById('goToLoginAfterSetup').href = `/Portal/${result.portalCode}`;
            }
        } catch (err) {
            errorEl.textContent = 'An error occurred. Please try again.';
            errorEl.classList.remove('d-none');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-shield-check me-2"></i>Create Account';
        }
    });
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
