@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "My Visits";
    ViewData["PortalPage"] = "visits";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-clipboard2-pulse me-2"></i>My Visits</h5>
</div>

<p class="text-muted small mb-3">A short summary of each visit in plain language. Tap any visit to read more.</p>

<!-- Visits List -->
<div id="visitsList">
    <div class="text-center text-muted py-4">
        <div class="spinner-border spinner-border-sm"></div> Loading visits...
    </div>
</div>

<!-- Visit Summary Modal -->
<div class="modal fade" id="visitSummaryModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Visit Summary</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="visitSummaryContent">
                <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm"></div> Loading...
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
