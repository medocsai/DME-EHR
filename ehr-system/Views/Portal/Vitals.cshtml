@{
    Layout = "~/Views/Shared/_PatientPortalLayout.cshtml";
    ViewData["Title"] = "My Vitals";
    ViewData["PortalPage"] = "vitals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
