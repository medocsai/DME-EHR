@{
    ViewData["Title"] = "E-Prescribe";
    ViewData["ActivePage"] = "prescriptions";
}

<!-- Prescriptions Page -->
<div class="page active" id="prescriptionsPage">
    <div class="card">
        <div class="card-header">
            <div class="row g-3 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="rxFilterSearch" placeholder="Search patient or drug..." autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" id="rxFilterStartDate" title="From Date" autocomplete="off">
                </div>
                <div class="col-md-2">
                    <input type="date" class="form-control" id="rxFilterEndDate" title="To Date" autocomplete="off">
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="rxFilterStatus">
                        <option value="">All Statuses</option>
                        <option value="0">Draft</option>
                        <option value="1">Active</option>
                        <option value="2">Sent</option>
                        <option value="3">Filled</option>
                        <option value="4">Cancelled</option>
                        <option value="5">Expired</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100 hide-from-ma-nurse" id="btnNewPrescription">
                        <i class="bi bi-plus-lg"></i> New Rx
                    </button>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" id="btnClearRxFilters" title="Clear Filters">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="prescriptionsTable">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Patient</th>
                            <th>Drug</th>
                            <th>Strength</th>
                            <th>SIG</th>
                            <th>Qty</th>
                            <th>Refills</th>
                            <th>Pharmacy</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center" id="rxPagination">
                <small class="text-muted" id="rxPageInfo">Showing 0 prescriptions</small>
                <nav aria-label="Prescriptions pagination">
                    <ul class="pagination pagination-sm mb-0" id="rxPaginationControls"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_ModalsPrescription" />
    <partial name="_Modals" />
}

@section Scripts {
}
