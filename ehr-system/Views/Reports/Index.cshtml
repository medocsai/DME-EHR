@{
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "reports";
}

<!-- Reports Page - Analytical Reporting System -->
<div class="page active" id="reportsPage">
    <!-- Reports Layout: Category Sidebar + Content Area -->
    <div class="reports-layout" id="reportsLayout">
        <!-- Report Categories Sidebar -->
        <aside class="reports-sidebar" id="reportsSidebar">
            <div class="reports-sidebar-header">
                <button class="btn btn-sm btn-outline-secondary w-100 text-start" id="exitReportsBtn" onclick="exitReports()">
                    <i class="bi bi-arrow-left me-2"></i>Exit Reports
                </button>
            </div>
            <div class="reports-search px-3 mb-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" id="reportSearchInput" placeholder="Search reports..." oninput="searchReports(this.value)">
                </div>
            </div>
            <nav class="reports-nav">
                <a href="#" class="reports-nav-item active" data-category="all" onclick="selectReportCategory('all', event)">
                    <i class="bi bi-grid-3x3-gap"></i>
                    <span>All Reports</span>
                    <span class="badge bg-secondary rounded-pill reports-badge" id="badgeAll">13</span>
                </a>
                <a href="#" class="reports-nav-item" data-category="clinical" onclick="selectReportCategory('clinical', event)">
                    <i class="bi bi-file-earmark-medical"></i>
                    <span>Clinical</span>
                    <span class="badge bg-secondary rounded-pill reports-badge" id="badgeClinical">4</span>
                </a>
                <a href="#" class="reports-nav-item" data-category="visits" onclick="selectReportCategory('visits', event)">
                    <i class="bi bi-calendar-check"></i>
                    <span>Visits</span>
                    <span class="badge bg-secondary rounded-pill reports-badge" id="badgeVisits">2</span>
                </a>
                <a href="#" class="reports-nav-item" data-category="revenue" onclick="selectReportCategory('revenue', event)">
                    <i class="bi bi-currency-dollar"></i>
                    <span>Revenue</span>
                    <span class="badge bg-secondary rounded-pill reports-badge" id="badgeRevenue">5</span>
                </a>
                <a href="#" class="reports-nav-item" data-category="providers" onclick="selectReportCategory('providers', event)">
                    <i class="bi bi-person-badge"></i>
                    <span>Providers</span>
                    <span class="badge bg-secondary rounded-pill reports-badge" id="badgeProviders">1</span>
                </a>
                <a href="#" class="reports-nav-item" data-category="patients" onclick="selectReportCategory('patients', event)">
                    <i class="bi bi-people"></i>
                    <span>Patients</span>
                    <span class="badge bg-secondary rounded-pill reports-badge" id="badgePatients">1</span>
                </a>
                <hr class="mx-3 my-2">
                <a href="#" class="reports-nav-item" data-category="monthly-grid" onclick="selectReportCategory('monthly-grid', event)">
                    <i class="bi bi-calendar2-week"></i>
                    <span>Monthly Grid</span>
                </a>
            </nav>
        </aside>

        <!-- Report Content Area -->
        <div class="reports-content" id="reportsContent">
            <!-- Report List View (shown when a category is selected) -->
            <div id="reportListView">
                <h5 class="mb-3" id="reportListTitle">All Reports</h5>
                <div class="row g-3" id="reportListCards">
                    <!-- Dynamically populated -->
                </div>
            </div>

            <!-- Report Detail View (shown when a specific report is opened) -->
            <div id="reportDetailView" class="d-none">
                <!-- Back + Title + Export -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center">
                        <button class="btn btn-sm btn-outline-secondary me-3" onclick="backToReportList()">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </button>
                        <h5 class="mb-0" id="reportDetailTitle">Report</h5>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-primary" onclick="exportCurrentReport('pdf')"><i class="bi bi-file-pdf me-1"></i>PDF</button>
                        <button class="btn btn-sm btn-outline-success" onclick="exportCurrentReport('excel')"><i class="bi bi-file-excel me-1"></i>Excel</button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="exportCurrentReport('print')"><i class="bi bi-printer me-1"></i>Print</button>
                    </div>
                </div>

                <!-- Filters Bar -->
                <div class="card mb-3" id="reportFiltersCard">
                    <div class="card-body py-3">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Period</label>
                                <select class="form-select form-select-sm" id="filterPeriod" onchange="onPeriodChange()">
                                    <option value="this-month">This Month</option>
                                    <option value="last-month">Last Month</option>
                                    <option value="this-quarter">This Quarter</option>
                                    <option value="last-quarter">Last Quarter</option>
                                    <option value="ytd">Year to Date</option>
                                    <option value="custom">Custom Range</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-none" id="filterCustomDates">
                                <label class="form-label small mb-1">From</label>
                                <input type="date" class="form-control form-control-sm" id="filterStartDate">
                            </div>
                            <div class="col-md-2 d-none" id="filterCustomDatesEnd">
                                <label class="form-label small mb-1">To</label>
                                <input type="date" class="form-control form-control-sm" id="filterEndDate">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Provider</label>
                                <select class="form-select form-select-sm" id="filterProvider">
                                    <option value="">All Providers</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small mb-1">Location</label>
                                <select class="form-select form-select-sm" id="filterLocation">
                                    <option value="">All Locations</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-primary btn-sm w-100" onclick="runCurrentReport()">
                                    <i class="bi bi-play-fill me-1"></i>Apply Filters
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-3" id="reportKpiCards">
                    <!-- Dynamically populated -->
                </div>

                <!-- Chart Area -->
                <div class="card mb-3" id="reportChartCard">
                    <div class="card-body">
                        <div id="reportChartContainer" style="position: relative; height: 300px;">
                            <canvas id="reportChart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Data Table -->
                <div class="card" id="reportTableCard">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                        <small class="text-muted" id="reportTableCount">Showing 0 results</small>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0" id="reportDataTable">
                                <thead id="reportTableHead"></thead>
                                <tbody id="reportTableBody"></tbody>
                                <tfoot id="reportTableFoot"></tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Loading -->
                <div id="reportDetailLoading" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading report data...</p>
                </div>

                <!-- Empty state -->
                <div id="reportDetailEmpty" class="text-center py-5 d-none">
                    <i class="bi bi-clipboard-data display-4 text-muted"></i>
                    <p class="mt-2 text-muted">No data found for the selected filters.</p>
                    <button class="btn btn-sm btn-outline-primary" onclick="runCurrentReport()">Reset & Try Again</button>
                </div>
            </div>

            <!-- Monthly Grid Legacy View -->
            <div id="monthlyPatientVisitGridView" class="d-none">
                <div class="mb-3">
                    <button class="btn btn-sm btn-outline-secondary" onclick="backToReportList()">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </button>
                </div>
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-calendar2-week me-2"></i>Monthly Patient Visit Grid</h5>
                            <div class="btn-group">
                                <button class="btn btn-sm btn-light" onclick="exportReportToPDF()"><i class="bi bi-file-pdf"></i> PDF</button>
                                <button class="btn btn-sm btn-light" onclick="exportReportToExcel()"><i class="bi bi-file-excel"></i> Excel</button>
                                <button class="btn btn-sm btn-light" onclick="printReport()"><i class="bi bi-printer"></i> Print</button>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">Provider</label>
                                <select class="form-select" id="reportTherapistFilter"><option value="">All Providers</option></select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Month</label>
                                <select class="form-select" id="reportMonthFilter">
                                    <option value="1">January</option><option value="2">February</option><option value="3">March</option>
                                    <option value="4">April</option><option value="5">May</option><option value="6">June</option>
                                    <option value="7">July</option><option value="8">August</option><option value="9">September</option>
                                    <option value="10">October</option><option value="11">November</option><option value="12">December</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Year</label>
                                <select class="form-select" id="reportYearFilter"></select>
                            </div>
                            <div class="col-md-3">
                                <button class="btn btn-primary w-100" onclick="runMonthlyPatientVisitReport()">
                                    <i class="bi bi-play-fill me-1"></i>Run Report
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card" id="reportGridContainer">
                    <div class="card-body p-0">
                        <div class="report-header-info d-flex justify-content-between align-items-center p-3 bg-light border-bottom" id="reportHeaderInfo">
                            <div class="report-agency"><strong id="reportAgencyName">-</strong></div>
                            <div class="report-discipline"><strong id="reportDiscipline">All Disciplines</strong></div>
                            <div class="report-period"><strong>Mo./Yr.: <span id="reportMonthYear">-</span></strong></div>
                        </div>
                        <div id="reportLoading" class="text-center py-5 d-none">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Loading report data...</p>
                        </div>
                        <div id="reportEmptyState" class="text-center py-5 d-none">
                            <i class="bi bi-calendar-x display-4 text-muted"></i>
                            <p class="mt-2 text-muted">No patient visits found for the selected criteria.</p>
                        </div>
                        <div class="visit-grid-wrapper" id="visitGridWrapper">
                            <table class="visit-grid-table" id="visitGridTable">
                                <thead id="visitGridHeader"></thead>
                                <tbody id="visitGridBody"></tbody>
                            </table>
                        </div>
                        <div class="report-footer p-3 bg-light border-top" id="reportFooter" style="display: none;">
                            <div class="d-flex justify-content-end mb-3">
                                <strong>Total Visits for the Month: <span id="reportTotalVisits">0</span></strong>
                            </div>
                            <div class="report-legend mb-3">
                                <small class="text-muted">
                                    <strong>Appointment Types:</strong>
                                    <span class="visit-code-legend visit-code-N">N</span> = New Patient |
                                    <span class="visit-code-legend visit-code-F">F</span> = Follow-Up |
                                    <span class="visit-code-legend visit-code-A">A</span> = Annual Physical |
                                    <span class="visit-code-legend visit-code-W">W</span> = Wellness |
                                    <span class="visit-code-legend visit-code-C">C</span> = Consultation |
                                    <span class="visit-code-legend visit-code-T">T</span> = Telehealth |
                                    <span class="visit-code-legend visit-code-P">P</span> = Procedure |
                                    <span class="visit-code-legend visit-code-U">U</span> = Urgent
                                </small>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted" id="reportCompanyName">MEDOCS</small>
                                <small class="text-muted"><span id="reportRowCount">0</span> patients | Printed: <span id="reportPrintedDate">-</span></small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_Modals" />
}

@section Scripts {
}
