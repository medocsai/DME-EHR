@{
    ViewData["Title"] = "Schedule";
    ViewData["ActivePage"] = "schedule";
}

@await Html.PartialAsync("_ModalsAppointment")
@await Html.PartialAsync("_Modals")

<!-- Schedule Page -->
<div class="page active" id="schedulePage">
    <div class="card mb-3 schedule-filters-card" id="scheduleFiltersCard">
        <div class="card-body py-3">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-funnel text-primary"></i>
                    <h6 class="mb-0 fw-semibold text-secondary">Filters</h6>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span id="scheduleFilterCount" class="badge bg-primary-subtle text-primary" style="display: none;">0 of 0</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary schedule-filter-clear-btn" id="clearScheduleFilters" style="display: none;" title="Clear all filters">
                        <i class="bi bi-x-lg me-1"></i>Clear
                    </button>
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="dropdown schedule-filter-dropdown">
                    <button class="btn schedule-filter-btn dropdown-toggle" type="button" id="typeFilterBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-calendar-event me-1"></i>Appointment Type
                        <span class="badge bg-primary rounded-pill ms-1 d-none" id="typeFilterCount">0</span>
                    </button>
                    <div class="dropdown-menu schedule-filter-menu p-3" style="min-width: 240px;">
                        <div class="schedule-filter-group">
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="0" id="typeFilter0">
                                <label class="form-check-label" for="typeFilter0">New Patient Visit</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="1" id="typeFilter1">
                                <label class="form-check-label" for="typeFilter1">Follow-Up Visit</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="2" id="typeFilter2">
                                <label class="form-check-label" for="typeFilter2">Annual Physical</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="3" id="typeFilter3">
                                <label class="form-check-label" for="typeFilter3">Wellness Exam</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="4" id="typeFilter4">
                                <label class="form-check-label" for="typeFilter4">Consultation</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="5" id="typeFilter5">
                                <label class="form-check-label" for="typeFilter5">Telehealth</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="6" id="typeFilter6">
                                <label class="form-check-label" for="typeFilter6">Procedure Visit</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="7" id="typeFilter7">
                                <label class="form-check-label" for="typeFilter7">Urgent Visit</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="8" id="typeFilter8">
                                <label class="form-check-label" for="typeFilter8">Lab Review</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="9" id="typeFilter9">
                                <label class="form-check-label" for="typeFilter9">Medication Review</label>
                            </div>
                        </div>
                        <hr class="my-2">
                        <div class="schedule-filter-group">
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="missed" id="typeFilterMissed">
                                <label class="form-check-label" for="typeFilterMissed">Missed (Need Reschedule)</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="missedRescheduled" id="typeFilterMissedRescheduled">
                                <label class="form-check-label" for="typeFilterMissedRescheduled">Missed (Rescheduled)</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input type-filter" type="checkbox" value="cancelled" id="typeFilterCancelled">
                                <label class="form-check-label" for="typeFilterCancelled">Cancelled</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="dropdown schedule-filter-dropdown">
                    <button class="btn btn schedule-filter-btn dropdown-toggle" type="button" id="workflowFilterBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-clipboard-check me-1"></i>Workflow Status
                        <span class="badge bg-primary rounded-pill ms-1 d-none" id="workflowFilterCount">0</span>
                    </button>
                    <div class="dropdown-menu schedule-filter-menu p-3" style="min-width: 200px;">
                        <div class="schedule-filter-group">
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input workflow-filter" type="checkbox" value="inProgress" id="workflowFilterInProgress">
                                <label class="form-check-label" for="workflowFilterInProgress">In Progress</label>
                            </div>
                            <div class="form-check schedule-filter-option">
                                <input class="form-check-input workflow-filter" type="checkbox" value="completed" id="workflowFilterCompleted">
                                <label class="form-check-label" for="workflowFilterCompleted">Completed</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="dropdown schedule-filter-dropdown" id="patientFilterDropdown">
                    <button class="btn btn schedule-filter-btn dropdown-toggle" type="button" id="patientFilterBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-person me-1"></i><span id="patientFilterLabel">Patient</span>
                    </button>
                    <div class="dropdown-menu schedule-filter-menu p-3" style="min-width: 300px;">
                        <input type="text" class="form-control form-control-sm mb-2 schedule-filter-search" id="patientFilterSearch" placeholder="Search (min 3 chars)..." autocomplete="off">
                        <div id="patientFilterList" class="schedule-filter-list" style="max-height: 200px; overflow-y: auto;">
                            <div class="text-muted small text-center py-2">Loading patients...</div>
                        </div>
                        <hr class="my-2">
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" id="clearPatientFilter" style="display: none;">
                            <i class="bi bi-x-circle me-1"></i>Clear patient filter
                        </button>
                    </div>
                </div>
                <div class="dropdown schedule-filter-dropdown hide-from-therapist" id="providerFilterDropdown">
                    <button class="btn btn schedule-filter-btn dropdown-toggle" type="button" id="providerFilterBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                        <i class="bi bi-person-badge me-1"></i><span id="providerFilterLabel">Provider</span>
                    </button>
                    <div class="dropdown-menu schedule-filter-menu p-3" style="min-width: 280px;">
                        <input type="text" class="form-control form-control-sm mb-2 schedule-filter-search" id="providerFilterSearch" placeholder="Search provider..." autocomplete="off">
                        <div id="providerFilterList" class="schedule-filter-list" style="max-height: 200px; overflow-y: auto;">
                            <div class="text-muted small text-center py-2">Loading providers...</div>
                        </div>
                        <hr class="my-2">
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" id="clearProviderFilter" style="display: none;">
                            <i class="bi bi-x-circle me-1"></i>Clear provider filter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Calendar legend (appointment-type color codes + workflow status).
         Populated by renderCalendarLegend() from GlobalBridge.js. -->
    <div id="calendarLegend" class="mb-3"></div>

    <!-- Custom Schedule grid — replaces FullCalendar on this page.
         CalendarModule auto-init no-ops because #calendar is absent. -->
    <div class="sg-card">
        <div class="sg-topbar">
            <button type="button" class="sg-today" id="sgToday">Today</button>
            <button type="button" class="sg-nav-btn" id="sgPrev" title="Previous">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button type="button" class="sg-nav-btn" id="sgNext" title="Next">
                <i class="bi bi-chevron-right"></i>
            </button>
            <div class="sg-title" id="sgRangeLabel">—</div>
            <div class="sg-view-toggle" id="sgViewToggle">
                <button type="button" data-view="month">Month</button>
                <button type="button" data-view="week" class="active">Week</button>
                <button type="button" data-view="day">Day</button>
            </div>
        </div>
        <div class="sg-grid" id="scheduleGrid">
            <div class="text-center text-muted py-5">
                <div class="spinner-border spinner-border-sm me-2"></div>Loading schedule...
            </div>
        </div>
    </div>
</div>

@section Scripts {
}
