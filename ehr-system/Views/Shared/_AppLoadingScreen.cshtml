@* Initial App Loading Screen - shown during application initialization *@
<div id="appLoadingScreen" class="app-loading-screen">
    <div class="app-loading-content">
        <div class="app-loading-logo">
            <img src="/medocslogo.png" alt="MEDOCS" class="app-loading-logo-img">
        </div>
        <p class="app-loading-subtitle">Internal Medicine EHR</p>
        <div class="spinner-border text-light mt-4" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="app-loading-status mt-3">Initializing application...</p>
    </div>
</div>
