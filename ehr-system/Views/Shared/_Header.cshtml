@* Application Header - Top navigation bar *@
<header class="main-header">
    <button class="btn btn-link d-lg-none" id="sidebarToggle" aria-label="Toggle sidebar" aria-expanded="false">
        <i class="bi bi-list"></i>
    </button>
    <h4 class="page-title mb-0" id="headerPageTitle">Dashboard</h4>

    <!-- Global Patient Search -->
    <div class="header-patient-search" id="headerPatientSearchContainer">
        <div class="header-search-wrapper">
            <i class="bi bi-search header-search-icon"></i>
            <input type="text" class="form-control header-search-input"
                   id="headerPatientSearchInput"
                   placeholder="Search patients..."
                   autocomplete="off" aria-label="Search patients">
            <kbd class="header-search-shortcut d-none d-lg-inline">Ctrl+K</kbd>
        </div>
        <div class="header-search-results d-none" id="headerPatientSearchResults"></div>
    </div>

    <!-- Super Admin Clinic Filter -->
    <div class="clinic-filter-container requires-super-admin" id="clinicFilterContainer">
        <label class="clinic-filter-label">
            <i class="bi bi-building me-1"></i>Clinic:
        </label>
        <select class="form-select form-select-sm" id="globalClinicFilter">
            <option value="">All Clinics</option>
        </select>
    </div>

    <div class="header-actions">
        <button class="btn btn-primary hide-from-biller" id="quickAddBtn">
            <i class="bi bi-plus-lg me-1"></i>
            <span class="d-none d-md-inline">New Appointment</span>
        </button>
    </div>
</header>
