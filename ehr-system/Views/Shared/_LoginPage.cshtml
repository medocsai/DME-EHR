@* Login Page - Authentication forms *@
<div id="loginPage" class="login-page d-none">
    <div class="login-card">
        <div class="login-header">
            <div class="logo">
                <img src="/medocslogo.png" alt="MEDOCS" class="logo-img">
            </div>
            <p class="text-muted">Internal Medicine EHR</p>
        </div>
        <form id="loginForm">
            <div class="alert alert-danger d-none" id="loginError"></div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" id="loginEmail" required placeholder="you@example.com">
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" id="loginPassword" required placeholder="********">
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="loginRememberDevice">
                <label class="form-check-label text-muted small" for="loginRememberDevice">
                    Remember this device for 15 days (skip verification code next time)
                </label>
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <!-- OTP Verification UI (shown after email+password succeed) -->
        <div id="otpVerification" class="d-none">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock text-primary" style="font-size: 2.5rem;"></i>
                <h5 class="mb-2 mt-2">Verify Your Identity</h5>
                <p class="text-muted small">We sent a 6-digit verification code to</p>
                <p class="mb-0"><strong id="otpMaskedEmail"></strong></p>
            </div>
            <form id="otpForm">
                <div class="alert alert-danger d-none" id="otpError"></div>
                <div class="alert alert-success d-none" id="otpSuccess"></div>
                <div class="mb-3">
                    <label class="form-label">Verification Code</label>
                    <input type="text"
                           class="form-control form-control-lg text-center"
                           id="otpCode"
                           inputmode="numeric"
                           pattern="[0-9]{6}"
                           maxlength="6"
                           required
                           autocomplete="one-time-code"
                           placeholder="000000"
                           style="letter-spacing: 0.5em; font-size: 1.5rem;">
                    <small class="text-muted">Code expires in 5 minutes</small>
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-check-circle me-2"></i>Verify &amp; Sign In
                </button>
            </form>
            <div class="text-center mt-3">
                <button type="button" class="btn btn-link text-muted small" id="otpResendBtn">
                    Didn't receive a code? Resend
                </button>
            </div>
            <div class="text-center mt-1">
                <button type="button" class="btn btn-link text-muted small" id="otpCancelBtn">
                    <i class="bi bi-arrow-left me-1"></i>Back to login
                </button>
            </div>
        </div>

        <!-- Tenant Selection UI (shown when user belongs to multiple clinics) -->
        <div id="tenantSelection" class="d-none">
            <div class="text-center mb-4">
                <p class="mb-1">Welcome back,</p>
                <h5 id="tenantUserName" class="mb-3">User</h5>
                <p class="text-muted">Select the clinic you want to access:</p>
            </div>
            <div id="tenantList" class="tenant-list">
                <!-- Tenant options will be rendered here -->
            </div>
            <div class="mt-4 text-center">
                <button type="button" class="btn btn-link text-muted" onclick="cancelTenantSelection()">
                    <i class="bi bi-arrow-left me-1"></i>Back to login
                </button>
            </div>
        </div>

        <div class="text-center mt-3" id="loginFooterLinks">
            <a href="#" onclick="showForgotPassword(); return false;" class="text-muted small">Forgot Password?</a>
        </div>
        <div class="login-footer">
            <small class="text-muted">HIPAA Compliant - AES-256 Encryption</small>
        </div>
    </div>

    <!-- Forgot Password Form -->
    <div id="forgotPasswordCard" class="login-card d-none">
        <div class="login-header">
            <div class="logo">
                <img src="/medocslogo.png" alt="MEDOCS" class="logo-img">
            </div>
            <h1>Reset Password</h1>
            <p class="text-muted">Enter your email to receive a reset link</p>
        </div>
        <form id="forgotPasswordForm">
            <div class="alert alert-danger d-none" id="forgotPasswordError"></div>
            <div class="alert alert-success d-none" id="forgotPasswordSuccess"></div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" id="forgotPasswordEmail" required placeholder="you@example.com">
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-envelope me-2"></i>Send Reset Link
            </button>
        </form>
        <div class="text-center mt-3">
            <a href="#" onclick="hideForgotPassword(); return false;" class="text-muted small">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>
        <div class="login-footer">
            <small class="text-muted">HIPAA Compliant - AES-256 Encryption</small>
        </div>
    </div>
</div>
