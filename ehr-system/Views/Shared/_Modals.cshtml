<!-- PATIENT PORTAL INVITATION MODAL -->
<!-- ============================================ -->
<div class="modal fade" id="portalInvitationModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-info">
                    <i class="bi bi-envelope-paper me-2"></i>Patient Self-Registration
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Send New Invitation -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-send me-2"></i>Send Registration Link</h6>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">Enter the patient's name and email. A new patient record will be created and a registration link will be sent for them to set up their portal account and complete their profile.</p>
                        <div class="alert alert-danger d-none" id="inviteError"></div>
                        <div class="alert alert-success d-none" id="inviteSuccess"></div>

                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">First Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="inviteFirstName" placeholder="First name" required autocomplete="nope-first">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="inviteLastName" placeholder="Last name" required autocomplete="nope-last">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Email Address <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="inviteEmail" placeholder="patient@@example.com" required autocomplete="nope-email">
                            </div>
                            <div class="col-md-2 d-flex align-items-end">
                                <button type="button" class="btn btn-info text-white w-100" id="btnSendPortalInvite">
                                    <i class="bi bi-send me-1"></i>Send
                                </button>
                            </div>
                        </div>

                        <!-- Portal Link Display -->
                        <div class="mt-3 d-none" id="portalLinkSection">
                            <label class="form-label small text-muted">Portal Link (for this location)</label>
                            <div class="input-group">
                                <input type="text" class="form-control form-control-sm bg-light" id="portalLinkDisplay" readonly>
                                <button class="btn btn-outline-secondary btn-sm" type="button" id="copyPortalLink"
                                        title="Copy to clipboard">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Invitation History -->
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Invitation History</h6>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="refreshInvitationList">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Patient</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Sent</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="invitationListBody">
                                    <tr><td colspan="5" class="text-center text-muted py-3">Loading...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Toast Container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="toast" class="toast" role="alert">
        <div class="toast-header">
            <strong class="me-auto" id="toastTitle">Notification</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body" id="toastMessage"></div>
    </div>
</div>
