@*
    Shared Modals Partial View
    Contains all modal dialogs used throughout the EHR application
*@

<!-- ============================================ -->
<!-- MODALS -->
<!-- ============================================ -->

<!-- Location Switcher Modal -->
<div class="modal fade" id="locationSwitcherModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-geo-alt-fill me-2"></i>Switch Location
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Select the clinic location you want to work in:</p>
                <div class="location-list" id="locationSwitcherList">
                    <div class="text-center text-muted py-3">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2 mb-0">Loading locations...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <a href="#" class="text-primary requires-admin" onclick="openLocationManagementFromSwitcher(); return false;">
                    <i class="bi bi-gear me-1"></i>Manage Locations
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Location Management Modal (Admin) -->
<div class="modal fade" id="locationManagementModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <i class="bi bi-building me-2"></i>Manage Locations
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="mb-0">Clinic Locations</h6>
                    <button class="btn btn-primary btn-sm" onclick="openAddLocationForm()">
                        <i class="bi bi-plus-lg me-1"></i>Add Location
                    </button>
                </div>
                <div class="location-management-list" id="locationManagementList">
                    <!-- Locations will be populated dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Location Modal -->
<div class="modal fade" id="locationFormModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="locationFormTitle">Add Location</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="locationForm">
                <div class="modal-body">
                    <input type="hidden" id="locationFormId">
                    <div class="mb-3">
                        <label class="form-label">Location Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="locationFormName" required autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <input type="text" class="form-control" id="locationFormAddress" autocomplete="off">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" id="locationFormCity" autocomplete="off">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">State</label>
                            <input type="text" class="form-control" id="locationFormState" maxlength="2" autocomplete="off">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">ZIP</label>
                            <input type="text" class="form-control" id="locationFormZip" autocomplete="off">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="tel" class="form-control" id="locationFormPhone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Facility NPI</label>
                            <input type="text" class="form-control" id="locationFormFacilityNpi" maxlength="10" placeholder="10-digit NPI" autocomplete="off">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Place of Service</label>
                            <select class="form-select" id="locationFormPlaceOfService">
                                <option value="11">11: Office</option>
                                <option value="12">12: Home</option>
                                <option value="19">19: Off Campus Outpatient Hospital</option>
                                <option value="21">21: Inpatient Hospital</option>
                                <option value="22">22: On Campus Outpatient Hospital</option>
                                <option value="23">23: Emergency Room, Hospital</option>
                                <option value="24">24: Ambulatory Surgical Center</option>
                                <option value="31">31: Skilled Nursing Facility</option>
                                <option value="32">32: Nursing Facility</option>
                                <option value="49">49: Independent Clinic</option>
                                <option value="50">50: Federally Qualified Health Center</option>
                                <option value="53">53: Community Mental Health Center</option>
                                <option value="65">65: End-Stage Renal Disease Treatment Facility</option>
                                <option value="02">02: Telehealth</option>
                                <option value="10">10: Telehealth in Patient Home</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Timezone <span class="text-danger">*</span></label>
                        <select class="form-select" id="locationFormTimezone" required>
                            <option value="">Loading timezones...</option>
                        </select>
                        <div class="form-text text-muted">
                            All appointment times will be displayed in this timezone for users at this location.
                        </div>
                    </div>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="locationFormPrimary">
                        <label class="form-check-label" for="locationFormPrimary">
                            Set as primary (default) location
                        </label>
                    </div>
                    <hr class="my-3" />
                    <div class="form-check form-switch">
                        <input type="checkbox" class="form-check-input" id="locationFormEnableLongevity">
                        <label class="form-check-label" for="locationFormEnableLongevity">
                            <strong>Enable Longevity for this Location</strong>
                        </label>
                        <div class="form-text text-muted">
                            When enabled, patients filling intake at this location will see the Longevity section. Clinicians will see the longevity data in the patient profile and encounter intake panel.
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="locationFormSubmit">Save Location</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Patient Modal with Tabs -->
<div class="modal fade" id="patientModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Patient</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="patientForm">
                <div class="modal-body">
                    <input type="hidden" name="PatientId" id="patientId">
                    <input type="hidden" name="Status" value="0">

                    <!-- Tab Navigation -->
                    <ul class="nav nav-tabs mb-3" id="patientFormTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="basic-info-tab" data-bs-toggle="tab" data-bs-target="#basic-info" type="button" role="tab">
                                <i class="bi bi-person me-1"></i> Basic Info
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="emergency-contact-tab" data-bs-toggle="tab" data-bs-target="#emergency-contact" type="button" role="tab">
                                <i class="bi bi-telephone me-1"></i> Emergency Contact
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="insurance-tab" data-bs-toggle="tab" data-bs-target="#insurance" type="button" role="tab">
                                <i class="bi bi-shield-check me-1"></i> Insurance
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="attachments-tab" data-bs-toggle="tab" data-bs-target="#attachments" type="button" role="tab">
                                <i class="bi bi-paperclip me-1"></i> Attachments
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="consent-tab" data-bs-toggle="tab" data-bs-target="#consent" type="button" role="tab">
                                <i class="bi bi-file-earmark-check me-1"></i> Consent
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="patientFormTabContent">
                        <!-- Basic Info Tab -->
                        <div class="tab-pane fade show active" id="basic-info" role="tabpanel">
                            <div class="row g-3">
                                <!-- Profile Picture (editable avatar) -->
                                <div class="col-12 text-center" id="patientProfilePictureSection">
                                    <div id="patientEditableAvatarContainer" class="d-inline-block mb-2"></div>
                                </div>
                                <div class="col-12 requires-super-admin">
                                    <label class="form-label">Assign to Clinic *</label>
                                    <select class="form-select" name="TenantId" id="patientTenantSelect">
                                        <option value="">Select a clinic...</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">First Name *</label>
                                    <input type="text" class="form-control" name="FirstName" required autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Last Name *</label>
                                    <input type="text" class="form-control" name="LastName" required autocomplete="off">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Date of Birth *</label>
                                    <input type="date" class="form-control" name="DateOfBirth" required autocomplete="off">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Gender</label>
                                    <select class="form-select" name="Gender">
                                        <option value="">Select...</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">SSN</label>
                                    <input type="text" class="form-control" id="ssnInput" name="Ssn" maxlength="11" placeholder="XXX-XX-XXXX" data-mask="ssn" autocomplete="off">
                                    <div class="invalid-feedback" id="ssnError"></div>
                                </div>
                                <div class="col-md-4 d-none">
                                    <label class="form-label">Date of Injury</label>
                                    <input type="date" class="form-control" name="DateOfInjury" id="patientDateOfInjury" autocomplete="off">
                                    <small class="text-muted">For medical lien or workers' comp cases</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone</label>
                                    <input type="tel" class="form-control" name="Phone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Email</label>
                                    <input type="email" class="form-control" name="Email" placeholder="patient@@email.com" autocomplete="off">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Address</label>
                                    <input type="text" class="form-control" name="Address" placeholder="Street address" autocomplete="off">
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label">City</label>
                                    <input type="text" class="form-control" name="City" autocomplete="off">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">State</label>
                                    <input type="text" class="form-control" name="State" maxlength="2" placeholder="XX" autocomplete="off">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">ZIP</label>
                                    <input type="text" class="form-control" name="ZipCode"
                                           maxlength="5" minlength="5"
                                           inputmode="numeric" pattern="\d{5}"
                                           placeholder="12345"
                                           title="Enter 5 digit ZIP code"
                                           data-digits-only="5"
                                           autocomplete="off">
                                </div>
                            </div>
                        </div>

                        <!-- Emergency Contact Tab -->
                        <div class="tab-pane fade" id="emergency-contact" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle me-2"></i>
                                        Provide emergency contact information for the patient. This will be used in case of emergencies.
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Contact Name</label>
                                    <input type="text" class="form-control" name="EmergencyContactName" placeholder="Full name" autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Relationship</label>
                                    <select class="form-select" name="EmergencyContactRelation">
                                        <option value="">Select...</option>
                                        <option value="Spouse">Spouse</option>
                                        <option value="Parent">Parent</option>
                                        <option value="Child">Child</option>
                                        <option value="Sibling">Sibling</option>
                                        <option value="Friend">Friend</option>
                                        <option value="Other">Other</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Phone</label>
                                    <input type="tel" class="form-control" name="EmergencyContactPhone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Alternate Phone</label>
                                    <input type="tel" class="form-control" name="EmergencyContactAltPhone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                                </div>
                            </div>
                        </div>

                        <!-- Insurance Tab -->
                        <div class="tab-pane fade" id="insurance" role="tabpanel">
                            <!-- Primary Insurance -->
                            <div class="card mb-3" id="insuranceFormSection">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="bi bi-1-circle me-2"></i>Primary Insurance</h6>
                                </div>
                                <div class="card-body">
                                    <input type="hidden" name="PrimaryInsurance.InsuranceId">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Insurance Type</label>
                                            <select class="form-select insurance-category-select" name="PrimaryInsurance.InsuranceCategory">
                                                <option value="">Select Type...</option>
                                                <option value="0">Private Insurance</option>
                                                <option value="1">Workers Compensation</option>
                                                <option value="2">Personal Injury</option>
                                                <option value="3">Self Pay</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4" style="position:relative;">
                                            <label class="form-label">Payer Name</label>
                                            <input type="text" class="form-control" name="PrimaryInsurance.PayerName" id="primaryPayerName" placeholder="Type to search payers..." autocomplete="off">
                                            <div id="primaryPayerResults" class="autocomplete-dropdown d-none"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Payer ID</label>
                                            <input type="text" class="form-control" name="PrimaryInsurance.PayerId" placeholder="Electronic payer ID" autocomplete="off">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Member ID / Policy Number</label>
                                            <input type="text" class="form-control" name="PrimaryInsurance.PolicyNumber" placeholder="Member ID from insurance card" autocomplete="off">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Group Number</label>
                                            <input type="text" class="form-control" name="PrimaryInsurance.GroupNumber" autocomplete="off">
                                        </div>

                                        <div class="col-12"><hr class="my-2"><small class="text-muted">Cost Sharing</small></div>
                                        <div class="col-md-4">
                                            <label class="form-label">Copay ($)</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" class="form-control" name="PrimaryInsurance.Copay" step="0.01" min="0" placeholder="e.g. 40.00" autocomplete="off">
                                            </div>
                                            <small class="text-muted">Fixed amount per visit</small>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Coinsurance (%)</label>
                                            <div class="input-group">
                                                <input type="number" class="form-control" name="PrimaryInsurance.Coinsurance" step="1" min="0" max="100" placeholder="e.g. 20" autocomplete="off">
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <small class="text-muted">% patient pays after deductible</small>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Deductible ($)</label>
                                            <div class="input-group">
                                                <span class="input-group-text">$</span>
                                                <input type="number" class="form-control" name="PrimaryInsurance.DeductibleTotal" step="0.01" min="0" placeholder="e.g. 1500.00" autocomplete="off">
                                            </div>
                                            <small class="text-muted">Annual deductible amount</small>
                                        </div>

                                        <div class="col-12"><hr class="my-2"><small class="text-muted">Subscriber Information</small></div>
                                        <div class="col-md-3">
                                            <label class="form-label">Relationship to Patient</label>
                                            <select class="form-select subscriber-relationship-select" name="PrimaryInsurance.SubscriberRelationship" data-prefix="PrimaryInsurance">
                                                <option value="">Select...</option>
                                                <option value="Self">Self</option>
                                                <option value="Spouse">Spouse</option>
                                                <option value="Child">Child</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Subscriber First Name</label>
                                            <input type="text" class="form-control" name="PrimaryInsurance.SubscriberFirstName" autocomplete="off">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Subscriber Last Name</label>
                                            <input type="text" class="form-control" name="PrimaryInsurance.SubscriberLastName" autocomplete="off">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Subscriber DOB</label>
                                            <input type="date" class="form-control" name="PrimaryInsurance.SubscriberDob" autocomplete="off">
                                        </div>

                                        <div class="col-12"><hr class="my-2"><small class="text-muted">Insurance Verification</small></div>
                                        <div class="col-12 mb-2">
                                            <button type="button" class="btn btn-success" onclick="validatePrimaryInsurance()">
                                                <i class="bi bi-check-circle me-1"></i>Validate Insurance
                                            </button>
                                            <span id="primaryInsuranceValidationStatus" class="ms-2 text-muted"></span>
                                        </div>
                                        <div class="col-12" id="primaryEligibilityResults" style="display:none;"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Secondary Insurance -->
                            <div class="card mb-3" id="secondaryInsuranceFormSection">
                                <div class="card-header bg-secondary text-white">
                                    <h6 class="mb-0"><i class="bi bi-2-circle me-2"></i>Secondary Insurance <small class="opacity-75">(Optional)</small></h6>
                                </div>
                                <div class="card-body">
                                    <input type="hidden" name="SecondaryInsurance.InsuranceId">
                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Insurance Type</label>
                                            <select class="form-select insurance-category-select" name="SecondaryInsurance.InsuranceCategory">
                                                <option value="">Select Type...</option>
                                                <option value="0">Private Insurance</option>
                                                <option value="1">Workers Compensation</option>
                                                <option value="2">Personal Injury</option>
                                                <option value="3">Self Pay</option>
                                            </select>
                                        </div>
                                        <div class="col-md-4" style="position:relative;">
                                            <label class="form-label">Payer Name</label>
                                            <input type="text" class="form-control" name="SecondaryInsurance.PayerName" id="secondaryPayerName" placeholder="Type to search payers..." autocomplete="off">
                                            <div id="secondaryPayerResults" class="autocomplete-dropdown d-none"></div>
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Payer ID</label>
                                            <input type="text" class="form-control" name="SecondaryInsurance.PayerId" placeholder="Electronic payer ID" autocomplete="off">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Member ID / Policy Number</label>
                                            <input type="text" class="form-control" name="SecondaryInsurance.PolicyNumber" placeholder="Member ID from insurance card" autocomplete="off">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Group Number</label>
                                            <input type="text" class="form-control" name="SecondaryInsurance.GroupNumber" autocomplete="off">
                                        </div>

                                        <div class="col-12"><hr class="my-2"><small class="text-muted">Subscriber Information</small></div>
                                        <div class="col-md-3">
                                            <label class="form-label">Relationship to Patient</label>
                                            <select class="form-select subscriber-relationship-select" name="SecondaryInsurance.SubscriberRelationship" data-prefix="SecondaryInsurance">
                                                <option value="">Select...</option>
                                                <option value="Self">Self</option>
                                                <option value="Spouse">Spouse</option>
                                                <option value="Child">Child</option>
                                                <option value="Other">Other</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Subscriber First Name</label>
                                            <input type="text" class="form-control" name="SecondaryInsurance.SubscriberFirstName" autocomplete="off">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Subscriber Last Name</label>
                                            <input type="text" class="form-control" name="SecondaryInsurance.SubscriberLastName" autocomplete="off">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label">Subscriber DOB</label>
                                            <input type="date" class="form-control" name="SecondaryInsurance.SubscriberDob" autocomplete="off">
                                        </div>

                                        <div class="col-12"><hr class="my-2"><small class="text-muted">Insurance Verification</small></div>
                                        <div class="col-12 mb-2">
                                            <button type="button" class="btn btn-success" onclick="validateSecondaryInsurance()">
                                                <i class="bi bi-check-circle me-1"></i>Validate Insurance
                                            </button>
                                            <span id="secondaryInsuranceValidationStatus" class="ms-2 text-muted"></span>
                                        </div>
                                        <div class="col-12" id="secondaryEligibilityResults" style="display:none;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Attachments Tab -->
                        <div class="tab-pane fade" id="attachments" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle me-2"></i>
                                        Upload patient documents such as insurance cards, ID, referrals, or medical records. All files are encrypted at rest for HIPAA compliance.
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Document Category</label>
                                    <select class="form-select" id="documentCategory">
                                        <option value="0">Insurance Card</option>
                                        <option value="1">ID Document</option>
                                        <option value="2">Referral</option>
                                        <option value="3">Medical Record</option>
                                        <option value="5" selected>Other</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Description (Optional)</label>
                                    <input type="text" class="form-control" id="documentDescription" placeholder="Brief description of the document" autocomplete="off">
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Upload Documents</label>
