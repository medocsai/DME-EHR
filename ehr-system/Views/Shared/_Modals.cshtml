<!-- Record Session Modal (Non-dismissible) -->
<div class="modal fade" id="recordSessionModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="recordSessionModalLabel" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content position-relative">
            <!-- Saving Progress Overlay (hidden by default) -->
            <div id="recordingSaveOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none" style="z-index: 1050; background: rgba(255,255,255,0.95); border-radius: inherit;">
                <div class="d-flex flex-column align-items-center justify-content-center h-100">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Saving...</span>
                    </div>
                    <h5 class="text-primary mb-2" id="saveOverlayTitle">Saving Progress...</h5>
                    <p class="text-muted mb-0" id="saveOverlayMessage">Please wait while we save your recording</p>
                </div>
            </div>
            <!-- Header with appointment date/time -->
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="recordSessionModalLabel">
                    <i class="bi bi-mic-fill me-2"></i>Record Session
                </h5>
                <span id="recordSessionDateTime" class="ms-auto me-2 small"></span>
                <button type="button" class="btn btn-sm btn-outline-light border-0" id="recordSessionCloseBtn" aria-label="Close" title="Close">
                    <i class="bi bi-x-lg" id="recordSessionCloseBtnIcon"></i>
                </button>
            </div>

            <div class="modal-body">
                <!-- Error Alert (hidden by default) -->
                <div id="recordSessionError" class="alert alert-danger d-none" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="recordSessionErrorMessage">An error occurred</span>
                    <button type="button" class="btn-close float-end" aria-label="Dismiss error" onclick="hideRecordSessionError()"></button>
                </div>

                <!-- AI Disclaimer -->
                <div class="alert alert-light border py-2 mb-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>AI-generated clinical notes may contain errors. Please review and verify all documentation before signing.
                    </small>
                </div>

                <!-- Appointment & Patient Information -->
                <div class="row mb-4">
                    <!-- Appointment Details -->
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-header bg-light py-2">
                                <i class="bi bi-calendar-event me-1"></i>
                                <strong>Appointment</strong>
                            </div>
                            <div class="card-body py-2">
                                <div class="mb-1">
                                    <small class="text-muted">Date:</small>
                                    <div id="recordSessionApptDate" class="fw-medium">-</div>
                                </div>
                                <div class="mb-1">
                                    <small class="text-muted">Time:</small>
                                    <div id="recordSessionApptTime" class="fw-medium">-</div>
                                </div>
                                <div>
                                    <small class="text-muted">Type:</small>
                                    <div id="recordSessionApptType" class="fw-medium">-</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Patient Information -->
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-header bg-light py-2">
                                <i class="bi bi-person-circle me-1"></i>
                                <strong>Patient</strong>
                            </div>
                            <div class="card-body py-2">
                                <div>
                                    <small class="text-muted">Name:</small>
                                    <div id="recordSessionPatientName" class="fw-medium">-</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Provider Information -->
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-header bg-light py-2">
                                <i class="bi bi-person-badge me-1"></i>
                                <strong>Provider</strong>
                            </div>
                            <div class="card-body py-2">
                                <div>
                                    <small class="text-muted">Name:</small>
                                    <div id="recordSessionProviderName" class="fw-medium">-</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Template Selection (before recording starts) -->
                <div id="recordSessionTemplateSelection" class="mb-4">
                    <div class="card border-primary">
                        <div class="card-header bg-primary bg-opacity-10 py-2">
                            <i class="bi bi-file-earmark-text me-1"></i>
                            <strong>Select Note Templates</strong>
                            <small class="text-muted ms-2">Choose which notes to generate from this recording</small>
                        </div>
                        <div class="card-body py-2">
                            <div id="recordSessionTemplateList">
                                <div class="text-center text-muted py-2">
                                    <div class="spinner-border spinner-border-sm me-1" role="status"></div>
                                    Loading templates...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recording Status and Timer -->
                <div class="text-center mb-4">
                    <!-- Recording Status Indicator -->
                    <div id="recordingStatusIndicator" class="mb-3">
                        <span id="recordingStatusBadge" class="badge fs-6 px-3 py-2 bg-secondary">
                            <i class="bi bi-circle me-1" id="recordingStatusIcon"></i>
                            <span id="recordingStatusText">Not Started</span>
                        </span>
                    </div>

                    <!-- Large Timer Display -->
                    <div class="recording-timer-container p-4 rounded bg-light mb-3">
                        <div id="recordingTimer" class="display-1 font-monospace fw-bold text-dark" aria-live="polite" aria-atomic="true">
                            00:00
                        </div>
                        <small class="text-muted">Elapsed Time</small>
                    </div>

                    <!-- Recording Animation (visible when recording) -->
                    <div id="recordingAnimation" class="d-none mb-3">
                        <div class="recording-pulse-container">
                            <i class="bi bi-mic-fill text-danger fs-1"></i>
                            <div class="recording-pulse"></div>
                        </div>
                    </div>

                    <!-- Recording Warnings (hidden by default) -->
                    <div id="recordingWarnings" class="d-none mb-3">
                        <!-- No audio / silence warning -->
                        <div id="recordingWarningNoAudio" class="alert alert-warning py-2 mb-2 d-none" role="alert">
                            <i class="bi bi-mic-mute-fill me-2"></i>
                            <span id="recordingWarningNoAudioText">No audio detected. Please check your microphone.</span>
                        </div>
                        <!-- Network offline warning -->
                        <div id="recordingWarningOffline" class="alert alert-danger py-2 mb-2 d-none" role="alert">
                            <i class="bi bi-wifi-off me-2"></i>
                            <span>Internet connection lost. Recording continues locally but chunks cannot be uploaded.</span>
                        </div>
                        <!-- Chunk upload failure warning -->
                        <div id="recordingWarningUploadFailed" class="alert alert-danger py-2 mb-0 d-none" role="alert">
                            <i class="bi bi-cloud-slash me-2"></i>
                            <span id="recordingWarningUploadText">Audio chunk upload failed. Check your connection.</span>
                        </div>
                    </div>
                </div>

                <!-- Unfinished Session Alert (shown when resuming) -->
                <div id="unfinishedSessionAlert" class="alert alert-info d-none mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-circle-fill fs-4 me-3"></i>
                        <div class="flex-grow-1">
                            <strong id="unfinishedSessionTitle">Unfinished Recording Found</strong>
                            <p class="mb-0 small" id="unfinishedSessionMessage">
                                You have an unfinished recording session for this appointment.
                                <span id="unfinishedSessionInfo"></span>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Control Buttons -->
                <div class="d-flex justify-content-center gap-3 mb-4" id="recordingControlButtons">
                    <!-- Unfinished Session State: Resume / Retry / Start Over Buttons -->
                    <div id="resumeSessionContainer" class="d-none">
                        <div class="d-flex flex-column align-items-center gap-3">
                            <!-- Resume Recording (for Paused/Recording status) -->
                            <button type="button" class="btn btn-lg btn-success rounded-pill px-5 d-none" id="resumeSessionBtn" aria-label="Resume Recording">
                                <i class="bi bi-play-circle-fill me-2"></i>Resume Recording
                            </button>
                            <!-- Retry Note Generation (for FailedNoteGeneration status) -->
                            <button type="button" class="btn btn-lg btn-primary rounded-pill px-5 d-none" id="retryNoteGenerationBtn" aria-label="Retry Note Generation">
                                <i class="bi bi-arrow-repeat me-2"></i>Retry Note Generation
                            </button>
                            <!-- Retry Processing (for Failed status) -->
                            <button type="button" class="btn btn-lg btn-primary rounded-pill px-5 d-none" id="retryProcessingBtn" aria-label="Retry Processing">
                                <i class="bi bi-arrow-repeat me-2"></i>Retry Processing
                            </button>
                            <button type="button" class="btn btn-outline-secondary" id="startOverBtn" aria-label="Start Over">
                                <i class="bi bi-arrow-counterclockwise me-2"></i>Start Over
                            </button>
                        </div>
                    </div>

                    <!-- Initial State: Start Recording Button -->
                    <div id="startRecordingContainer">
                        <button type="button" class="btn btn-lg btn-danger rounded-pill px-5" id="startRecordingBtn" aria-label="Start Recording">
                            <i class="bi bi-mic-fill me-2"></i>Start Recording
                        </button>
                    </div>

                    <!-- Recording/Paused State: Pause/Resume Button -->
                    <div id="pauseResumeContainer" class="d-none">
                        <button type="button" class="btn btn-lg btn-warning rounded-pill px-4" id="pauseRecordingBtn" aria-label="Pause Recording">
                            <i class="bi bi-pause-fill me-2"></i>Pause
                        </button>
                        <button type="button" class="btn btn-lg btn-success rounded-pill px-4 d-none" id="resumeRecordingBtn" aria-label="Resume Recording">
                            <i class="bi bi-play-fill me-2"></i>Resume
                        </button>
                    </div>
                </div>

                <!-- Help Text -->
                <div class="text-center mt-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        Your recording session is saved automatically. You can pause and resume at any time.
                    </small>
                </div>
            </div>

            <!-- Fixed Footer with Action Buttons (visible after recording starts) -->
            <div id="recordingActionButtons" class="modal-footer d-none justify-content-center gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-danger" id="discardRecordingBtn" onclick="discardRecording()" aria-label="Discard Recording">
                    <i class="bi bi-trash me-2"></i>Discard
                </button>
                <button type="button" class="btn btn-outline-secondary" id="saveProgressBtn" aria-label="Save Progress and Close">
                    <i class="bi bi-save me-2"></i>Save Progress
                </button>
                <button type="button" class="btn btn-primary" id="saveFinishBtn" aria-label="Save and Finish Recording">
                    <i class="bi bi-check-circle me-2"></i>Save & Finish
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Floating Recording Bar (shown during active recording, replaces modal) -->
<div id="floatingRecordingBar" class="floating-recording-bar d-none" role="status" aria-live="polite">
    <div class="floating-recording-bar-inner">
        <!-- Recording indicator -->
        <div class="floating-rec-indicator">
            <span class="floating-rec-dot"></span>
            <span class="floating-rec-label" id="floatingRecLabel">REC</span>
        </div>
        <!-- Patient info -->
        <div class="floating-rec-info">
            <span id="floatingRecPatient" class="floating-rec-patient"></span>
        </div>
        <!-- Timer -->
        <div class="floating-rec-timer" id="floatingRecTimer">00:00</div>
        <!-- Warning indicators (compact) -->
        <div id="floatingRecWarnings" class="floating-rec-warnings d-none">
            <span id="floatingWarningNoAudio" class="badge bg-warning text-dark d-none" title="No audio detected — check microphone">
                <i class="bi bi-mic-mute-fill"></i>
            </span>
            <span id="floatingWarningOffline" class="badge bg-danger d-none" title="No internet connection">
                <i class="bi bi-wifi-off"></i>
            </span>
            <span id="floatingWarningUpload" class="badge bg-danger d-none" title="Chunk upload failed">
                <i class="bi bi-cloud-slash"></i>
            </span>
        </div>
        <!-- Controls -->
        <div class="floating-rec-controls">
            <button type="button" class="btn btn-sm btn-warning rounded-pill" id="floatingPauseBtn" title="Pause">
                <i class="bi bi-pause-fill"></i> Pause
            </button>
            <button type="button" class="btn btn-sm btn-success rounded-pill d-none" id="floatingResumeBtn" title="Resume">
                <i class="bi bi-play-fill"></i> Resume
            </button>
            <button type="button" class="btn btn-sm btn-danger rounded-pill" id="floatingStopBtn" title="Stop Recording">
                <i class="bi bi-stop-fill"></i> Stop
            </button>
        </div>
        <!-- Expand button to reopen full modal -->
        <button type="button" class="btn btn-sm btn-outline-light rounded-pill floating-rec-expand" id="floatingExpandBtn" title="Show full recording panel">
            <i class="bi bi-arrows-angle-expand"></i>
        </button>
    </div>
</div>

<!-- Template Selection Popup (shown when Stop is clicked to choose note types before processing) -->
<div id="templateSelectionOverlay" class="template-selection-overlay d-none">
    <div class="template-selection-popup">
        <div class="template-selection-header">
            <i class="bi bi-file-earmark-text me-2"></i>Select Note Templates
        </div>
        <p class="text-muted mb-3">Choose which notes to generate from this recording.</p>
        <div id="templateSelectionList" class="mb-4">
            <div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm me-1"></div> Loading...</div>
        </div>
        <div id="templateSelectionError" class="text-danger mb-2 d-none"></div>
        <div class="d-flex gap-3 justify-content-end">
            <button type="button" class="btn btn-outline-secondary" id="templateSelectionCancelBtn">
                <i class="bi bi-arrow-left me-1"></i>Resume Recording
            </button>
            <button type="button" class="btn btn-primary" id="templateSelectionConfirmBtn">
                <i class="bi bi-check-circle me-1"></i>Generate Notes
            </button>
        </div>
    </div>
</div>

<!-- Start Over Confirmation Modal -->
<div class="modal fade" id="startOverConfirmModal" tabindex="-1" aria-labelledby="startOverConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="startOverConfirmModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Start Over?
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Are you sure you want to start over? This will:</p>
                <ul class="mb-3">
                    <li>End your current recording session</li>
                    <li>Keep all existing audio chunks for compliance records</li>
                    <li>Start a completely new recording session</li>
                    <li>Reset the timer to 00:00</li>
                </ul>
                <p class="text-muted small mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    Your previous recording data is preserved for HIPAA compliance and audit purposes.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmStartOverBtn">
                    <i class="bi bi-arrow-counterclockwise me-2"></i>Yes, Start Over
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Recording Progress Modal -->
<div class="modal fade" id="recordingProgressModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="recordingProgressModalLabel" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width: 500px;">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <div>
                    <h5 class="modal-title mb-1" id="recordingProgressModalLabel">
                        <i class="bi bi-hourglass-split me-2 text-primary"></i>Processing...
                    </h5>
                    <p class="text-muted mb-0 small" id="progressSubtitle">We're creating your clinical note</p>
                </div>
                <button type="button" class="btn-close" id="closeProgressModalBtn" aria-label="Close" title="Close (processing continues in background)"></button>
            </div>
            <div class="modal-body pt-3">
                <!-- Progress Bar -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Progress</span>
                        <span class="fw-bold" id="progressPercentage">0%</span>
                    </div>
                    <div class="progress" style="height: 12px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                             role="progressbar"
                             id="progressBar"
                             style="width: 0%;"
                             aria-valuenow="0"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                </div>

                <!-- Current Step Message -->
                <div class="text-center mb-3">
                    <p class="mb-1 fs-5" id="progressMessage">Getting started...</p>
                    <p class="text-muted small mb-0" id="progressDetails"></p>
                </div>

                <!-- Step Indicator -->
                <div class="d-flex justify-content-center align-items-center text-muted small">
                    <span id="progressStep">Step 1 of 5</span>
                </div>

                <!-- Notes Counter (shown when generating multiple notes) -->
                <div class="text-center mt-3 d-none" id="notesCounterContainer">
                    <span class="badge bg-info fs-6" id="notesCounter">Clinical Note 1 of 2</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Unavailability Modal -->
<div class="modal fade" id="unavailabilityModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Time Off</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="unavailabilityForm">
                <input type="hidden" name="UnavailabilityId" id="unavailabilityId">
                <div class="modal-body">
                    <div class="mb-3 requires-admin" id="unavailProviderSelectDiv">
                        <label class="form-label">Provider *</label>
                        <select class="form-select" name="ProviderId" id="unavailabilityProviderSelect">
                            <option value="">Select Provider...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Type *</label>
                        <select class="form-select" name="Type" required>
                            <option value="0">Vacation</option>
                            <option value="1">Sick Leave</option>
                            <option value="2">Training</option>
                            <option value="3">Personal Leave</option>
                            <option value="4">Holiday</option>
                            <option value="5">Conference</option>
                            <option value="6">Admin Time</option>
                            <option value="7">Other</option>
                        </select>
                    </div>
                    <!-- Multiple Days checkbox -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="unavailMultipleDays">
                            <label class="form-check-label" for="unavailMultipleDays">Multiple Days</label>
                        </div>
                    </div>
                    <!-- Single Date (shown when Multiple Days is unchecked) -->
                    <div class="mb-3 single-date-field">
                        <label class="form-label">Date *</label>
                        <input type="date" class="form-control" id="unavailSingleDate" required autocomplete="off">
                    </div>
                    <!-- Date Range (shown when Multiple Days is checked) -->
                    <div class="row g-3 date-range-fields d-none">
                        <div class="col-md-6">
                            <label class="form-label">Start Date *</label>
                            <input type="date" class="form-control" name="StartDate" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Date *</label>
                            <input type="date" class="form-control" name="EndDate" autocomplete="off">
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" name="IsFullDay" id="unavailIsFullDay" checked>
                            <label class="form-check-label" for="unavailIsFullDay">Full Day(s)</label>
                        </div>
                    </div>
                    <div class="row g-3 mt-2 partial-day-times d-none">
                        <div class="col-md-6">
                            <label class="form-label">Start Time</label>
                            <input type="time" class="form-control" name="UnavailabilityStartTime" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">End Time</label>
                            <input type="time" class="form-control" name="EndTime" autocomplete="off">
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Reason</label>
                        <textarea class="form-control" name="Reason" rows="2" placeholder="Optional reason..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Patient Detail Modal -->
<div class="modal fade" id="patientDetailModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable pp-redesign">
