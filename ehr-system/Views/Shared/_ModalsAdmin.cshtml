<script>
(function () {
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('changePasswordForm');
        var modalEl = document.getElementById('changePasswordModal');
        if (!form || form.dataset.bound === '1') return;
        form.dataset.bound = '1';

        var errorBox = document.getElementById('changePasswordError');
        var submitBtn = form.querySelector('button[type="submit"]');

        function showError(msg) {
            if (!errorBox) return;
            errorBox.textContent = msg;
            errorBox.classList.remove('d-none');
        }
        function clearError() {
            if (!errorBox) return;
            errorBox.textContent = '';
            errorBox.classList.add('d-none');
        }

        if (modalEl) {
            modalEl.addEventListener('hidden.bs.modal', function () {
                form.reset();
                clearError();
            });
        }

        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            clearError();

            var fd = new FormData(form);
            var currentPassword = fd.get('CurrentPassword') || '';
            var newPassword = fd.get('NewPassword') || '';
            var confirmPassword = fd.get('ConfirmPassword') || '';

            if (newPassword.length < 8) {
                showError('New password must be at least 8 characters.');
                return;
            }
            if (newPassword !== confirmPassword) {
                showError('New password and confirmation do not match.');
                return;
            }
            if (newPassword === currentPassword) {
                showError('New password must be different from current password.');
                return;
            }

            if (submitBtn) { submitBtn.disabled = true; }
            try {
                var payload = { CurrentPassword: currentPassword, NewPassword: newPassword };
                var data;
                if (window.App && window.App.api && typeof window.App.api.post === 'function') {
                    // App.api auto-attaches Bearer token (JWT from localStorage.authToken)
                    data = await window.App.api.post('/auth/change-password', payload, { showErrors: false });
                } else {
                    var token = localStorage.getItem('authToken') || '';
                    var res = await fetch('/api/auth/change-password', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'Authorization': token ? ('Bearer ' + token) : ''
                        },
                        body: JSON.stringify(payload)
                    });
                    data = await res.json().catch(function () { return {}; });
                    if (!res.ok) {
                        showError(data.message || (res.status === 401 ? 'Your session has expired. Please log in again.' : 'Failed to change password.'));
                        return;
                    }
                }
                if (window.Toast && typeof Toast.success === 'function') {
                    Toast.success('Success', (data && data.message) || 'Password changed successfully');
                }
                if (modalEl && window.bootstrap) {
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                }
                form.reset();
            } catch (err) {
                console.error('[ChangePassword] error', err);
                var status = err && (err.status || err.statusCode);
                var serverMsg = err && (err.message || (err.data && err.data.message));
                var msg;
                if (status === 400 || /current password is incorrect/i.test(String(serverMsg))) {
                    msg = 'Current password is incorrect.';
                } else if (status === 401) {
                    msg = 'Your session has expired. Please log in again.';
                } else {
                    msg = serverMsg || 'Failed to change password.';
                }
                showError(msg);
            } finally {
                if (submitBtn) { submitBtn.disabled = false; }
            }
        });
    });
})();
</script>

