@*
    Admin modals: tenant, user, and the password / email actions on a user.

    Rendered by Views/Users/Index.cshtml and Views/Tenants/Index.cshtml, which
    are the only two admin screens MEDOCS DME has.

    Trimmed 2026-08-25 from 15 modals to 6 when the clinical EHR was removed.
    The rest were consent templates, kiosk settings, medical lien templates,
    note templates and billing claims: screens that no longer exist.
*@

<!-- Tenant Modal (Add/Edit Clinic) -->
<div class="modal fade" id="tenantModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Clinic</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="tenantForm">
                <div class="modal-body">
                    <input type="hidden" name="TenantId" id="tenantId">
                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="text-primary mb-3">Clinic Information</h6>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Clinic Name *</label>
                            <input type="text" class="form-control" name="Name" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="tel" class="form-control" name="Phone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="Email" placeholder="clinic@@example.com" autocomplete="off">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" name="Address" placeholder="Street address" autocomplete="off">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" name="City" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">State</label>
                            <input type="text" class="form-control" name="State" maxlength="2" autocomplete="off">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">ZIP</label>
                            <input type="text" class="form-control" name="ZipCode" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tax ID</label>
                            <input type="text" class="form-control" name="TaxId" placeholder="XX-XXXXXXX" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">NPI</label>
                            <input type="text" class="form-control" name="NPI" maxlength="10" placeholder="10-digit NPI" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Plan</label>
                            <select class="form-select" name="Plan">
                                <option value="0">Trial</option>
                                <option value="1">Basic</option>
                                <option value="2" selected>Professional</option>
                                <option value="3">Enterprise</option>
                            </select>
                        </div>
                        <!-- Logo Upload (Edit Mode Only) -->
                        <div class="col-12 edit-clinic-only d-none">
                            <hr>
                            <h6 class="text-primary mb-3"><i class="bi bi-image me-1"></i>Clinic Logo</h6>
                        </div>
                        <div class="col-12 edit-clinic-only d-none">
                            <div class="d-flex align-items-start gap-3">
                                <div id="tenantLogoPreview" class="border rounded d-flex align-items-center justify-content-center bg-light" style="width: 120px; height: 120px; min-width: 120px; overflow: hidden;">
                                    <span class="text-muted small" id="tenantLogoPlaceholder">No Logo</span>
                                    <img id="tenantLogoImg" src="" alt="Clinic Logo" class="d-none" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" class="form-control form-control-sm mb-2" id="tenantLogoFile" accept=".jpg,.jpeg,.png,.webp,.svg">
                                    <small class="text-muted d-block mb-2">Accepted: JPG, PNG, WebP, SVG. Max 2MB.</small>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnUploadTenantLogo" disabled>
                                            <i class="bi bi-upload me-1"></i>Upload
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger d-none" id="btnDeleteTenantLogo">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 new-clinic-admin">
                            <hr>
                            <h6 class="text-primary mb-3"><i class="bi bi-geo-alt me-2"></i>Initial Location</h6>
                        </div>
                        <div class="col-md-6 new-clinic-admin">
                            <label class="form-label">Location Name *</label>
                            <input type="text" class="form-control" name="InitialLocationName" placeholder="e.g., Downtown Clinic, Main Office" required autocomplete="off">
                        </div>
                        <div class="col-md-6 new-clinic-admin">
                            <label class="form-label">Time Zone *</label>
                            <select class="form-select" name="InitialLocationTimeZoneId" id="tenantFormTimezone" required>
                                <option value="">Select timezone...</option>
                            </select>
                        </div>
                        <div class="col-12 new-clinic-admin" id="tenantTimezoneInfo" style="display: none;">
                            <div class="alert alert-info py-2 mb-0">
                                <i class="bi bi-clock me-2"></i>
                                <span id="tenantTimezoneDisplay"></span>
                            </div>
                        </div>
                        <div class="col-12 new-clinic-admin">
                            <small class="text-muted">This will be the default location for this clinic. You can add more locations later.</small>
                        </div>
                        <div class="col-12 new-clinic-admin">
                            <hr>
                            <h6 class="text-primary mb-3">Clinic Administrator</h6>
                        </div>
                        <div class="col-md-6 new-clinic-admin">
                            <label class="form-label">Admin First Name *</label>
                            <input type="text" class="form-control" name="AdminFirstName" required autocomplete="off">
                        </div>
                        <div class="col-md-6 new-clinic-admin">
                            <label class="form-label">Admin Last Name *</label>
                            <input type="text" class="form-control" name="AdminLastName" required autocomplete="off">
                        </div>
                        <div class="col-md-6 new-clinic-admin">
                            <label class="form-label">Admin Email *</label>
                            <input type="email" class="form-control" name="AdminEmail" required autocomplete="off">
                        </div>
                        <div class="col-md-6 new-clinic-admin">
                            <label class="form-label">Admin Password *</label>
                            @* 12, matching Helpers/PasswordPolicy.cs. The field said 8 while the
                               server enforced nothing at all here, so the number in front of the
                               user has to move with the policy or it becomes a lie the moment the
                               server starts checking. *@
                            <input type="password" class="form-control" name="AdminPassword" required minlength="12" maxlength="64" autocomplete="new-password">
                            <small class="text-muted">Minimum 12 characters</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Clinic</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Template Modal (Add/Edit Note Template) -->
<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-key me-2"></i>Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="changePasswordForm" autocomplete="off" onsubmit="return false;">
                <div class="modal-body">
                    <div class="alert alert-info small">
                        <i class="bi bi-info-circle me-1"></i>
                        Password will be updated across all clinics you belong to.
                    </div>
                    <div id="changePasswordError" class="alert alert-danger small d-none"></div>
                    <div class="mb-3">
                        <label class="form-label">Current Password *</label>
                        <input type="password" class="form-control" name="CurrentPassword" required autocomplete="current-password">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Password *</label>
                        <input type="password" class="form-control" name="NewPassword" required minlength="12" maxlength="64" autocomplete="new-password">
                        <small class="text-muted">Minimum 12 characters</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm New Password *</label>
                        <input type="password" class="form-control" name="ConfirmPassword" required minlength="12" maxlength="64" autocomplete="new-password">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Change Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- User Modal (Add/Edit User) -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="userForm">
                <div class="modal-body">
                    <input type="hidden" name="UserId" id="userId">
                    <div class="row g-3">
                        <div class="col-12 requires-super-admin">
                            <label class="form-label">Assign to Clinic *</label>
                            <select class="form-select" name="TenantId" id="userTenantSelect">
                                <option value="">Select a clinic...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">First Name *</label>
                            <input type="text" class="form-control" name="FirstName" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name *</label>
                            <input type="text" class="form-control" name="LastName" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email *</label>
                            <input type="email" class="form-control" name="Email" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="tel" class="form-control" name="Phone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Role *</label>
                            <select class="form-select" name="Role" required id="userRoleSelect">
                                @* Five roles, and no Super Admin: that one belongs to
                                   Medocs and is not something a supplier hands out. *@
                                <option value="1">Admin</option>
                                <option value="2">Intake</option>
                                <option value="3">Delivery</option>
                                <option value="4">Biller</option>
                            </select>
                        </div>
                        <div class="col-md-6 new-user-password">
                            <label class="form-label">Password *</label>
                            <div class="input-group">
                                <input type="password" class="form-control" name="Password" id="newUserPassword" minlength="12" maxlength="64" autocomplete="off">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('newUserPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <small class="text-muted">Minimum 12 characters</small>
                        </div>
                        @*
                            Which branches this user may work in.

                            Hidden for Clinic Admin, who is not scoped and sees every
                            branch of the supplier. Required for everyone else, because a
                            restricted user with no grant sees no customers, orders or
                            claims at all: an account that signs in and does nothing.
                            UsersModule shows and hides it on the role selection.
                        *@
                        <div class="col-12" id="userLocationsBlock">
                            <label class="form-label">Locations *</label>
                            <div id="userLocationsList" class="border rounded p-2" style="max-height:160px;overflow-y:auto">
                                <div class="text-muted small">Loading locations...</div>
                            </div>
                            <small class="text-muted">
                                Which branches this person works in. They see only the customers,
                                orders and stock of the branches ticked here.
                            </small>
                        </div>
                        @* Provider Association is hidden, not deleted.

                           A "provider" is a clinician, which a DME supplier does not
                           employ: the prescriber is somebody else's doctor and lives
                           on /Dme/Doctors. The list behind this picker came from
                           /api/providers, which went with the clinical schema on
                           2026-08-25, so it could only ever have offered an empty
                           dropdown and a badge reading "No Provider".

                           The hidden inputs stay so the JavaScript that reads and
                           writes them keeps working untouched. Removing that code is
                           a separate cleanup; see docs/OPEN-THREADS.md. *@
                        <select name="ProviderId" id="userProviderSelect" hidden>
                            <option value=""></option>
                        </select>
                        <span id="userProviderBadge" hidden></span>
                        <div class="col-md-6">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="userIsActive" checked>
                                <label class="form-check-label" for="userIsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Admin Reset Password Modal -->
<div class="modal fade" id="adminResetPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-key me-2"></i>Reset User Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="adminResetPasswordForm">
                <div class="modal-body">
                    <input type="hidden" name="UserId" id="resetPasswordUserId">
                    <p>Reset password for: <strong id="resetPasswordUserName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">New Password *</label>
                        <input type="password" class="form-control" name="NewPassword" required minlength="12" maxlength="64" autocomplete="off">
                        <small class="text-muted">Minimum 12 characters</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm New Password *</label>
                        <input type="password" class="form-control" name="ConfirmPassword" required minlength="12" maxlength="64" autocomplete="off">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Admin Change Email Modal -->
<div class="modal fade" id="adminChangeEmailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-envelope me-2"></i>Change User Email</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="adminChangeEmailForm">
                <div class="modal-body">
                    <input type="hidden" name="UserId" id="changeEmailUserId">
                    <p>Change email for: <strong id="changeEmailUserName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">Current Email</label>
                        <input type="email" class="form-control" id="currentUserEmail" readonly disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Email *</label>
                        <input type="email" class="form-control" name="NewEmail" required autocomplete="off">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Change Email</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- New Claim Modal -->
<div class="modal fade" id="genericConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" id="genericConfirmHeader">
                <h5 class="modal-title" id="genericConfirmTitle">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="genericConfirmBody">
                <p id="genericConfirmMessage">Are you sure you want to proceed?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="genericConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>
</div>

