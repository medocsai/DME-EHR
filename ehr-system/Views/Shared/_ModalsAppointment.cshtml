@*
    Appointment-related Modals
*@

<!-- Appointment Wizard Modal - Step-by-Step Booking -->
<div class="modal fade" id="appointmentModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary">
                <h5 class="modal-title text-white"><i class="bi bi-calendar-plus me-2 text-white"></i>Schedule Appointment</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="appointmentForm">
                <!-- Hidden fields -->
                <input type="hidden" name="AppointmentId" id="appointmentId">
                <input type="hidden" name="PatientId" id="apptPatientId">
                <input type="hidden" name="RescheduleFromAppointmentId" id="rescheduleFromAppointmentId">
                <input type="hidden" name="AppointmentDate" id="apptDate">
                <input type="hidden" name="StartTime" id="apptStartTime">

                <div class="modal-body p-0">
                    <!-- Step Progress Indicator -->
                    <div class="wizard-progress bg-light border-bottom px-4 py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="wizard-step active" id="wizardStep1Indicator">
                                <div class="step-circle">1</div>
                                <span class="step-label">Patient</span>
                            </div>
                            <div class="wizard-connector"></div>
                            <div class="wizard-step" id="wizardStep2Indicator">
                                <div class="step-circle">2</div>
                                <span class="step-label">Type</span>
                            </div>
                            <div class="wizard-connector"></div>
                            <div class="wizard-step" id="wizardStep3Indicator">
                                <div class="step-circle">3</div>
                                <span class="step-label">Schedule</span>
                            </div>
                            <div class="wizard-connector"></div>
                            <div class="wizard-step" id="wizardStep4Indicator">
                                <div class="step-circle">4</div>
                                <span class="step-label">Review</span>
                            </div>
                        </div>
                    </div>

                    <!-- Selection Summary Header (shown on steps 2+) -->
                    <div class="wizard-summary bg-white border-bottom px-4 py-2 d-none" id="wizardSummaryHeader">
                        <div class="summary-item d-none" id="summaryPatient">
                            <div class="d-flex align-items-center justify-content-between py-1">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-circle text-primary me-2"></i>
                                    <span class="small text-muted me-2">Patient:</span>
                                    <span class="fw-medium" id="summaryPatientName">-</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-link p-0" onclick="wizardGoToStep(1)" title="Edit patient">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            </div>
                        </div>
                        <div class="summary-item d-none" id="summaryType">
                            <div class="d-flex align-items-center justify-content-between py-1 border-top">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-clipboard-pulse text-success me-2"></i>
                                    <span class="small text-muted me-2">Type:</span>
                                    <span class="fw-medium" id="summaryTypeName">-</span>
                                    <span class="badge bg-secondary ms-2" id="summaryDuration">-</span>
                                    <span class="badge bg-info ms-1 d-none" id="summaryRecurringBadge">Recurring</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-link p-0" onclick="wizardGoToStep(2)" title="Edit type">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            </div>
                        </div>
                        <div class="summary-item d-none" id="summarySchedule">
                            <div class="d-flex align-items-center justify-content-between py-1 border-top">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-calendar-check text-warning me-2"></i>
                                    <span class="small text-muted me-2">Schedule:</span>
                                    <span class="fw-medium" id="summaryScheduleInfo">-</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-link p-0" onclick="wizardGoToStep(3)" title="Edit schedule">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Wizard Steps Container -->
                    <div class="wizard-content" style="min-height: 400px;">
                        <!-- STEP 1: Patient Selection -->
                        <div class="wizard-step-content p-4" id="wizardStep1">
                            <h5 class="mb-4"><i class="bi bi-person-fill me-2 text-primary"></i>Select Patient</h5>
                            <div class="patient-autocomplete-container" id="apptPatientContainer">
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text bg-primary text-white"><i class="bi bi-search"></i></span>
                                    <input type="text" class="form-control form-control-lg" id="patientSearchInput" placeholder="Search patient by name, MRN, or phone..." autocomplete="off">
                                </div>
                                <div class="patient-search-results d-none" id="patientSearchResults"></div>
                            </div>
                            <div class="selected-patient-card d-none mt-4" id="selectedPatientDisplay">
                                <div class="card border-success">
                                    <div class="card-body d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <div id="selectedPatientAvatar" class="me-3">
                                                <div class="profile-avatar avatar-md avatar-initials-patient">
                                                    <span class="profile-avatar-initials">?</span>
                                                </div>
                                            </div>
                                            <div>
                                                <h6 class="mb-0" id="selectedPatientName">-</h6>
                                                <small class="text-muted" id="selectedPatientInfo">-</small>
                                            </div>
                                        </div>
                                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="clearWizardPatientSelection()">
                                            <i class="bi bi-x-lg"></i> Change
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4" id="recentPatientsSection">
                                <h6 class="text-muted mb-3"><i class="bi bi-clock-history me-2"></i>Recent Patients</h6>
                                <div class="row g-2" id="recentPatientsList">
                                    <div class="text-muted small">Loading recent patients...</div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 2: Appointment Type Selection -->
                        <div class="wizard-step-content p-4 d-none" id="wizardStep2">
                            <h5 class="mb-4"><i class="bi bi-clipboard-pulse me-2 text-success"></i>Select Appointment Type</h5>
                            <div class="row g-3 mb-4" id="appointmentTypeCards">
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="0" onclick="selectAppointmentType(0)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #E8F5E9; color: #4CAF50;">
                                                <i class="bi bi-person-plus fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">New Patient Visit</h6>
                                            <small class="text-muted">First time visit</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="1" onclick="selectAppointmentType(1)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #E3F2FD; color: #2196F3;">
                                                <i class="bi bi-arrow-repeat fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Follow-Up Visit</h6>
                                            <small class="text-muted">Returning patient</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="2" onclick="selectAppointmentType(2)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #F3E5F5; color: #9C27B0;">
                                                <i class="bi bi-clipboard2-pulse fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Annual Physical</h6>
                                            <small class="text-muted">Yearly exam</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="3" onclick="selectAppointmentType(3)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #FFF3E0; color: #FF9800;">
                                                <i class="bi bi-heart-pulse fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Wellness Exam</h6>
                                            <small class="text-muted">Preventive care</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="4" onclick="selectAppointmentType(4)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #E0F7FA; color: #00BCD4;">
                                                <i class="bi bi-chat-dots fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Consultation</h6>
                                            <small class="text-muted">Specialist consult</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="5" onclick="selectAppointmentType(5)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #ECEFF1; color: #607D8B;">
                                                <i class="bi bi-camera-video fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Telehealth</h6>
                                            <small class="text-muted">Virtual visit</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="6" onclick="selectAppointmentType(6)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #FCE4EC; color: #E91E63;">
                                                <i class="bi bi-bandaid fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Procedure Visit</h6>
                                            <small class="text-muted">In-office procedure</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="7" onclick="selectAppointmentType(7)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #FFEBEE; color: #F44336;">
                                                <i class="bi bi-exclamation-triangle fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Urgent Visit</h6>
                                            <small class="text-muted">Same-day / walk-in</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="8" onclick="selectAppointmentType(8)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #EFEBE9; color: #795548;">
                                                <i class="bi bi-droplet fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Lab Review</h6>
                                            <small class="text-muted">Review lab results</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="9" onclick="selectAppointmentType(9)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #E0F2F1; color: #009688;">
                                                <i class="bi bi-capsule fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Medication Review</h6>
                                            <small class="text-muted">Med management</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="10" onclick="selectAppointmentType(10)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #E0F7F4; color: #14B8A6;">
                                                <i class="bi bi-stars fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">New Longevity Patient</h6>
                                            <small class="text-muted">First longevity consultation</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-lg-4">
                                    <div class="card appt-type-card h-100" data-type="11" onclick="selectAppointmentType(11)">
                                        <div class="card-body text-center py-3">
                                            <div class="type-icon rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 50px; height: 50px; background-color: #FEF3C7; color: #D97706;">
                                                <i class="bi bi-arrow-repeat fs-4"></i>
                                            </div>
                                            <h6 class="mb-1">Follow-Up Longevity Patient</h6>
                                            <small class="text-muted">Continuing longevity care</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-none" id="durationSelectionSection">
                                <h6 class="mb-3"><i class="bi bi-clock me-2"></i>Select Duration</h6>
                                <div class="btn-group w-100" role="group" id="durationButtonGroup">
                                    <input type="radio" class="btn-check" name="wizardDuration" id="dur15" value="15">
                                    <label class="btn btn-outline-primary" for="dur15">15 min</label>
                                    <input type="radio" class="btn-check" name="wizardDuration" id="dur30" value="30">
                                    <label class="btn btn-outline-primary" for="dur30">30 min</label>
                                    <input type="radio" class="btn-check" name="wizardDuration" id="dur45" value="45" checked>
                                    <label class="btn btn-outline-primary" for="dur45">45 min</label>
                                    <input type="radio" class="btn-check" name="wizardDuration" id="dur60" value="60">
                                    <label class="btn btn-outline-primary" for="dur60">60 min</label>
                                    <input type="radio" class="btn-check" name="wizardDuration" id="dur90" value="90">
                                    <label class="btn btn-outline-primary" for="dur90">90 min</label>
                                </div>
                                <select class="d-none" name="Duration" id="apptDuration">
                                    <option value="15">15 minutes</option>
                                    <option value="30">30 minutes</option>
                                    <option value="45" selected>45 minutes</option>
                                    <option value="60">60 minutes</option>
                                    <option value="90">90 minutes</option>
                                </select>
                            </div>
                        </div>

                        <!-- STEP 2b: Single or Recurring Choice -->
                        <div class="wizard-step-content p-4 d-none" id="wizardStep2b">
                            <h5 class="mb-4"><i class="bi bi-calendar3 me-2 text-info"></i>Schedule Type</h5>
                            <p class="text-muted mb-4">How would you like to schedule this follow-up visit?</p>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="card schedule-choice-card" onclick="selectScheduleType('single')">
                                        <div class="card-body d-flex align-items-center p-4">
                                            <div class="choice-icon bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 70px; height: 70px;">
                                                <i class="bi bi-calendar-event fs-2"></i>
                                            </div>
                                            <div>
                                                <h5 class="mb-1">Single Appointment</h5>
                                                <p class="text-muted mb-0">Book one follow-up visit on a specific date and time</p>
                                            </div>
                                            <i class="bi bi-chevron-right ms-auto fs-4 text-muted"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card schedule-choice-card" onclick="selectScheduleType('recurring')">
                                        <div class="card-body d-flex align-items-center p-4">
                                            <div class="choice-icon bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center me-4" style="width: 70px; height: 70px;">
                                                <i class="bi bi-calendar3-week fs-2"></i>
                                            </div>
                                            <div>
                                                <h5 class="mb-1">Recurring Series</h5>
                                                <p class="text-muted mb-0">Set up multiple visits (e.g., 3x/week for 4 weeks)</p>
                                                <span class="badge bg-success-subtle text-success">Recommended for treatment plans</span>
                                            </div>
                                            <i class="bi bi-chevron-right ms-auto fs-4 text-muted"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 3: Slot Selection -->
                        <div class="wizard-step-content d-none" id="wizardStep3">
                            <div class="row g-0" style="min-height: 380px;">
                                <div class="col-md-4 border-end p-4">
                                    <h6 class="mb-3"><i class="bi bi-funnel me-2"></i>Filter Slots</h6>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Provider</label>
                                        <select class="form-select form-select-sm" name="ProviderId" id="apptProviderSelect">
                                            <option value="">All Providers</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Date</label>
                                        <input type="date" class="form-control form-control-sm" id="apptDatePicker" autocomplete="off">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Custom Time <span class="text-muted">(optional)</span></label>
                                        <input type="time" class="form-control form-control-sm" id="apptCustomTime" placeholder="Or select from slots" autocomplete="off">
                                        <div class="text-danger small mt-1 d-none" id="timeConflictAlert">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            <span id="timeConflictMessage"></span>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Notes <span class="text-muted">(optional)</span></label>
                                        <textarea class="form-control form-control-sm" name="Reason" id="apptNotes" rows="2" placeholder="Add notes..."></textarea>
                                    </div>
                                    <input type="hidden" name="Type" id="apptType" value="1">
                                </div>
                                <div class="col-md-8 bg-light">
                                    <div class="p-4 h-100 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <h6 class="mb-0"><i class="bi bi-clock me-2"></i>Available Slots</h6>
                                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="refreshAvailableSlots()" id="refreshSlotsBtn">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        </div>
                                        <div class="mb-2 d-none" id="slotsDateNav">
                                            <div class="d-flex gap-1 overflow-auto pb-2" id="dateTabsContainer"></div>
                                        </div>
                                        <div id="slotsContainer" class="flex-grow-1 overflow-auto" style="max-height: 280px;">
                                            <div id="slotsPlaceholder" class="text-center py-5 d-none">
                                                <i class="bi bi-calendar display-4 text-muted"></i>
                                                <p class="text-muted mt-3 mb-0">Select filters to see slots</p>
                                            </div>
                                            <div id="slotsLoading" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status"></div>
                                                <p class="mt-3 mb-0 small">Loading available slots...</p>
                                            </div>
                                            <div id="slotsEmpty" class="text-center py-5 d-none">
                                                <i class="bi bi-calendar-x display-4 text-muted"></i>
                                                <p class="text-muted mt-3 mb-0">No available slots</p>
                                                <small class="text-muted">Try a different date or provider</small>
                                            </div>
                                            <div id="slotsList" class="d-none"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 3-Recurring: Recurring Pattern Configuration -->
                        <div class="wizard-step-content p-4 d-none" id="wizardStep3Recurring">
                            <h5 class="mb-4"><i class="bi bi-calendar3-week me-2 text-success"></i>Configure Recurring Pattern</h5>
                            <div class="card border-info mb-4" id="careEpisodeGuidancePanel" style="display: none;">
                                <div class="card-header bg-info text-white py-2">
                                    <i class="bi bi-lightbulb me-2"></i>Care Episode Guidance
                                </div>
                                <div class="card-body py-2">
                                    <div class="row align-items-center">
                                        <div class="col-md-3 text-center border-end">
                                            <div class="small text-muted">Visits Needed</div>
                                            <div class="fs-4 fw-bold text-primary" id="ceGuidanceVisitsNeeded">-</div>
                                        </div>
                                        <div class="col-md-3 text-center border-end">
                                            <div class="small text-muted">Recommended/Week</div>
                                            <div class="fs-4 fw-bold text-success" id="ceGuidanceFrequency">-</div>
                                        </div>
                                        <div class="col-md-3 text-center border-end">
                                            <div class="small text-muted">Suggested Duration</div>
                                            <div class="fs-4 fw-bold text-secondary" id="ceGuidanceDuration">-</div>
                                        </div>
                                        <div class="col-md-3 text-center">
                                            <div class="small text-muted">Already Scheduled</div>
                                            <div class="fs-4 fw-bold text-muted" id="ceGuidanceScheduled">-</div>
                                        </div>
                                    </div>
                                    <div class="mt-2 small" id="ceGuidanceMessage">
                                        <i class="bi bi-info-circle me-1"></i>
                                        <span id="ceGuidanceMessageText"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="alert alert-warning mb-3" id="recurringValidationWarning" style="display: none;">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <span id="recurringValidationWarningText"></span>
                                <button type="button" class="btn-close float-end" onclick="document.getElementById('recurringValidationWarning').style.display='none';"></button>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Provider</label>
                                        <select class="form-select" id="recurringProviderSelect" onchange="updateRecurringPreview()">
                                            <option value="auto">Any Available Provider</option>
                                        </select>
                                        <div class="form-text text-muted small" id="providerSelectHint">
                                            <i class="bi bi-magic me-1"></i>System will auto-assign available providers
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Days Per Week</label>
                                        <div class="d-flex flex-wrap gap-1" role="group">
                                            <input type="checkbox" class="btn-check" id="recur_mon" value="1" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-primary btn-sm px-2" for="recur_mon">Mon</label>
                                            <input type="checkbox" class="btn-check" id="recur_tue" value="2" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-primary btn-sm px-2" for="recur_tue">Tue</label>
                                            <input type="checkbox" class="btn-check" id="recur_wed" value="3" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-primary btn-sm px-2" for="recur_wed">Wed</label>
                                            <input type="checkbox" class="btn-check" id="recur_thu" value="4" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-primary btn-sm px-2" for="recur_thu">Thu</label>
                                            <input type="checkbox" class="btn-check" id="recur_fri" value="5" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-primary btn-sm px-2" for="recur_fri">Fri</label>
                                            <input type="checkbox" class="btn-check" id="recur_sat" value="6" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-secondary btn-sm px-2" for="recur_sat">Sat</label>
                                            <input type="checkbox" class="btn-check" id="recur_sun" value="0" onchange="updateRecurringPreview()">
                                            <label class="btn btn-outline-secondary btn-sm px-2" for="recur_sun">Sun</label>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Duration</label>
                                        <div class="input-group" style="max-width: 200px;">
                                            <input type="number" class="form-control" id="recurrenceDurationWeeks" value="4" min="1" max="52" onchange="updateRecurringPreview()" autocomplete="off">
                                            <span class="input-group-text">weeks</span>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Preferred Time</label>
                                        <input type="time" class="form-control" id="recurringPreferredTime" value="09:00" onchange="updateRecurringPreview()" autocomplete="off">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Notes <span class="text-muted">(optional)</span></label>
                                        <textarea class="form-control form-control-sm" id="recurringNotes" rows="2" placeholder="Add notes for all appointments..."></textarea>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card border-primary h-100">
                                        <div class="card-header bg-primary text-white py-2">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span><i class="bi bi-calendar-check me-2"></i>Appointments Preview</span>
                                                <span class="badge bg-light text-primary" id="recurPreviewTotal">0 total</span>
                                            </div>
                                        </div>
                                        <div class="card-body p-0">
                                            <div id="recurringCheckLoading" class="text-center py-4" style="display: none;">
                                                <div class="spinner-border spinner-border-sm text-primary"></div>
                                                <span class="ms-2 small">Checking availability...</span>
                                            </div>
                                            <div id="recurringDateList" class="small" style="max-height: 250px; overflow-y: auto;">
                                                <div class="text-muted text-center py-4">
                                                    <i class="bi bi-info-circle me-1"></i>Select days to see appointments
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer bg-white py-2" id="recurringAvailabilityStatus" style="display: none;">
                                            <div class="d-flex justify-content-between small">
                                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i><span id="recurAvailableCount">0</span> available</span>
                                                <span class="text-danger"><i class="bi bi-x-circle-fill me-1"></i><span id="recurConflictCount">0</span> conflicts</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 4: Review Before Save -->
                        <div class="wizard-step-content p-4 d-none" id="wizardStep4">
                            <h5 class="mb-4"><i class="bi bi-eye me-2 text-primary"></i>Review Before Saving</h5>
                            <div class="card border-success">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Patient</small>
                                                <span class="fs-5 fw-bold" id="confirmPatient">-</span>
                                            </div>
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Appointment Type</small>
                                                <span class="fw-medium" id="confirmType">-</span>
                                            </div>
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Duration</small>
                                                <span class="fw-medium" id="confirmDuration">-</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Date & Time</small>
                                                <span class="fs-5 fw-bold text-primary" id="confirmDateTime">-</span>
                                            </div>
                                            <div class="mb-3">
                                                <small class="text-muted d-block">Provider</small>
                                                <span class="fw-medium" id="confirmProvider">-</span>
                                            </div>
                                            <div class="mb-3" id="confirmNotesSection">
                                                <small class="text-muted d-block">Notes</small>
                                                <span class="fw-medium" id="confirmNotes">-</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="border-top pt-3 mt-3 d-none" id="confirmRecurringSummary">
                                        <div class="d-flex align-items-center mb-2">
                                            <i class="bi bi-calendar3-week text-success me-2 fs-5"></i>
                                            <span class="fw-bold">Recurring Series</span>
                                        </div>
                                        <div class="bg-success-subtle rounded p-3">
                                            <div class="row">
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Pattern</small>
                                                    <span class="fw-medium" id="confirmRecurringPattern">-</span>
                                                </div>
                                                <div class="col-6">
                                                    <small class="text-muted d-block">Total Appointments</small>
                                                    <span class="fw-bold fs-4 text-success" id="confirmRecurringCount">-</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <h6 class="mb-3"><i class="bi bi-bell me-2"></i>Patient Reminders</h6>
                                <div class="d-flex gap-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="reminder24h" checked>
                                        <label class="form-check-label" for="reminder24h">24 hours before</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="reminder1h" checked>
                                        <label class="form-check-label" for="reminder1h">1 hour before</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer with Navigation -->
                <div class="modal-footer">
                    <div class="d-flex justify-content-between w-100">
                        <button type="button" class="btn btn-outline-secondary" id="wizardBackBtn" onclick="wizardPrevStep()" style="display: none;">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </button>
                        <div class="ms-auto d-flex gap-2">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-primary" id="wizardNextBtn" onclick="wizardNextStep()" disabled>
                                Next<i class="bi bi-arrow-right ms-1"></i>
                            </button>
                            <button type="submit" class="btn btn-success d-none" id="apptSaveBtn">
                                <i class="bi bi-check-lg me-1"></i><span id="saveButtonText">Save Appointment</span>
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

