@*
    Dashboard-related Modals
*@

<!-- Dashboard: Missing Notes Modal -->
<div class="modal fade" id="missingNotesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-orange text-white py-2">
                <h6 class="modal-title"><i class="bi bi-file-earmark-x me-2"></i>Missing Notes</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="missingNotesModalBody">
                <div class="text-center text-muted py-4">Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard: Missing Signature Modal -->
<div class="modal fade" id="missingSignatureModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-purple text-white py-2">
                <h6 class="modal-title"><i class="bi bi-pen me-2"></i>Missing Signature</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="missingSignatureModalBody">
                <div class="text-center text-muted py-4">Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard: Overdue Follow-ups Modal -->
<div class="modal fade" id="requireScheduleModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white py-2">
                <h6 class="modal-title"><i class="bi bi-clock-history me-2"></i>Overdue Follow-ups</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="requireScheduleModalBody">
                <div class="text-center text-muted py-4">Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard: No Show Modal -->
<div class="modal fade" id="noShowModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title"><i class="bi bi-person-x me-2"></i>No Show Alerts</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="noShowModalBody">
                <div class="text-center text-muted py-4">Loading...</div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard: Patient Sticky Notes Modal -->
<div class="modal fade" id="patientStickyNotesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title"><i class="bi bi-sticky-fill me-2"></i>Sticky Notes — <span id="stickyNotesPatientName"></span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" id="patientStickyNotesModalBody">
                <div class="input-group mb-3">
                    <input type="text" class="form-control" id="dashboardStickyNoteInput" placeholder="Add a sticky note..." maxlength="1000">
                    <button class="btn btn-warning" type="button" id="btnAddDashboardStickyNote" title="Add Note">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div id="dashboardStickyNotesList">
                    <div class="text-center text-muted py-3">Loading...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard: Missed Appointments Modal -->
<div class="modal fade" id="missedAppointmentsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white py-2">
                <h6 class="modal-title"><i class="bi bi-calendar-x me-2"></i>Missed Appointments</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-2" id="missedAppointmentsModalBody">
                <div class="text-center text-muted py-4">Loading...</div>
            </div>
        </div>
    </div>
</div>
