@*
    History Review action modal (reusable).
    Used for state-change AND delete actions across all 7 History Review sections:
    Allergies, Medications, Problems, Family History, Social History, Immunization, Supplements.

    Spec: rules/technical/history-review-soft-delete.md (section 7).
    Driver: ~/js/shared/ui/HistoryActionModal.js
*@

<!-- History Review Action Modal -->
<div class="modal fade" id="historyActionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary">
                    <i id="historyActionModalIcon" class="bi bi-pencil-square text-primary me-2"></i>
                    <span id="historyActionModalTitle">Confirm Action</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="historyActionModalDescription" class="mb-3"></p>

                <div class="alert alert-light border mb-3" id="historyActionModalRecordWrap">
                    <div class="small text-muted mb-1">Record</div>
                    <div class="fw-semibold" id="historyActionModalRecordLabel"></div>
                </div>

                <div class="mb-3">
                    <label for="historyActionReason" class="form-label fw-semibold">
                        Reason <span class="text-danger">*</span>
                    </label>
                    <select id="historyActionReason" class="form-select">
                        <option value="">Select a reason...</option>
                    </select>
                </div>

                <div class="mb-3" id="historyActionReasonOtherWrap" style="display:none;">
                    <label for="historyActionReasonOther" class="form-label fw-semibold">
                        Specify <span class="text-danger">*</span>
                    </label>
                    <textarea id="historyActionReasonOther" class="form-control" rows="2" maxlength="500" placeholder="Enter reason..."></textarea>
                    <div class="form-text">Up to 500 characters.</div>
                </div>

                <div id="historyActionModalError" class="alert alert-danger d-none" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="historyActionConfirmBtn">
                    <span class="spinner-border spinner-border-sm me-1 d-none" id="historyActionConfirmSpinner" role="status"></span>
                    <span id="historyActionConfirmLabel">Confirm</span>
                </button>
            </div>
        </div>
    </div>
</div>
