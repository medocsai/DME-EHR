@*
    Internal Messaging System - Modals and UI Components

    Includes:
    - Main messaging panel (slide-out)
    - Conversation list
    - Chat window
    - New conversation modal
    - Voice recording UI
*@

<!-- Messaging Panel (Slide-out) -->
<div id="messagingPanel" class="messaging-panel">
    <!-- Header -->
    <div class="messaging-header">
        <div class="d-flex align-items-center justify-content-between">
            <h6 class="mb-0">
                <i class="bi bi-chat-dots-fill me-2"></i>Messages
            </h6>
            <div>
                <button type="button" class="btn btn-sm btn-outline-primary me-1" id="newConversationBtn" title="New conversation">
                    <i class="bi bi-plus-lg"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="closeChatBtn" title="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Conversations List View -->
    <div id="conversationsListView" class="messaging-body">
        <!-- Search -->
        <div class="conversation-search">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-transparent border-end-0">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text"
                       id="conversationSearchInput"
                       class="form-control border-start-0"
                       placeholder="Search conversations..."
                       autocomplete="off">
            </div>
        </div>

        <!-- Conversations List -->
        <div id="conversationsList" class="conversations-list">
            <!-- Dynamically populated -->
        </div>
    </div>

    <!-- Chat Window View (hidden by default) -->
    <div id="chatWindowView" class="chat-window" style="display: none;">
        <!-- Chat Header -->
        <div class="chat-header">
            <button type="button" class="btn btn-sm btn-link text-dark me-2" id="backToConversationsBtn">
                <i class="bi bi-chevron-left"></i>
            </button>
            <div class="chat-user-info flex-grow-1">
                <div class="chat-user-name" id="chatUserName">User Name</div>
                <div class="chat-user-status" id="chatUserStatus">
                    <span class="status-offline">Offline</span>
                </div>
            </div>
        </div>

        <!-- Messages Container -->
        <div id="messagesContainer" class="messages-container">
            <!-- Dynamically populated -->
        </div>

        <!-- Typing Indicator -->
        <div id="typingIndicator" class="typing-indicator" style="display: none;">
            <em>User is typing...</em>
        </div>

        <!-- Message Input Area - Normal Mode -->
        <div id="normalInputArea" class="message-input-area">
            <div class="input-group">
                <button type="button" class="btn btn-light" id="attachFileBtn" title="Attach file">
                    <i class="bi bi-paperclip"></i>
                </button>
                <textarea id="messageInput"
                          class="form-control"
                          placeholder="Type a message..."
                          rows="1"
                          autocomplete="off"></textarea>
                <button type="button" class="btn btn-light" id="voiceNoteBtn" title="Click to start recording">
                    <i class="bi bi-mic-fill"></i>
                </button>
                <button type="button" class="btn btn-primary" id="sendMessageBtn" title="Send">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
            <input type="file"
                   id="messageFileInput"
                   style="display: none;"
                   accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,.gif,.txt">
        </div>

        <!-- Message Input Area - Recording Mode -->
        <div id="recordingInputArea" class="message-input-area recording-mode" style="display: none;">
            <div class="recording-controls">
                <button type="button" class="btn btn-outline-danger btn-cancel-recording" id="cancelRecordingBtn" title="Cancel recording">
                    <i class="bi bi-trash-fill"></i>
                </button>
                <div class="recording-status">
                    <div class="recording-pulse-indicator"></div>
                    <span id="voiceNoteTimer" class="recording-time">0:00</span>
                    <span class="recording-label">Recording...</span>
                </div>
                <button type="button" class="btn btn-success btn-send-recording" id="sendRecordingBtn" title="Send voice note">
                    <i class="bi bi-send-fill"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- New Conversation Modal -->
<div class="modal fade" id="newConversationModal" tabindex="-1" aria-labelledby="newConversationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="newConversationModalLabel">
                    <i class="bi bi-person-plus-fill me-2"></i>New Conversation
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <!-- Search -->
                <div class="p-3 border-bottom">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="newConversationSearchInput"
                               class="form-control border-start-0"
                               placeholder="Search users..."
                               autocomplete="off">
                    </div>
                </div>

                <!-- Users List -->
                <div id="newConversationUsersList" class="list-group list-group-flush">
                    <!-- Dynamically populated -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chat Toggle Button (Fixed position) -->
<button type="button"
        id="chatToggleBtn"
        class="chat-toggle-btn"
        title="Messages">
    <i class="bi bi-chat-dots-fill"></i>
    <span id="messagingUnreadBadge" class="unread-badge" style="display: none;">0</span>
</button>
