<!-- New / View Prescription Modal -->
<div class="modal fade" id="prescriptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="prescriptionModalTitle">
                    <i class="bi bi-capsule me-2"></i>New Prescription
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="prescriptionForm">
                    <input type="hidden" id="rxPrescriptionId" />

                    <!-- Row 1: Patient + Provider -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Patient <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="rxPatientSearch" placeholder="Search patient by name or MRN..." autocomplete="off">
                                <input type="hidden" id="rxPatientId" />
                                <div class="dropdown-menu w-100" id="rxPatientDropdown"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Prescribing Provider <span class="text-danger">*</span></label>
                            <select class="form-select" id="rxProviderId">
                                <option value="">Select Provider</option>
                            </select>
                        </div>
                    </div>

                    <!-- Row 2: Drug Search + AI Suggest -->
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Drug <span class="text-danger">*</span></label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="rxDrugSearch" placeholder="Search drug by brand or generic name..." autocomplete="off">
                                <div class="dropdown-menu w-100" id="rxDrugDropdown"></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Strength</label>
                            <input type="text" class="form-control" id="rxStrength">
                        </div>
                    </div>
                    <div class="mb-3">
                        <button type="button" class="btn btn-sm btn-outline-info" id="btnSuggestDrugs">
                            <i class="bi bi-stars me-1"></i>Suggest Drugs from CC & HPI
                        </button>
                        <div id="rxDrugSuggestions" class="list-group mt-2" style="max-height:300px; overflow-y:auto; display:none;"></div>
                    </div>

                    <!-- Hidden drug fields populated by autocomplete -->
                    <input type="hidden" id="rxDrugName" />
                    <input type="hidden" id="rxGenericName" />
                    <input type="hidden" id="rxNDCCode" />
                    <input type="hidden" id="rxDosageForm" />
                    <input type="hidden" id="rxRouteHidden" />
                    <input type="hidden" id="rxDEASchedule" />
                    <input type="hidden" id="rxIsControlled" />

                    <!-- Row 3: SIG Builder -->
                    <div class="card bg-light mb-3">
                        <div class="card-header py-2">
                            <strong><i class="bi bi-pencil-square me-1"></i>SIG (Directions)</strong>
                        </div>
                        <div class="card-body py-2">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-2">
                                    <label class="form-label small">Dose Amount</label>
                                    <input type="text" class="form-control form-control-sm" id="rxDoseAmount" placeholder="1" value="1">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Dose Unit</label>
                                    <select class="form-select form-select-sm" id="rxDoseUnit">
                                        <option value="tablet">tablet</option>
                                        <option value="capsule">capsule</option>
                                        <option value="ml">ml</option>
                                        <option value="puff">puff</option>
                                        <option value="drop">drop</option>
                                        <option value="spray">spray</option>
                                        <option value="patch">patch</option>
                                        <option value="unit">unit</option>
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">Route</label>
                                    <select class="form-select form-select-sm" id="rxRoute">
                                        <option value="0">Oral</option>
                                        <option value="1">Topical</option>
                                        <option value="2">Subcutaneous</option>
                                        <option value="3">Intramuscular</option>
                                        <option value="4">Intravenous</option>
                                        <option value="5">Rectal</option>
                                        <option value="6">Ophthalmic</option>
                                        <option value="7">Otic</option>
                                        <option value="8">Nasal</option>
                                        <option value="9">Transdermal</option>
                                        <option value="10">Inhalation</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">Frequency</label>
                                    <select class="form-select form-select-sm" id="rxFrequency">
                                        <option value="0">Once daily</option>
                                        <option value="1">Twice daily (BID)</option>
                                        <option value="2">Three times daily (TID)</option>
                                        <option value="3">Four times daily (QID)</option>
                                        <option value="4">At bedtime (QHS)</option>
                                        <option value="5">Every 4 hours</option>
                                        <option value="6">Every 6 hours</option>
                                        <option value="7">Every 8 hours</option>
                                        <option value="8">Every 12 hours</option>
                                        <option value="9">As needed (PRN)</option>
                                        <option value="10">Weekly</option>
                                        <option value="11">Every 2 weeks</option>
                                        <option value="12">Monthly</option>
                                        <option value="99">As directed</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary w-100" id="btnBuildSIG">
                                        <i class="bi bi-arrow-down-circle me-1"></i>Build SIG
                                    </button>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-12">
                                    <label class="form-label small">Full Directions (editable)</label>
                                    <input type="text" class="form-control form-control-sm" id="rxDirections" placeholder="e.g. Take 1 tablet by mouth once daily">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: Quantity, Days Supply, Refills, DAW -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Quantity <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="rxQuantity" min="1" value="30">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Days Supply <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="rxDaysSupply" min="1" value="30">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Refills</label>
                            <input type="number" class="form-control" id="rxRefills" min="0" max="12" value="0">
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="rxDAW">
                                <label class="form-check-label" for="rxDAW">
                                    DAW (Dispense As Written)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Row 5: Pharmacy Search -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Pharmacy</label>
                            <div class="position-relative">
                                <input type="text" class="form-control" id="rxPharmacySearch" placeholder="Search pharmacy by name or city..." autocomplete="nope" data-lpignore="true" data-form-type="other">
                                <input type="hidden" id="rxPharmacyId" />
                                <div class="dropdown-menu w-100" id="rxPharmacyDropdown"></div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Phone</label>
                            <input type="text" class="form-control" id="rxPharmacyPhone" autocomplete="nope" data-lpignore="true" data-form-type="other">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" id="rxPharmacyAddress" autocomplete="nope" data-lpignore="true" data-form-type="other">
                        </div>
                    </div>

                    <!-- Row 6: Notes -->
                    <div class="row mb-3">
                        <input type="hidden" id="rxDiagnosisCode" />
                        <div class="col-md-12">
                            <label class="form-label">Notes</label>
                            <input type="text" class="form-control" id="rxNotes" placeholder="Optional notes...">
                        </div>
                    </div>

                    <!-- Warnings display area -->
                    <div id="rxWarningsArea" class="alert alert-warning d-none mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>Drug Warnings:</strong>
                        <span id="rxWarningsText"></span>
                    </div>

                    <!-- Controlled substance notice -->
                    <div id="rxControlledArea" class="alert alert-danger d-none mb-3">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        <strong>Controlled Substance</strong> — DEA Schedule <span id="rxScheduleText"></span>.
                        Additional documentation may be required.
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-outline-primary" id="btnSaveDraft">
                    <i class="bi bi-save me-1"></i>Save Draft
                </button>
                <button type="button" class="btn btn-primary" id="btnSignAndSend">
                    <i class="bi bi-send-check me-1"></i>Sign & Send
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Prescription Confirm Action Modal -->
<div class="modal fade" id="rxConfirmModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2" id="rxConfirmHeader">
                <h6 class="modal-title" id="rxConfirmTitle">Confirm</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="rxConfirmMessage"></p>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" class="btn btn-sm" id="rxConfirmBtn">Yes</button>
            </div>
        </div>
    </div>
</div>

<!-- Prescription Detail/View Modal -->
<div class="modal fade" id="prescriptionViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-capsule me-2"></i>Prescription Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="prescriptionViewBody">
                <!-- Filled dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
