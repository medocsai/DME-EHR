@*
    Provider-related Modals
*@

<!-- Provider Modal (Add/Edit) -->
<div class="modal fade" id="providerModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Provider</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="providerForm">
                <div class="modal-body">
                    <input type="hidden" name="ProviderId" id="providerId">
                    <div class="row g-3">
                        <!-- Profile Picture (editable avatar) -->
                        <div class="col-12 text-center" id="providerProfilePictureSection">
                            <div id="providerEditableAvatarContainer" class="d-inline-block mb-2"></div>
                        </div>
                        <div class="col-12 requires-super-admin">
                            <label class="form-label">Assign to Clinic *</label>
                            <select class="form-select" name="TenantId" id="providerTenantSelect">
                                <option value="">Select a clinic...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">First Name *</label>
                            <input type="text" class="form-control" name="FirstName" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Last Name *</label>
                            <input type="text" class="form-control" name="LastName" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">NPI *</label>
                            <input type="text" class="form-control" name="Npi" required maxlength="10" placeholder="10-digit NPI" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Credentials</label>
                            <select class="form-select" name="Credentials" id="providerCredentials">
                                <option value="">Select Credentials...</option>
                                <option value="MD">MD - Doctor of Medicine</option>
                                <option value="DO">DO - Doctor of Osteopathic Medicine</option>
                                <option value="MD, FACP">MD, FACP - Fellow, American College of Physicians</option>
                                <option value="MD, FAAFP">MD, FAAFP - Fellow, American Academy of Family Physicians</option>
                                <option value="NP">NP - Nurse Practitioner</option>
                                <option value="PA">PA - Physician Assistant</option>
                                <option value="PA-C">PA-C - Physician Assistant, Certified</option>
                                <option value="DNP">DNP - Doctor of Nursing Practice</option>
                                <option value="APRN">APRN - Advanced Practice Registered Nurse</option>
                                <option value="RN">RN - Registered Nurse</option>
                                <option value="MA">MA - Medical Assistant</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Specialty</label>
                            <select class="form-select" name="Specialty" id="providerSpecialty">
                                <option value="">Select Specialty...</option>
                                <option value="Internal Medicine">Internal Medicine</option>
                                <option value="Family Medicine">Family Medicine</option>
                                <option value="General Practice">General Practice</option>
                                <option value="Cardiology">Cardiology</option>
                                <option value="Endocrinology">Endocrinology</option>
                                <option value="Gastroenterology">Gastroenterology</option>
                                <option value="Pulmonology">Pulmonology</option>
                                <option value="Nephrology">Nephrology</option>
                                <option value="Rheumatology">Rheumatology</option>
                                <option value="Infectious Disease">Infectious Disease</option>
                                <option value="Geriatric Medicine">Geriatric Medicine</option>
                                <option value="Preventive Medicine">Preventive Medicine</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Taxonomy</label>
                            <input type="text" class="form-control" name="Taxonomy" placeholder="207R00000X" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="Email" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input type="tel" class="form-control" name="Phone" placeholder="(555) 555-5555" data-mask="phone" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">License Number</label>
                            <input type="text" class="form-control" name="LicenseNumber" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">License State</label>
                            <input type="text" class="form-control" name="LicenseState" maxlength="2" placeholder="TX" autocomplete="off">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">License Expiry</label>
                            <input type="date" class="form-control" name="LicenseExpiry" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Default Appointment Duration (min)</label>
                            <input type="number" class="form-control" name="DefaultAppointmentDuration" value="30" min="15" max="120" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Profile Color</label>
                            <input type="color" class="form-control form-control-color" name="Color" value="#2196F3">
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" name="IsActive" id="providerIsActive" checked>
                                <label class="form-check-label" for="providerIsActive">Active</label>
                            </div>
                        </div>

                        <!-- Work Schedule Section -->
                        <div class="col-12 mt-3">
                            <hr>
                            <h6><i class="bi bi-calendar-week me-2"></i>Work Schedule (Duty Hours)</h6>
                            <small class="text-muted d-block mb-3">Set the provider's working hours for each day. Available slots will be generated based on this schedule.</small>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered" id="providerScheduleTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 140px;">Day</th>
                                            <th style="width: 80px;">Available</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr data-day="1">
                                            <td><strong>Monday</strong></td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="1" checked></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="1" value="08:00"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="1" value="17:00"></td>
                                        </tr>
                                        <tr data-day="2">
                                            <td><strong>Tuesday</strong></td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="2" checked></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="2" value="08:00"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="2" value="17:00"></td>
                                        </tr>
                                        <tr data-day="3">
                                            <td><strong>Wednesday</strong></td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="3" checked></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="3" value="08:00"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="3" value="17:00"></td>
                                        </tr>
                                        <tr data-day="4">
                                            <td><strong>Thursday</strong></td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="4" checked></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="4" value="08:00"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="4" value="17:00"></td>
                                        </tr>
                                        <tr data-day="5">
                                            <td><strong>Friday</strong></td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="5" checked></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="5" value="08:00"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="5" value="17:00"></td>
                                        </tr>
                                        <tr data-day="6" class="table-secondary">
                                            <td>Saturday</td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="6"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="6" value="08:00" disabled></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="6" value="12:00" disabled></td>
                                        </tr>
                                        <tr data-day="0" class="table-secondary">
                                            <td>Sunday</td>
                                            <td class="text-center"><input type="checkbox" class="form-check-input schedule-available" data-day="0"></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-start" data-day="0" value="08:00" disabled></td>
                                            <td><input type="time" class="form-control form-control-sm schedule-end" data-day="0" value="12:00" disabled></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Provider Signature Section -->
                        <div class="col-12 provider-signature-section mt-3">
                            <hr>
                            <h6><i class="bi bi-pen me-2"></i>Provider Signature</h6>
                            <small class="text-muted d-block mb-3">Upload a signature image (JPG or PNG) that will be used when signing clinical notes with the <code>{{provider_signature}}</code> placeholder.</small>
                            <div class="row">
                                <div class="col-md-6">
                                    <div id="signaturePreviewContainer" class="border rounded p-3 text-center bg-light mb-2" style="min-height: 100px;">
                                        <div id="signaturePreview" style="display: none;">
                                            <img id="signatureImage" src="" alt="Provider Signature" style="max-height: 80px; max-width: 100%;">
                                        </div>
                                        <div id="noSignatureMessage">
                                            <i class="bi bi-image text-muted" style="font-size: 2rem;"></i>
                                            <p class="text-muted mb-0 mt-2">No signature uploaded</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-2">
                                        <label class="form-label">Upload Signature Image</label>
                                        <input type="file" class="form-control" id="signatureFileInput" accept=".jpg,.jpeg,.png,image/jpeg,image/png">
                                        <small class="text-muted">Max 2MB. JPG or PNG format.</small>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-outline-danger btn-sm" id="deleteSignatureBtn" style="display: none;">
                                            <i class="bi bi-trash me-1"></i>Delete
                                        </button>
                                    </div>
                                    <div id="signatureUploadProgress" class="progress mt-2" style="display: none; height: 5px;">
                                        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                    </div>
                                    <small id="signaturePendingMessage" class="text-info d-none">
                                        <i class="bi bi-info-circle me-1"></i>Signature will be uploaded when you save the provider.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- User Account Section for NEW Provider -->
                        <div class="col-12 new-provider-user">
                            <hr>
                            <h6><i class="bi bi-person-badge me-2"></i>User Account (Auto-Created)</h6>
                            <small class="text-muted d-block mb-3">A user account will be automatically created for this provider using the email above.</small>
                        </div>
                        <div class="col-md-6 new-provider-user">
                            <label class="form-label">Password *</label>
                            <div class="input-group">
                                <input type="password" class="form-control" name="Password" id="newProviderPassword" minlength="8" placeholder="Minimum 8 characters" autocomplete="off">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('newProviderPassword', this)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <small class="text-muted">Required for user account creation</small>
                        </div>

                        <!-- User Account Management Section for EXISTING Provider -->
                        <div class="col-12 edit-provider-user" style="display: none;">
                            <hr>
                            <div class="card bg-light border-0 shadow-sm">
                                <div class="card-header bg-primary bg-opacity-10 border-0">
                                    <h6 class="mb-0"><i class="bi bi-person-badge me-2"></i>User Account Management</h6>
                                </div>
                                <div class="card-body" id="providerUserInfo">
                                    <div class="text-center py-3">
                                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <p class="text-muted mb-0 mt-2">Loading user information...</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Provider</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Provider Detail Modal -->
<div class="modal fade" id="providerDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Provider Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="providerDetailContent"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger requires-admin" id="deleteProviderBtn">
                    <i class="bi bi-trash me-1"></i>Deactivate
                </button>
                <button type="button" class="btn btn-primary requires-admin" id="editProviderBtn">
                    <i class="bi bi-pencil me-1"></i>Edit
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Provider Confirmation Modal -->
<div class="modal fade" id="deleteProviderConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirm Deactivation</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="confirmDeleteProviderId">
                <p>Are you sure you want to deactivate this provider?</p>
                <p class="text-muted mb-0">The provider will no longer appear in the provider list or be available for scheduling. This action can be undone by reactivating the provider.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteProvider()">
                    <i class="bi bi-trash me-1"></i>Deactivate Provider
                </button>
            </div>
        </div>
    </div>
</div>

<!-- (Legacy viewClinicalNoteModal removed in migration_016 — all note viewing now goes through tabbedClinicalNoteModal below.) -->

<!-- Tabbed Clinical Notes Modal -->
<div class="modal fade" id="tabbedClinicalNoteModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex flex-column w-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="modal-title" id="tabbedNoteModalTitle">Clinical Notes</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="row small text-muted" id="tabbedNoteAppointmentInfo">
                        <div class="col-auto"><strong>Patient:</strong> <span id="tabbedNotePatient">-</span></div>
                        <div class="col-auto"><strong>Provider:</strong> <span id="tabbedNoteProvider">-</span></div>
                        <div class="col-auto"><strong>Date:</strong> <span id="tabbedNoteDate">-</span></div>
                    </div>
                    <ul class="nav nav-tabs mt-3" id="clinicalNoteTabs" role="tablist"></ul>
                </div>
            </div>
            <div class="modal-body">
                <div class="tab-content" id="clinicalNoteTabContent"></div>
            </div>
            <div class="modal-footer" id="tabbedNoteModalFooter"></div>
        </div>
    </div>
</div>

<!-- Care Episode Modal -->
<div class="modal fade" id="careEpisodeModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-clipboard2-pulse me-2"></i>Care Episode</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="careEpisodeForm">
                <div class="modal-body">
                    <input type="hidden" id="careEpisodeId" name="CareEpisodeId">
                    <input type="hidden" id="careEpisodePatientId" name="PatientId">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="alert alert-info d-none" id="careEpisodePatientInfo"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Start Date *</label>
                            <input type="date" class="form-control" name="StartDate" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Primary Provider</label>
                            <select class="form-select" name="PrimaryProviderId" id="careEpisodeProvider">
                                <option value="">Select provider...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Primary Diagnosis Code *</label>
                            <input type="text" class="form-control" name="PrimaryDiagnosisCode" placeholder="e.g., M54.5" required autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Diagnosis Description</label>
                            <input type="text" class="form-control" name="PrimaryDiagnosisDescription" placeholder="e.g., Low back pain" autocomplete="off">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Physician Name (PCP)</label>
                            <input type="text" class="form-control" name="PhysicianName" placeholder="Dr. John Smith" maxlength="200" autocomplete="off">
                            <div class="form-text">Referring physician or primary care physician (optional)</div>
                        </div>
                        <div class="col-12">
                            <hr class="my-2">
                            <h6>Treatment Plan</h6>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Expected Visits</label>
                            <input type="number" class="form-control" name="ExpectedVisits" min="1" autocomplete="off">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Visit Frequency (weeks)</label>
                            <input type="number" class="form-control" name="VisitFrequency" min="1" placeholder="e.g., 2 = every 2 weeks" autocomplete="off">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Goals</label>
                            <textarea class="form-control" name="Goals" rows="3" placeholder="Enter treatment goals (one per line)"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Plan of Care</label>
                            <textarea class="form-control" name="PlanOfCare" rows="3" placeholder="Enter plan of care details"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success d-none" id="saveAndScheduleBtn" onclick="saveCareEpisodeAndSchedule()">
                        <i class="bi bi-calendar-plus me-1"></i>Save & Schedule
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Care Episode
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Care Episode Details Sidebar (Right Offcanvas) -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="careEpisodeDetailsSidebar" data-bs-backdrop="false" style="width: 700px; z-index:100000;">
    <div class="offcanvas-header bg-info text-white">
        <h5 class="offcanvas-title"><i class="bi bi-clipboard2-pulse me-2"></i>Care Episode Details</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="row">
            <div class="col-6 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-person me-1"></i>Patient</h6>
                        <div id="ceDetail_patient" class="fw-semibold">-</div>
                    </div>
                </div>
            </div>
            <div class="col-6 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-person-badge me-1"></i>Primary Provider</h6>
                        <div id="ceDetail_provider" class="fw-semibold">-</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-activity me-1"></i>Diagnosis</h6>
                        <div id="ceDetail_diagnosis" class="fw-semibold small">-</div>
                        <small id="ceDetail_diagnosisCode" class="text-muted">-</small>
                    </div>
                </div>
            </div>
            <div class="col-6 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-flag me-1"></i>Status</h6>
                        <div id="ceDetail_status">-</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-4 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2 text-center">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-calendar me-1"></i>Start</h6>
                        <div id="ceDetail_startDate" class="fw-semibold small">-</div>
                    </div>
                </div>
            </div>
            <div class="col-4 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2 text-center">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-calendar-check me-1"></i>End</h6>
                        <div id="ceDetail_endDate" class="fw-semibold small">-</div>
                    </div>
                </div>
            </div>
            <div class="col-4 mb-3">
                <div class="card h-100">
                    <div class="card-body py-2 text-center">
                        <h6 class="card-title text-muted mb-1 small"><i class="bi bi-check2-square me-1"></i>Visits</h6>
                        <div id="ceDetail_visits" class="fw-semibold small">-</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header py-2"><i class="bi bi-list-check me-1"></i>Treatment Plan</div>
            <div class="card-body py-2">
                <div class="row">
                    <div class="col-6 mb-2">
                        <small class="text-muted">Visit Frequency</small>
                        <div id="ceDetail_frequency" class="fw-semibold small">-</div>
                    </div>
                </div>
                <div class="mb-2">
                    <small class="text-muted">Goals</small>
                    <div id="ceDetail_goals" class="fw-semibold small">-</div>
                </div>
                <div>
                    <small class="text-muted">Plan of Care</small>
                    <div id="ceDetail_planOfCare" class="fw-semibold small">-</div>
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-calendar-event me-1"></i>Appointments</span>
                <span id="ceDetail_appointmentCount" class="badge bg-primary">0</span>
            </div>
            <div class="card-body p-0">
                <div id="ceDetail_appointmentsList">
                    <div class="text-center text-muted py-3">No appointments</div>
                </div>
            </div>
        </div>
    </div>
    <div class="offcanvas-footer border-top p-3 bg-light">
        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="offcanvas">Close</button>
        <button type="button" class="btn btn-primary" id="ceDetail_editBtn">
            <i class="bi bi-pencil me-1"></i>Edit
        </button>
    </div>
</div>

<!-- Clinical Note Slide-out Panel -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="clinicalNotePanel" style="width: 600px;">
    <div class="offcanvas-header bg-light">
        <h5 class="offcanvas-title" id="clinicalNotePanelTitle">Clinical Note</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div id="clinicalNotePanelContent">
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Care Episode Discharge Modal -->
<div class="modal fade" id="careEpisodeDischargeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-clipboard-check me-2"></i>Complete Care Episode</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Please enter the discharge reason for this care episode:</p>
                <div class="mb-3">
                    <label for="dischargeReasonInput" class="form-label">Discharge Reason <span class="text-danger">*</span></label>
                    <select class="form-select" id="dischargeReasonInput" required>
                        <option value="">Select reason...</option>
                        <option value="Goals Met">Goals Met</option>
                        <option value="Patient Request">Patient Request</option>
                        <option value="Insurance Exhausted">Insurance Exhausted</option>
                        <option value="Non-Compliance">Non-Compliance</option>
                        <option value="Transferred">Transferred</option>
                        <option value="Other">Other</option>
                    </select>
                    <div class="invalid-feedback">Please select a discharge reason.</div>
                </div>
                <input type="hidden" id="dischargeCareEpisodeId">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="confirmCareEpisodeDischarge()">
                    <i class="bi bi-check-lg me-1"></i>Complete Episode
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Care Episode Extend Date Modal -->
<div class="modal fade" id="careEpisodeExtendModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="bi bi-calendar-plus me-2"></i>Extend Care Episode</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Enter the new end date for this care episode:</p>
                <div class="mb-3">
                    <label for="extendEndDateInput" class="form-label">New End Date <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="extendEndDateInput" required autocomplete="off">
                    <div class="invalid-feedback">Please enter a valid date.</div>
                </div>
                <input type="hidden" id="extendCareEpisodeId">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info" onclick="confirmCareEpisodeExtend()">
                    <i class="bi bi-calendar-check me-1"></i>Extend Episode
                </button>
            </div>
        </div>
    </div>
</div>
