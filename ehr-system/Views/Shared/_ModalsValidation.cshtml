@*
    Validation and Confirmation Modals
*@

<!-- Initial Evaluation Validation Modal - Missing Fields -->
<div class="modal fade" id="ieValidationMissingFieldsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Missing Required Fields</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>The following required fields are missing from the clinical note. Please edit the note to include them before signing:</p>
                <ul id="ieMissingFieldsList" class="list-group mb-3"></ul>
                <div class="alert alert-info mb-0" id="ieMissingFieldsInfo">
                    <i class="bi bi-info-circle me-2"></i>
                    <span id="ieMissingFieldsInfoText">These fields are required to create a Care Episode from the Initial Evaluation.</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="ieEditNoteBtn">
                    <i class="bi bi-pencil me-1"></i>Edit Clinical Note
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Initial Evaluation Validation Modal - Insurance Warning -->
<div class="modal fade" id="ieValidationInsuranceModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Insurance Visit Mismatch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="ieInsuranceMismatchContent"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="ieInsuranceEditBtn">
                    <i class="bi bi-pencil me-1"></i>Edit Clinical Note
                </button>
                <button type="button" class="btn btn-warning" id="ieInsuranceContinueBtn">
                    <i class="bi bi-arrow-right me-1"></i>Continue Anyway
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Initial Evaluation Validation Modal - No Insurance Warning -->
<div class="modal fade" id="ieValidationNoInsuranceModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Insurance Information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>No insurance found for this patient.</strong>
                </div>
                <p>The patient does not have insurance information on file. You can still sign the note and create a Care Episode, but insurance-based visit limits cannot be validated.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="ieNoInsuranceEditBtn">
                    <i class="bi bi-pencil me-1"></i>Edit Clinical Note
                </button>
                <button type="button" class="btn btn-primary" id="ieNoInsuranceContinueBtn">
                    <i class="bi bi-check-lg me-1"></i>Continue
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Care Episode Confirmation Modal - Review and Edit Before Creation -->
<div class="modal fade" id="careEpisodeConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-check-circle me-2"></i>Confirm Care Episode</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle me-2"></i>
                    Review and confirm the Care Episode details before creation.
                </div>
                <div id="ceReevalInfo" style="display: none;"></div>
                <p class="text-muted small mb-3">These values were extracted from the clinical note. You can edit them if needed.</p>
                <div class="mb-3">
                    <label for="ceConfirmExpectedVisits" class="form-label fw-semibold">Expected Visits</label>
                    <input type="number" class="form-control" id="ceConfirmExpectedVisits" min="1" max="100" autocomplete="off">
                    <div class="form-text">Total number of visits for this care episode</div>
                </div>
                <div class="mb-3">
                    <label for="ceConfirmVisitFrequency" class="form-label fw-semibold">Visit Frequency (per week)</label>
                    <input type="number" class="form-control" id="ceConfirmVisitFrequency" min="1" max="7" autocomplete="off">
                    <div class="form-text">Number of visits per week</div>
                </div>
                <div class="mb-3">
                    <label for="ceConfirmDuration" class="form-label fw-semibold">Duration (weeks)</label>
                    <input type="number" class="form-control" id="ceConfirmDuration" min="1" max="52" autocomplete="off">
                    <div class="form-text">Duration of care in weeks</div>
                </div>
                <div class="mb-3">
                    <label for="ceConfirmPhysicianName" class="form-label fw-semibold">Physician Name (PCP)</label>
                    <input type="text" class="form-control" id="ceConfirmPhysicianName" maxlength="200" placeholder="Dr. John Smith" autocomplete="off">
                    <div class="form-text">Referring physician or primary care physician (optional)</div>
                </div>
                <hr id="ceDiagnosisSeparator">
                <div class="bg-light p-3 rounded" id="ceDiagnosisSection">
                    <h6 class="mb-2">Extracted Diagnosis</h6>
                    <p class="mb-1" id="ceConfirmDiagnosis">-</p>
                    <small class="text-muted" id="ceConfirmDiagnosisCode">-</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" onclick="cancelCareEpisodeConfirmation()">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" onclick="confirmCareEpisodeCreation()">
                    <i class="bi bi-check-lg me-1"></i>Confirm and Create Care Episode
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Authorization Add/Edit Modal -->
<div class="modal fade" id="authorizationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="authorizationModalTitle">
                    <i class="bi bi-shield-plus me-2"></i>Add Authorization
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="authorizationForm" onsubmit="saveAuthorization(event)">
                <div class="modal-body">
                    <input type="hidden" id="authorizationId" value="">
                    <input type="hidden" id="authorizationInsuranceId" value="">
                    <input type="hidden" id="authorizationMode" value="add">
                    <input type="hidden" id="authorizationContext" value="">
                    <div class="mb-3">
                        <label for="authNumber" class="form-label">Authorization Number <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="authNumber" required placeholder="e.g., AUTH-2024-12345" autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label for="authVisits" class="form-label">Authorized Visits <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="authVisits" required min="1" max="999" placeholder="Number of authorized visits" autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label for="authExpiry" class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="authExpiry" autocomplete="off">
                        <div class="form-text">Leave blank if no expiration date</div>
                    </div>
                    <div class="mb-3">
                        <label for="authNotes" class="form-label">Notes</label>
                        <textarea class="form-control" id="authNotes" rows="2" placeholder="Optional notes about this authorization" autocomplete="off"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="authorizationSaveBtn">
                        <i class="bi bi-check-lg me-1"></i>Save Authorization
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Authorization Delete Confirmation Modal -->
<div class="modal fade" id="deleteAuthorizationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Delete Authorization</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this authorization?</p>
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <strong>Authorization Number:</strong> <span id="deleteAuthNumber">-</span><br>
                    <strong>Authorized Visits:</strong> <span id="deleteAuthVisits">-</span>
                </div>
                <p class="text-muted small mb-0">This action cannot be undone.</p>
                <input type="hidden" id="deleteAuthorizationId" value="">
                <input type="hidden" id="deleteAuthorizationInsuranceId" value="">
                <input type="hidden" id="deleteAuthorizationContext" value="">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteAuthorization()">
                    <i class="bi bi-trash me-1"></i>Delete Authorization
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Scheduling Validation Modal - Insurance/Authorization Issues -->
<div class="modal fade" id="schedulingValidationModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="schedulingValidationTitle">
                    <i class="bi bi-exclamation-triangle me-2"></i>Insurance/Authorization Issue
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="schedulingValidationContent"></div>
                <input type="hidden" id="schedulingValidationPatientId" value="">
                <input type="hidden" id="schedulingValidationCareEpisodeId" value="">
                <input type="hidden" id="schedulingValidationIssueType" value="">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" id="schedulingValidationManageBtn">
                    <i class="bi bi-gear me-1"></i>Manage Insurance
                </button>
                <button type="button" class="btn btn-warning" id="schedulingValidationContinueBtn">
                    <i class="bi bi-arrow-right me-1"></i>Ignore & Continue
                </button>
            </div>
        </div>
    </div>
</div>
