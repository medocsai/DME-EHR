@* Application Sidebar - Navigation menu *@
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="logo">
            <img src="/medocslogo.png" alt="MEDOCS" class="sidebar-logo-img">
        </div>
        <span class="logo-text">MEDOCS <small style="opacity:.7;font-weight:600">DME</small></span>
    </div>

    <div class="sidebar-tenant" id="sidebarTenant">
        <strong>Clinic Name</strong>
    </div>

    <!-- Location Switcher (Multi-Location Support) -->
    <div class="sidebar-location" id="sidebarLocation">
        <div class="location-current" id="currentLocationDisplay" onclick="openLocationSwitcher()">
            <div class="location-icon">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div class="location-info">
                <span class="location-label">Location</span>
                <span class="location-name" id="currentLocationName">Main Location</span>
            </div>
            <div class="location-arrow">
                <i class="bi bi-chevron-down"></i>
            </div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <a href="#" class="nav-item active" data-page="dashboard">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>
        <a href="#" class="nav-item" data-page="schedule">
            <i class="bi bi-calendar3"></i>
            <span>Schedule</span>
        </a>
        <a href="#" class="nav-item" data-page="patients">
            <i class="bi bi-people"></i>
            <span>Customers</span>
        </a>
        <a href="#" class="nav-item requires-admin" data-page="providers">
            <i class="bi bi-person-badge"></i>
            <span>Providers</span>
        </a>
        <!-- Clinical Notes hidden — accessible via Encounter Workspace -->
        <a href="#" class="nav-item d-none" data-page="notes">
            <i class="bi bi-file-earmark-medical"></i>
            <span>Clinical Notes</span>
        </a>
        <a href="#" class="nav-item requires-billing-access" data-page="billing">
            <i class="bi bi-currency-dollar"></i>
            <span>Billing</span>
        </a>
        <a href="#" class="nav-item d-none" data-page="unavailability">
            <i class="bi bi-calendar-x"></i>
            <span>Time Off</span>
        </a>
        <a href="#" class="nav-item requires-admin" data-page="reports">
            <i class="bi bi-file-earmark-bar-graph"></i>
            <span>Reports</span>
        </a>
        <a href="#" class="nav-item requires-super-admin d-none" data-page="templates">
            <i class="bi bi-file-earmark-text"></i>
            <span>Note Templates</span>
        </a>
        <a href="#" class="nav-item requires-admin" data-page="users">
            <i class="bi bi-people-fill"></i>
            <span>User Management</span>
        </a>
        <a href="#" class="nav-item requires-admin" onclick="openLocationManagement(); return false;">
            <i class="bi bi-geo-alt"></i>
            <span>Locations</span>
        </a>
        <a href="#" class="nav-item requires-super-admin" data-page="tenants">
            <i class="bi bi-building"></i>
            <span>Clinics</span>
        </a>
        <a href="#" class="nav-item requires-admin" data-page="settings">
            <i class="bi bi-gear-fill"></i>
            <span>Settings</span>
        </a>
        <a href="#" class="nav-item requires-admin" data-page="consent-forms">
            <i class="bi bi-file-earmark-check"></i>
            <span>Consent Forms</span>
        </a>
    </nav>

    <div class="sidebar-footer">
        <div class="user-info">
            <div class="user-avatar" id="userAvatar">U</div>
            <div class="user-details">
                <span class="user-name" id="userName">User Name</span>
                <span class="user-role" id="userRole">Role</span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-sm btn-outline-light" data-bs-toggle="modal" data-bs-target="#changePasswordModal" title="Change Password">
                <i class="bi bi-key"></i>
            </button>
            <button class="btn btn-sm btn-outline-light clinician-only" id="btnOpenPreferences" data-bs-toggle="modal" data-bs-target="#preferencesModal" title="Preferences">
                <i class="bi bi-gear"></i>
            </button>
            <button class="btn btn-sm btn-outline-light flex-grow-1" id="logoutBtn">
                <i class="bi bi-box-arrow-left me-1"></i>Logout
            </button>
        </div>
    </div>
</aside>
