@{
    Layout = null;
    var token = ViewBag.Token as string ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Telehealth Visit - MEDOCS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary: #1976d2;
            --teal: #00897B;
        }
        body {
            background: linear-gradient(135deg, #e3f2fd 0%, #f5f5f5 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }
        .telehealth-container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .telehealth-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .telehealth-header {
            background: linear-gradient(135deg, var(--primary) 0%, var(--teal) 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .telehealth-header h1 {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }
        .telehealth-header .subtitle {
            opacity: 0.9;
            font-size: 0.9rem;
        }
        .telehealth-body {
            padding: 30px;
        }
        .info-row {
            display: flex;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #f0f0f0;
        }
        .info-row:last-child { border-bottom: none; }
        .info-row i {
            font-size: 1.2rem;
            color: var(--teal);
            width: 36px;
            text-align: center;
        }
        .info-row .label {
            color: #666;
            font-size: 0.85rem;
            min-width: 80px;
        }
        .info-row .value {
            font-weight: 600;
            color: #333;
        }

        /* Waiting animation */
        .waiting-indicator {
            text-align: center;
            padding: 30px 0;
        }
        .pulse-ring {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--teal);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            position: relative;
            color: white;
            font-size: 2rem;
        }
        .pulse-ring::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 3px solid var(--teal);
            animation: pulse 2s ease-out infinite;
        }
        @@keyframes pulse {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.8); opacity: 0; }
        }
        .waiting-text {
            margin-top: 20px;
            font-size: 1.1rem;
            color: #333;
        }
        .waiting-subtext {
            color: #888;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        /* In-call state - Jitsi takes full screen */
        .in-call-container {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: 9999;
            background: #000;
        }
        .in-call-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        /* Loading spinner */
        .loading-state {
            text-align: center;
            padding: 60px 20px;
        }

        /* Error state */
        .error-state {
            text-align: center;
            padding: 40px 20px;
        }
        .error-icon {
            font-size: 3rem;
            color: #f44336;
        }
    </style>
</head>
<body>
    <div id="telehealthJoinPage" data-token="@token">
        <!-- Loading State -->
        <div id="stateLoading" class="telehealth-container">
            <div class="telehealth-card">
                <div class="telehealth-header">
                    <h1><i class="bi bi-camera-video me-2"></i>MEDOCS</h1>
                    <div class="subtitle">Telehealth Visit</div>
                </div>
                <div class="loading-state">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-muted">Connecting to your appointment...</p>
                </div>
            </div>
        </div>

        <!-- Error State -->
        <div id="stateError" class="telehealth-container d-none">
            <div class="telehealth-card">
                <div class="telehealth-header">
                    <h1><i class="bi bi-camera-video me-2"></i>MEDOCS</h1>
                    <div class="subtitle">Telehealth Visit</div>
                </div>
                <div class="error-state">
                    <div class="error-icon"><i class="bi bi-exclamation-circle"></i></div>
                    <h4 class="mt-3">Unable to Join</h4>
                    <p id="errorMessage" class="text-muted">This telehealth link is invalid or has expired.</p>
                </div>
            </div>
        </div>

        <!-- Verification State (SSN + DOB) -->
        <div id="stateVerify" class="telehealth-container d-none">
            <div class="telehealth-card">
                <div class="telehealth-header">
                    <h1><i class="bi bi-shield-lock me-2"></i>MEDOCS</h1>
                    <div class="subtitle">Verify Your Identity</div>
                </div>
                <div class="telehealth-body">
                    <p class="text-center text-muted mb-4">Please verify your identity to join the telehealth visit.</p>

                    <div id="verifyError" class="alert alert-danger d-none mb-3"></div>

                    <!-- Last Name -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="vLastName">Last Name</label>
                        <input type="text" class="form-control" id="vLastName"
                               maxlength="100" autocomplete="off" autocapitalize="words"
                               style="height:48px;font-size:1rem;border-radius:10px;">
                    </div>

                    <!-- Date of Birth -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Date of Birth</label>
                        <div class="d-flex gap-2 justify-content-center">
                            <input type="tel" class="form-control text-center" id="vDobMm" maxlength="2" placeholder="MM" inputmode="numeric" autocomplete="off" style="width:70px;height:48px;font-size:1.1rem;border-radius:10px;">
                            <span class="align-self-center fw-bold text-muted">/</span>
                            <input type="tel" class="form-control text-center" id="vDobDd" maxlength="2" placeholder="DD" inputmode="numeric" autocomplete="off" style="width:70px;height:48px;font-size:1.1rem;border-radius:10px;">
                            <span class="align-self-center fw-bold text-muted">/</span>
                            <input type="tel" class="form-control text-center" id="vDobYyyy" maxlength="4" placeholder="YYYY" inputmode="numeric" autocomplete="off" style="width:90px;height:48px;font-size:1.1rem;border-radius:10px;">
                        </div>
                    </div>

                    <!-- ZIP Code -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="vZip">ZIP Code</label>
                        <input type="tel" class="form-control" id="vZip"
                               maxlength="10" minlength="5" inputmode="numeric"
                               placeholder="12345" autocomplete="off"
                               style="height:48px;font-size:1rem;border-radius:10px;">
                    </div>

                    <button class="btn btn-primary w-100 py-2 fw-semibold" id="verifyBtn" style="border-radius:10px;font-size:1rem;">
                        <i class="bi bi-check-circle me-1"></i>Verify & Join
                    </button>
                </div>
            </div>
        </div>

        <!-- Waiting Room State -->
        <div id="stateWaiting" class="telehealth-container d-none">
            <div class="telehealth-card">
                <div class="telehealth-header">
                    <h1 id="clinicName"><i class="bi bi-camera-video me-2"></i>MEDOCS</h1>
                    <div class="subtitle">Telehealth Visit</div>
                </div>
                <div class="telehealth-body">
                    <div class="info-row">
                        <i class="bi bi-person-badge"></i>
                        <span class="label">Provider</span>
                        <span class="value" id="providerName">—</span>
                    </div>
                    <div class="info-row">
                        <i class="bi bi-clock"></i>
                        <span class="label">Time</span>
                        <span class="value" id="appointmentTime">—</span>
                    </div>
                    <div class="waiting-indicator">
                        <div class="pulse-ring">
                            <i class="bi bi-telephone"></i>
                        </div>
                        <div class="waiting-text">Please wait, your provider will be with you shortly...</div>
                        <div class="waiting-subtext">You are in the waiting room</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- In-Call State (Jitsi fills the screen) -->
        <div id="stateInCall" class="in-call-container d-none">
            <div id="jitsiPatientContainer" style="width: 100%; height: 100%;"></div>
        </div>
    </div>

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <!-- Telehealth Patient Module -->
    <script src="/js/modules/telehealth/TelehealthPatientModule.js?v=1778589320"></script>
</body>
</html>
