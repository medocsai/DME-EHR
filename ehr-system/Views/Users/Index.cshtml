@{
    ViewData["Title"] = "User Management";
    ViewData["ActivePage"] = "users";
}

<!-- Users Page -->
<div class="page active" id="usersPage">
    <div class="page-header">
        <button class="btn btn-primary" onclick="openAddUserModal()">
            <i class="bi bi-plus-lg me-1"></i>Add User
        </button>
    </div>
    <div class="mb-3">
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-primary" id="userFilterActive" data-filter="active" onclick="filterUsers('active')">
                <i class="bi bi-person-check me-1"></i>Active
            </button>
            <button type="button" class="btn btn-outline-secondary" id="userFilterInactive" data-filter="inactive" onclick="filterUsers('inactive')">
                <i class="bi bi-person-x me-1"></i>Inactive
            </button>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="usersTable">
                    <thead>
                        <tr><th>Name</th><th>Email</th><th>Role</th><th>Provider</th><th>Clinic</th><th>Locations</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Modals {
    <partial name="_ModalsAdmin" />
}

@section Scripts {
}
