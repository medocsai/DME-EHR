/**
 * PatientModule - Patient management functionality
 *
 * Handles patient CRUD operations, filtering, viewing details,
 * insurance management, and document handling.
 *
 * @example
 *   const patients = App.modules.get('patients');
 *   await patients.init();
 *   patients.load();
 */
class PatientModule {
    /**
     * @param {Object} options - Module options
     * @param {Object} options.api - API service instance
     * @param {Object} options.eventBus - Event bus for cross-module communication
     */
    constructor(options = {}) {
        this.api = options.api || null;
        this.eventBus = options.eventBus || null;

        // State
        this.patients = [];
        this.currentPatient = null;
        this.currentFilters = {
            status: 'all',
            validation: 'all',
            episodes: 'all',
            showArchived: false,
            search: ''
        };
        this.isInitialized = false;
        this.pendingFiles = []; // Files queued for upload when creating new patient

        // DOM references
        this.container = null;
        this.tableBody = null;
        this.searchInput = null;

        // Bind methods
        this._handleContainerClick = this._handleContainerClick.bind(this);
        this._handleSearch = this._handleSearch.bind(this);
    }

    /**
     * Initialize the module
     * @returns {Promise<void>}
     */
    async init() {
        this.container = document.getElementById('patientsGrid') ||
                        document.querySelector('.patients-container');
        this.tableBody = document.getElementById('patientsTableBody');
        this.searchInput = document.getElementById('patientSearch');

        // Always bind form events (modal can be opened from anywhere)
        this._bindFormSubmit();

        // Also bind when patient modal is shown (in case form wasn't ready initially)
        const patientModal = document.getElementById('patientModal');
        if (patientModal) {
            // Reset form and tabs when modal is about to be shown
            patientModal.addEventListener('show.bs.modal', (event) => {
                // Check if this is opened by a button (new patient) vs programmatically (edit)
                // When opened by button directly, reset the form
                const trigger = event.relatedTarget;
                if (trigger && trigger.hasAttribute('data-bs-toggle')) {
                    // This is "Add Patient" button - reset everything
                    this._resetPatientForm();
                }
            });

            patientModal.addEventListener('shown.bs.modal', () => {
                this._bindFormSubmit();
                this._initAttachmentUpload();
                // Reset modal title for new patient
                const titleEl = patientModal.querySelector('.modal-title');
                const patientIdInput = document.getElementById('patientId');
                if (titleEl && patientIdInput && !patientIdInput.value) {
                    titleEl.textContent = 'New Patient';
                }
            });

            // Clear pending files and state when modal is closed
            patientModal.addEventListener('hidden.bs.modal', () => {
                this.pendingFiles = [];
                this._pendingAuthorization = null;
                this.currentPatient = null;
            });
        }

        if (!this.container && !this.tableBody) {
            this.isInitialized = true;
            this._emit('patients:initialized');
            return;
        }

        this._bindEvents();
        this._initFilterButtons();

        this.isInitialized = true;
        this._emit('patients:initialized');
    }

    /**
     * Bind event handlers
     * @private
     */
    _bindEvents() {
        // Container click delegation
        if (this.container) {
            this.container.addEventListener('click', this._handleContainerClick);
        }
        if (this.tableBody) {
            this.tableBody.addEventListener('click', this._handleContainerClick);
        }

        // Search input
        if (this.searchInput) {
            this.searchInput.addEventListener('input', this._debounce(this._handleSearch, 300));
        }

        // Status filter buttons
        document.querySelectorAll('#patientStatusFilter .filter-btn').forEach(btn => {
            btn.addEventListener('click', (e) => this._handleStatusFilterClick(e));
        });

        // Profile filter buttons
        document.querySelectorAll('#patientValidationFilter .filter-btn').forEach(btn => {
            btn.addEventListener('click', (e) => this._handleProfileFilterClick(e));
        });

        // Archived checkbox
        const archivedCheckbox = document.getElementById('includeArchivedCheckbox');
        if (archivedCheckbox) {
            archivedCheckbox.addEventListener('change', (e) => {
                this.currentFilters.showArchived = e.target.checked;
                this.applyFilters();
            });
        }

        // Note: Form submission and modal events are now bound in init()
        // to ensure they work even when container is not found
    }

    /**
     * Bind form submit handler if not already bound
     * @private
     */
    _bindFormSubmit() {
        const form = document.getElementById('patientForm');
        if (!form || form._patientModuleHandlerBound) {
            return;
        }

        form.addEventListener('submit', (e) => this._handleFormSubmit(e));
        form._patientModuleHandlerBound = true;
    }

    /**
     * Initialize filter buttons state
     * @private
     */
    _initFilterButtons() {
        // Set initial active states - the HTML already has 'selected' class on defaults
        // This method ensures consistency if needed
        const statusAllBtn = document.querySelector('#patientStatusFilter .filter-btn[data-value="all"]');
        if (statusAllBtn && !statusAllBtn.classList.contains('selected')) {
            statusAllBtn.classList.add('selected');
            statusAllBtn.dataset.selected = 'true';
        }

        const profileAllBtn = document.querySelector('#patientValidationFilter .filter-btn[data-value=""]');
        if (profileAllBtn && !profileAllBtn.classList.contains('selected')) {
            profileAllBtn.classList.add('selected');
            profileAllBtn.dataset.selected = 'true';
        }
    }

    /**
     * Handle container click events via delegation
     * @private
     * @param {Event} e - Click event
     */
    _handleContainerClick(e) {
        const target = e.target.closest('[data-action]');
        if (!target) return;

        // Prevent default for anchor tags
        if (target.tagName === 'A') {
            e.preventDefault();
        }

        const action = target.dataset.action;
        const patientId = target.dataset.patientId;

        switch (action) {
            case 'view':
                this.view(parseInt(patientId));
                break;
            case 'edit':
                this.edit(parseInt(patientId));
                break;
            case 'delete':
                this.delete(parseInt(patientId), target.dataset.patientName);
                break;
            case 'archive':
                this.archive(parseInt(patientId), target.dataset.patientName);
                break;
            case 'unarchive':
                this.unarchive(parseInt(patientId), target.dataset.patientName);
                break;
        }
    }

    /**
     * Handle status filter button clicks
     * @private
     * @param {Event} e - Click event
     */
    _handleStatusFilterClick(e) {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;

        const filterValue = btn.dataset.value;

        // Update selected state within filter group
        const group = document.getElementById('patientStatusFilter');
        if (group) {
            group.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('selected');
                b.dataset.selected = 'false';
            });
            btn.classList.add('selected');
            btn.dataset.selected = 'true';
        }

        // Update filter state (archived is now a separate checkbox)
        this.currentFilters.status = filterValue;

        this.applyFilters();
    }

    /**
     * Handle profile filter button clicks
     * @private
     * @param {Event} e - Click event
     */
    _handleProfileFilterClick(e) {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;

        const filterValue = btn.dataset.value;

        // Update selected state within filter group
        const group = document.getElementById('patientValidationFilter');
        if (group) {
            group.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('selected');
                b.dataset.selected = 'false';
            });
            btn.classList.add('selected');
            btn.dataset.selected = 'true';
        }

        // Update filter state - profile maps to validation filter
        this.currentFilters.validation = filterValue || 'all';

        this.applyFilters();
    }

    /**
     * Handle search input
     * @private
     */
    _handleSearch() {
        this.currentFilters.search = this.searchInput?.value || '';
        this.applyFilters();
    }

    /**
     * Load patients from API
     * @param {Object} filters - Optional filter overrides
     * @returns {Promise<void>}
     */
    async load(filters = {}) {
        try {
            const mergedFilters = { ...this.currentFilters, ...filters };
            const queryParams = this._buildQueryParams(mergedFilters);
            const url = `/patients${queryParams ? '?' + queryParams : ''}`;

            this.patients = await this._apiGet(url) || [];
            this._render();
            this._emit('patients:loaded', { patients: this.patients, filters: mergedFilters });
        } catch (error) {
            console.error('[PatientModule] Failed to load patients:', error);
            this._renderError('Failed to load patients');
            throw error;
        }
    }

    /**
     * Apply current filters and reload
     * @returns {Promise<void>}
     */
    async applyFilters() {
        await this.load(this.currentFilters);
    }

    /**
     * Clear all filters
     * @returns {Promise<void>}
     */
    async clearFilters() {
        this.currentFilters = {
            status: 'all',
            validation: 'all',
            episodes: 'all',
            showArchived: false,
            search: ''
        };

        // Reset UI
        if (this.searchInput) {
            this.searchInput.value = '';
        }

        // Reset status filter buttons
        document.querySelectorAll('#patientStatusFilter .filter-btn').forEach(btn => {
            btn.classList.remove('selected');
            btn.dataset.selected = 'false';
            if (btn.dataset.value === 'all') {
                btn.classList.add('selected');
                btn.dataset.selected = 'true';
            }
        });

        // Reset profile filter buttons
        document.querySelectorAll('#patientValidationFilter .filter-btn').forEach(btn => {
            btn.classList.remove('selected');
            btn.dataset.selected = 'false';
            if (btn.dataset.value === '') {
                btn.classList.add('selected');
                btn.dataset.selected = 'true';
            }
        });

        // Reset archived checkbox
        const archivedCheckbox = document.getElementById('includeArchivedCheckbox');
        if (archivedCheckbox) {
            archivedCheckbox.checked = false;
        }

        await this.load();
    }

    /**
     * View patient details
     * @param {number} patientId - Patient ID
     * @returns {Promise<void>}
     */
    async view(patientId) {
        try {
            const patient = await this._apiGet(`/patients/${patientId}`);
            if (!patient) return;

            this.currentPatient = patient;
            this._renderDetailModal(patient);
            this._emit('patients:viewed', { patient });
        } catch (error) {
            console.error('[PatientModule] Failed to view patient:', error);
            this._showError('Failed to load patient details');
        }
    }

    /**
     * Edit patient
     * @param {number} patientId - Patient ID
     * @returns {Promise<void>}
     */
    async edit(patientId) {
        // Check permissions
        const currentUser = this._getCurrentUser();
        if (currentUser?.Role === 2) {
            this._showWarning('Therapists cannot edit patient information. Please contact an administrator.');
            return;
        }

        try {
            const patient = await this._apiGet(`/patients/${patientId}`);
            if (!patient) return;

            this.currentPatient = patient;
            this._populateForm(patient);
            this._showModal('patientModal');
            this._emit('patients:editing', { patient });
        } catch (error) {
            console.error('[PatientModule] Failed to edit patient:', error);
            this._showError('Failed to load patient data');
        }
    }

    /**
     * Delete patient
     * @param {number} patientId - Patient ID
     * @param {string} patientName - Patient name for confirmation
     * @returns {Promise<void>}
     */
    async delete(patientId, patientName) {
        const confirmed = await this._confirm({
            title: 'Delete Patient',
            message: `Are you sure you want to delete patient "${patientName}"? This action cannot be undone.`,
            confirmText: 'Delete',
            confirmClass: 'btn-danger'
        });

        if (!confirmed) return;

        try {
            await this._apiDelete(`/patients/${patientId}`);
            this._showSuccess('Patient deleted successfully');
            this._emit('patients:deleted', { patientId, patientName });
            await this.load();
        } catch (error) {
            console.error('[PatientModule] Failed to delete patient:', error);
            this._showError('Failed to delete patient');
        }
    }

    /**
     * Archive patient
     * @param {number} patientId - Patient ID
     * @param {string} patientName - Patient name for confirmation
     * @returns {Promise<void>}
     */
    async archive(patientId, patientName) {
        const confirmed = await this._confirm({
            title: 'Archive Patient',
            message: `Are you sure you want to archive patient "${patientName}"? Archived patients cannot be edited but can be viewed and unarchived later.`,
            confirmText: 'Archive',
            confirmClass: 'btn-secondary'
        });

        if (!confirmed) return;

        try {
            await this._apiPost(`/patients/${patientId}/archive`);
            this._showSuccess(`Patient "${patientName}" has been archived`);
            this._emit('patients:archived', { patientId, patientName });
            await this.applyFilters();
        } catch (error) {
            console.error('[PatientModule] Failed to archive patient:', error);
            this._showError('Failed to archive patient');
        }
    }

    /**
     * Unarchive patient
     * @param {number} patientId - Patient ID
     * @param {string} patientName - Patient name for confirmation
     * @returns {Promise<void>}
     */
    async unarchive(patientId, patientName) {
        const confirmed = await this._confirm({
            title: 'Unarchive Patient',
            message: `Are you sure you want to unarchive patient "${patientName}"? This will restore the patient to the active list and allow editing.`,
            confirmText: 'Unarchive',
            confirmClass: 'btn-success'
        });

        if (!confirmed) return;

        try {
            await this._apiPost(`/patients/${patientId}/unarchive`);
            this._showSuccess(`Patient "${patientName}" has been unarchived`);
            this._emit('patients:unarchived', { patientId, patientName });
            await this.applyFilters();
        } catch (error) {
            console.error('[PatientModule] Failed to unarchive patient:', error);
            this._showError('Failed to unarchive patient');
        }
    }

    /**
     * Validate insurance for current patient
     * @param {string} type - Insurance type ('primary' or 'secondary')
     * @returns {Promise<void>}
     */
    async validateInsurance(type = 'primary') {
        const statusEl = document.getElementById(`${type}InsuranceValidationStatus`);
        const historySection = document.getElementById(`${type}AuthHistorySection`);
        const allowedVisitsInput = document.getElementById(`${type}AllowedVisits`);

        if (statusEl) {
            statusEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Validating...';
        }

        try {
            // Get the insurance ID - check if we have a saved insurance or current patient
            const patientId = document.getElementById('patientId')?.value;
            const prefix = type === 'primary' ? 'PrimaryInsurance' : 'SecondaryInsurance';
            const payerName = document.querySelector(`[name="${prefix}.PayerName"]`)?.value;

            if (!payerName) {
                throw new Error('Please enter a payer name first');
            }

            // First we need to get the insurance ID
            // If patient is saved, fetch the insurance ID from patient data
            let insuranceId = null;

            if (patientId && this.currentPatient?.Insurances) {
                const insurance = this.currentPatient.Insurances.find(i =>
                    i.Type === (type === 'primary' ? 0 : 1)
                );
                insuranceId = insurance?.InsuranceId;
            }

            if (!insuranceId) {
                // If no insurance ID (new patient), simulate validation for smooth UX
                // Generate mock validation data similar to what the backend would return
                const mockAuthNumber = `AUTH-${new Date().toISOString().slice(0,10).replace(/-/g,'')}-${Math.floor(Math.random() * 9000) + 1000}`;
                const mockAuthorizedVisits = Math.floor(Math.random() * 21) + 10; // 10-30 visits
                const mockExpiryDate = new Date();
                mockExpiryDate.setMonth(mockExpiryDate.getMonth() + Math.floor(Math.random() * 10) + 3); // 3-12 months

                if (statusEl) {
                    statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Insurance validated (mock)</span>';
                }

                // Populate allowed visits with mock value
                if (allowedVisitsInput) {
                    allowedVisitsInput.value = mockAuthorizedVisits;
                }

                // Store mock authorization data for later use when patient is saved
                this._pendingAuthorization = this._pendingAuthorization || {};
                this._pendingAuthorization[type] = {
                    AuthorizationNumber: mockAuthNumber,
                    AuthorizedVisits: mockAuthorizedVisits,
                    ExpiryDate: mockExpiryDate.toISOString().split('T')[0],
                    Notes: `Auto-fetched authorization for ${payerName}`
                };

                this._showSuccess(`Insurance validated - ${mockAuthorizedVisits} visits authorized (will be saved with patient)`);
                return;
            }

            // Call the backend API to fetch authorization from mock payer
            const result = await this._apiPost(`/authorizations/insurance/${insuranceId}/fetch`);

            if (result && result.Success) {
                // Show success status
                if (statusEl) {
                    statusEl.innerHTML = '<span class="text-success"><i class="bi bi-check-circle me-1"></i>Insurance validated successfully</span>';
                }

                // Fill in the allowed visits from the response
                if (allowedVisitsInput && result.AuthorizedVisits) {
                    allowedVisitsInput.value = result.AuthorizedVisits;
                }

                // Show authorization history section
                if (historySection) {
                    historySection.style.display = 'block';
                }

                // Refresh authorization history
                await this.refreshAuthHistory(type);

                this._showSuccess(`${type === 'primary' ? 'Primary' : 'Secondary'} insurance validated - ${result.AuthorizedVisits} visits authorized`);
            } else {
                throw new Error(result?.Message || 'Validation failed');
            }
        } catch (error) {
            console.error('[PatientModule] Insurance validation failed:', error);
            if (statusEl) {
                statusEl.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle me-1"></i>${error.message || 'Validation failed'}</span>`;
            }
            this._showError(error.message || 'Failed to validate insurance');
        }
    }

    /**
     * Refresh authorization history
     * @param {string} type - Insurance type ('primary' or 'secondary')
     * @returns {Promise<void>}
     */
    async refreshAuthHistory(type = 'primary') {
        const historyBody = document.getElementById(`${type}AuthHistoryBody`);
        if (!historyBody) {
            return;
        }

        historyBody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center py-3">
                    <span class="spinner-border spinner-border-sm me-1"></span>Loading...
                </td>
            </tr>
        `;

        try {
            // Get insurance ID from current patient
            const insuranceId = this._getInsuranceId(type);

            if (!insuranceId) {
                historyBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">
                            <i class="bi bi-info-circle me-1"></i>No authorization history available
                            <br><small class="text-muted">Authorizations will appear here after saving the patient</small>
                        </td>
                    </tr>
                `;
                return;
            }

            const history = await this._apiGet(`/authorizations/insurance/${insuranceId}/history`);

            // API returns AllAuthorizations, not Authorizations
            const authorizations = history?.AllAuthorizations || history?.Authorizations || [];

            if (!history || authorizations.length === 0) {
                historyBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">
                            <i class="bi bi-info-circle me-1"></i>No authorization history available
                            <br><button class="btn btn-sm btn-primary mt-2" onclick="window.patientModule.openAuthorizationModal('${type}', 'create')">
                                <i class="bi bi-plus me-1"></i>Add Authorization
                            </button>
                        </td>
                    </tr>
                `;
                return;
            }

            // Store insurance ID for later use
            this._currentAuthInsuranceId = insuranceId;
            this._currentAuthType = type;

            historyBody.innerHTML = authorizations.map(auth => this._renderAuthorizationRow(auth, insuranceId)).join('');

            // Update the Plan Allowed Visits field with the current authorization's visits
            const currentAuth = authorizations.find(auth => !auth.IsExpired);
            if (currentAuth) {
                const allowedVisitsInput = document.getElementById(`${type}AllowedVisits`);
                if (allowedVisitsInput) {
                    allowedVisitsInput.value = currentAuth.AuthorizedVisits || '';
                }
            }
        } catch (error) {
            console.error('[PatientModule] Failed to load authorization history:', error);
            historyBody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center text-danger py-3">
                        <i class="bi bi-exclamation-triangle me-1"></i>Failed to load authorization history
                    </td>
                </tr>
            `;
        }
    }

    /**
     * Get insurance ID for a given type
     * @private
     * @param {string} type - 'primary' or 'secondary'
     * @returns {number|null}
     */
    _getInsuranceId(type) {
        if (this.currentPatient?.Insurances) {
            const insurance = this.currentPatient.Insurances.find(i =>
                i.Type === (type === 'primary' ? 0 : 1)
            );
            return insurance?.InsuranceId;
        }
        return null;
    }

    /**
     * Render authorization row
     * @private
     * @param {Object} auth - Authorization data
     * @param {number} insuranceId - Insurance ID
     * @returns {string} HTML
     */
    _renderAuthorizationRow(auth, insuranceId) {
        const statusClass = auth.IsActive ? 'bg-success' : (auth.IsExpired ? 'bg-danger' : 'bg-secondary');
        const statusText = auth.IsActive ? 'Active' : (auth.IsExpired ? 'Expired' : 'Inactive');

        return `
            <tr>
                <td><span class="badge ${statusClass}">${statusText}</span></td>
                <td>${this._escape(auth.AuthorizationNumber || '-')}</td>
                <td>${auth.AuthorizedVisits || 0}</td>
                <td>${auth.ExpiryDate ? this._formatDate(auth.ExpiryDate) : '-'}</td>
                <td>${auth.ValidatedOn ? this._formatDate(auth.ValidatedOn) : '-'}</td>
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="window.patientModule.editAuthorization(${auth.AuthorizationId}, ${insuranceId})">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="window.patientModule.deleteAuthorization(${auth.AuthorizationId}, ${insuranceId}, '${this._escape(auth.AuthorizationNumber || '')}', ${auth.AuthorizedVisits || 0})">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    }

    /**
     * Open authorization modal
     * @param {string} type - Insurance type
     * @param {string} action - Action ('create' or 'edit')
     */
    openAuthorizationModal(type, action = 'create') {
        const modal = document.getElementById('authorizationModal');
        if (!modal) {
            this._showError('Authorization modal not found');
            return;
        }

        const insuranceId = this._getInsuranceId(type);
        if (!insuranceId) {
            this._showWarning('Please save the patient with insurance information first');
            return;
        }

        // Reset form
        const form = document.getElementById('authorizationForm');
        if (form) form.reset();

        // Set hidden fields
        document.getElementById('authorizationId').value = '';
        document.getElementById('authorizationInsuranceId').value = insuranceId;
        document.getElementById('authorizationMode').value = action;
        document.getElementById('authorizationContext').value = type;

        // Update title
        const titleEl = document.getElementById('authorizationModalTitle');
        if (titleEl) {
            titleEl.innerHTML = '<i class="bi bi-shield-plus me-2"></i>Add Authorization';
        }

        // Show modal
        const bsModal = new bootstrap.Modal(modal);
        bsModal.show();
    }

    /**
     * Fetch mock authorization data and pre-fill the form
     * @param {string} type - Insurance type ('primary' or 'secondary')
     */
    async fetchMockAuthorization(type = 'primary') {
        const insuranceId = this._getInsuranceId(type);
        if (!insuranceId) {
            this._showWarning('Please save the patient with insurance information first');
            return;
        }

        try {
            this._showInfo('Fetching authorization data from payer...');

            // Call the backend API to fetch mock authorization data
            const result = await this._apiPost(`/authorizations/insurance/${insuranceId}/fetch`);

            if (!result || !result.Success) {
                throw new Error(result?.Message || 'Failed to fetch authorization data');
            }

            // Open the authorization modal and pre-fill with mock data
            const modal = document.getElementById('authorizationModal');
            if (!modal) {
                this._showError('Authorization modal not found');
                return;
            }

            // Reset form
            const form = document.getElementById('authorizationForm');
            if (form) form.reset();

            // Set hidden fields
            document.getElementById('authorizationId').value = '';
            document.getElementById('authorizationInsuranceId').value = insuranceId;
            document.getElementById('authorizationMode').value = 'create';
            document.getElementById('authorizationContext').value = type;

            // Pre-fill form with mock data
            document.getElementById('authNumber').value = result.AuthorizationNumber || '';
            document.getElementById('authVisits').value = result.AuthorizedVisits || '';
            document.getElementById('authExpiry').value = result.ExpiryDate ? result.ExpiryDate.split('T')[0] : '';
            document.getElementById('authNotes').value = result.Notes || `Fetched from payer on ${new Date().toLocaleDateString()}`;

            // Update title
            const titleEl = document.getElementById('authorizationModalTitle');
            if (titleEl) {
                titleEl.innerHTML = '<i class="bi bi-shield-plus me-2"></i>Add Authorization (Pre-filled from Payer)';
            }

            // Show modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            this._showSuccess(`Authorization data fetched: ${result.AuthorizedVisits} visits authorized`);
        } catch (error) {
            console.error('[PatientModule] Failed to fetch mock authorization:', error);
            this._showError(error.message || 'Failed to fetch authorization data from payer');
        }
    }

    /**
     * Edit authorization
     * @param {number} authId - Authorization ID
     * @param {number} insuranceId - Insurance ID
     */
    async editAuthorization(authId, insuranceId) {
        const modal = document.getElementById('authorizationModal');
        if (!modal) {
            this._showError('Authorization modal not found');
            return;
        }

        try {
            const auth = await this._apiGet(`/authorizations/${authId}`);
            if (!auth) {
                this._showError('Authorization not found');
                return;
            }

            // Populate form
            document.getElementById('authorizationId').value = authId;
            document.getElementById('authorizationInsuranceId').value = insuranceId;
            document.getElementById('authorizationMode').value = 'edit';
            document.getElementById('authNumber').value = auth.AuthorizationNumber || '';
            document.getElementById('authVisits').value = auth.AuthorizedVisits || '';
            document.getElementById('authExpiry').value = auth.ExpiryDate ? auth.ExpiryDate.split('T')[0] : '';
            document.getElementById('authNotes').value = auth.Notes || '';

            // Update title
            const titleEl = document.getElementById('authorizationModalTitle');
            if (titleEl) {
                titleEl.innerHTML = '<i class="bi bi-pencil me-2"></i>Edit Authorization';
            }

            // Show modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
        } catch (error) {
            console.error('[PatientModule] Failed to load authorization:', error);
            this._showError('Failed to load authorization');
        }
    }

    /**
     * Save authorization (called from form submit)
     * @param {Event} e - Submit event
     */
    async saveAuthorization(e) {
        if (e) e.preventDefault();

        const mode = document.getElementById('authorizationMode')?.value;
        const authId = document.getElementById('authorizationId')?.value;
        const insuranceId = document.getElementById('authorizationInsuranceId')?.value;
        const context = document.getElementById('authorizationContext')?.value;

        const data = {
            InsuranceId: parseInt(insuranceId),
            AuthorizationNumber: document.getElementById('authNumber')?.value,
            AuthorizedVisits: parseInt(document.getElementById('authVisits')?.value) || 0,
            ExpiryDate: document.getElementById('authExpiry')?.value || null,
            Notes: document.getElementById('authNotes')?.value || null
        };

        try {
            if (mode === 'edit' && authId) {
                await this._apiPut(`/authorizations/${authId}`, data);
                this._showSuccess('Authorization updated successfully');
            } else {
                await this._apiPost('/authorizations', data);
                this._showSuccess('Authorization created successfully');
            }

            // Close modal
            const modal = document.getElementById('authorizationModal');
            if (modal) {
                const bsModal = bootstrap.Modal.getInstance(modal);
                if (bsModal) bsModal.hide();
            }

            // Refresh history
            if (context) {
                await this.refreshAuthHistory(context);
            }
        } catch (error) {
            console.error('[PatientModule] Failed to save authorization:', error);
            this._showError(error.message || 'Failed to save authorization');
        }
    }

    /**
     * Delete authorization - show confirmation modal
     * @param {number} authId - Authorization ID
     * @param {number} insuranceId - Insurance ID
     * @param {string} authNumber - Authorization number for display
     * @param {number} visits - Number of visits for display
     */
    deleteAuthorization(authId, insuranceId, authNumber, visits) {
        const modal = document.getElementById('deleteAuthorizationModal');
        if (!modal) {
            // Fallback to confirm dialog
            this._confirmDeleteAuthorization(authId, insuranceId);
            return;
        }

        // Populate confirmation modal
        document.getElementById('deleteAuthNumber').textContent = authNumber || '-';
        document.getElementById('deleteAuthVisits').textContent = visits || 0;
        document.getElementById('deleteAuthorizationId').value = authId;
        document.getElementById('deleteAuthorizationInsuranceId').value = insuranceId;
        document.getElementById('deleteAuthorizationContext').value = this._currentAuthType || 'primary';

        // Show modal
        const bsModal = new bootstrap.Modal(modal);
        bsModal.show();
    }

    /**
     * Confirm delete authorization (called from delete modal)
     */
    async confirmDeleteAuthorization() {
        const authId = document.getElementById('deleteAuthorizationId')?.value;
        const insuranceId = document.getElementById('deleteAuthorizationInsuranceId')?.value;
        const context = document.getElementById('deleteAuthorizationContext')?.value;

        await this._confirmDeleteAuthorization(authId, insuranceId, context);
    }

    /**
     * Actually delete the authorization
     * @private
     */
    async _confirmDeleteAuthorization(authId, insuranceId, context = 'primary') {
        try {
            await this._apiDelete(`/authorizations/${authId}`);
            this._showSuccess('Authorization deleted successfully');

            // Close modal
            const modal = document.getElementById('deleteAuthorizationModal');
            if (modal) {
                const bsModal = bootstrap.Modal.getInstance(modal);
                if (bsModal) bsModal.hide();
            }

            // Refresh history
            await this.refreshAuthHistory(context);
        } catch (error) {
            console.error('[PatientModule] Failed to delete authorization:', error);
            this._showError(error.message || 'Failed to delete authorization');
        }
    }

    /**
     * Confirm delete patient (called from GlobalBridge)
     */
    async confirmDelete() {
        if (!this.currentPatient) {
            this._showError('No patient selected');
            return;
        }
        await this.delete(this.currentPatient.PatientId, this.currentPatient.FullName);
    }

    /**
     * Handle form submission
     * @private
     * @param {Event} e - Submit event
     */
    async _handleFormSubmit(e) {
        e.preventDefault();
        e.stopPropagation();

        const formData = new FormData(e.target);
        const patientId = formData.get('PatientId');
        const isEdit = patientId && patientId !== '';

        const data = this._extractFormData(formData);

        try {
            let response;
            if (isEdit) {
                response = await this._apiPut(`/patients/${patientId}`, data);
                this._showSuccess('Patient updated successfully');
                this._emit('patients:updated', { patientId, data });
            } else {
                response = await this._apiPost('/patients', data);
                if (!response) {
                    throw new Error('Server returned empty response. Please check if you are logged in.');
                }
                this._showSuccess('Patient created successfully');
                this._emit('patients:created', { patient: response });

                // Upload any pending files for the new patient
                if (this.pendingFiles.length > 0 && response.PatientId) {
                    await this._uploadPendingFiles(response.PatientId);
                }
            }

            this._hideModal('patientModal');
            e.target.reset();

            // Clear pending files when modal closes
            this.pendingFiles = [];

            // Only reload if we have a table to populate
            if (this.tableBody) {
                await this.load();
            }
        } catch (error) {
            console.error('[PatientModule] Save patient error:', error);
            this._showError(error.message || 'Failed to save patient');
        }
    }

    /**
     * Extract form data into patient object
     * @private
     * @param {FormData} formData - Form data
     * @returns {Object} Patient data
     */
    _extractFormData(formData) {
        const data = {
            FirstName: formData.get('FirstName'),
            LastName: formData.get('LastName'),
            DateOfBirth: formData.get('DateOfBirth'),
            Gender: formData.get('Gender') || null,
            Ssn: formData.get('Ssn') || null,
            Status: parseInt(formData.get('Status')) || 0,
            Phone: formData.get('Phone') || null,
            Email: formData.get('Email') || null,
            Address: formData.get('Address') || null,
            City: formData.get('City') || null,
            State: formData.get('State') || null,
            ZipCode: formData.get('ZipCode') || null,
            EmergencyContactName: formData.get('EmergencyContactName') || null,
            EmergencyContactPhone: formData.get('EmergencyContactPhone') || null,
            EmergencyContactRelation: formData.get('EmergencyContactRelation') || null
        };

        // Add primary insurance
        const payerName = formData.get('PrimaryInsurance.PayerName');
        if (payerName) {
            data.PrimaryInsurance = this._extractInsuranceData(formData, 'PrimaryInsurance');
        }

        // Add secondary insurance
        const secondaryPayerName = formData.get('SecondaryInsurance.PayerName');
        if (secondaryPayerName) {
            data.SecondaryInsurance = this._extractInsuranceData(formData, 'SecondaryInsurance');
        }

        return data;
    }

    /**
     * Extract insurance data from form
     * @private
     * @param {FormData} formData - Form data
     * @param {string} prefix - Insurance prefix (PrimaryInsurance or SecondaryInsurance)
     * @returns {Object} Insurance data
     */
    _extractInsuranceData(formData, prefix) {
        // Get AllowedVisits from the form - the field is named differently
        const type = prefix === 'PrimaryInsurance' ? 'primary' : 'secondary';
        const allowedVisitsInput = document.getElementById(`${type}AllowedVisits`);
        const allowedVisitsValue = allowedVisitsInput?.value;

        const data = {
            PayerName: formData.get(`${prefix}.PayerName`),
            PayerId: formData.get(`${prefix}.PayerId`) || null,
            PolicyNumber: formData.get(`${prefix}.PolicyNumber`) || '',
            GroupNumber: formData.get(`${prefix}.GroupNumber`) || null,
            InsuranceCategory: formData.get(`${prefix}.InsuranceCategory`)
                ? parseInt(formData.get(`${prefix}.InsuranceCategory`)) : null,
            Copay: formData.get(`${prefix}.Copay`)
                ? parseFloat(formData.get(`${prefix}.Copay`)) : null,
            SubscriberName: formData.get(`${prefix}.SubscriberName`) || null,
            SubscriberId: formData.get(`${prefix}.SubscriberId`) || null,
            SubscriberDob: formData.get(`${prefix}.SubscriberDob`) || null,
            SubscriberRelationship: formData.get(`${prefix}.SubscriberRelationship`) || null,
            AttorneyName: formData.get(`${prefix}.AttorneyName`) || null,
            AttorneyPhone: formData.get(`${prefix}.AttorneyPhone`) || null,
            AttorneyEmail: formData.get(`${prefix}.AttorneyEmail`) || null,
            AllowedVisits: allowedVisitsValue ? parseInt(allowedVisitsValue) : null
        };

        return data;
    }

    /**
     * Build query parameters from filters
     * @private
     * @param {Object} filters - Filter object
     * @returns {string} Query string
     */
    _buildQueryParams(filters) {
        const params = new URLSearchParams();

        // Handle status filter - backend expects 'statuses' (plural) with numeric values
        // or 'noCareEpisode=true' for no care episode filter
        if (filters.status && filters.status !== 'all') {
            if (filters.status === 'no-episode') {
                // Special case: filter for patients without care episodes
                params.append('noCareEpisode', 'true');
            } else {
                // Regular status filter - pass numeric value
                // 0 = Active, 2 = Discharged, etc.
                params.append('statuses', filters.status);
            }
        }

        // Handle archived filter - backend expects 'isArchived' boolean
        if (filters.showArchived) {
            params.append('isArchived', 'true');
        }

        // Handle validation/profile completeness filter
        // validation values: 'all' (no filter), '1' (incomplete), '2' (complete)
        if (filters.validation && filters.validation !== 'all') {
            if (filters.validation === '1') {
                // Incomplete profiles
                params.append('isProfileComplete', 'false');
            } else if (filters.validation === '2') {
                // Complete profiles
                params.append('isProfileComplete', 'true');
            }
        }

        if (filters.search) {
            params.append('search', filters.search);
        }

        return params.toString();
    }

    /**
     * Render patients list
     * @private
     */
    _render() {
        const target = this.tableBody || this.container;
        if (!target) return;

        if (!this.patients?.length) {
            target.innerHTML = this._renderEmptyState();
            return;
        }

        const currentUser = this._getCurrentUser();
        const isTherapist = currentUser?.Role === 2;

        target.innerHTML = this.patients.map(patient => this._renderPatientRow(patient, isTherapist)).join('');
    }

    /**
     * Render a single patient row
     * @private
     * @param {Object} patient - Patient data
     * @param {boolean} isTherapist - Whether current user is therapist
     * @returns {string} HTML
     */
    _renderPatientRow(patient, isTherapist) {
        const validationBadge = this._getValidationBadge(patient);
        const statusBadge = this._getStatusBadge(patient.Status);
        const profileBadge = this._getProfileBadge(patient);
        const isArchived = patient.IsArchived;
        // Handle both list API (PrimaryInsurance as string) and detail API (Insurances array)
        const primaryInsuranceName = patient.PrimaryInsurance ||
            patient.Insurances?.find(i => i.Type === 0)?.PayerName;

        return `
            <tr class="${isArchived ? 'table-secondary' : ''}">
                <td>
                    <span class="text-primary fw-medium">${this._escape(patient.MRN)}</span>
                </td>
                <td>
                    <a href="#" class="text-decoration-none fw-bold"
                       data-action="view"
                       data-patient-id="${patient.PatientId}">
                        ${this._escape(patient.FullName)}
                    </a>
                    ${isArchived ? '<span class="badge bg-secondary ms-1">Archived</span>' : ''}
                </td>
                <td>${this._formatDate(patient.DateOfBirth)} (${patient.Age}y)</td>
                <td>${this._escape(patient.Phone || '-')}</td>
                <td>${primaryInsuranceName ? this._escape(primaryInsuranceName) : '<span class="badge bg-secondary">No Insurance</span>'}</td>
                <td>${statusBadge}</td>
                <td class="hide-from-therapist hide-from-biller">${profileBadge}</td>
                <td>${(patient.LastVisit || patient.LastVisitDate) ? this._formatDate(patient.LastVisit || patient.LastVisitDate) : '-'}</td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-info"
                                data-action="view"
                                data-patient-id="${patient.PatientId}"
                                title="View">
                            <i class="bi bi-eye"></i>
                        </button>
                        ${!isTherapist && !isArchived ? `
                            <button class="btn btn-outline-primary"
                                    data-action="edit"
                                    data-patient-id="${patient.PatientId}"
                                    title="Edit">
                                <i class="bi bi-pencil"></i>
                            </button>
                        ` : ''}
                        ${!isTherapist ? `
                            ${isArchived ? `
                                <button class="btn btn-outline-success"
                                        data-action="unarchive"
                                        data-patient-id="${patient.PatientId}"
                                        data-patient-name="${this._escape(patient.FullName)}"
                                        title="Unarchive">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            ` : `
                                <button class="btn btn-outline-secondary"
                                        data-action="archive"
                                        data-patient-id="${patient.PatientId}"
                                        data-patient-name="${this._escape(patient.FullName)}"
                                        title="Archive">
                                    <i class="bi bi-archive"></i>
                                </button>
                            `}
                        ` : ''}
                    </div>
                </td>
            </tr>
        `;
    }

    /**
     * Render empty state
     * @private
     * @returns {string} HTML
     */
    _renderEmptyState() {
        return `
            <tr>
                <td colspan="9" class="text-center text-muted py-5">
                    <i class="bi bi-people fs-1 d-block mb-2"></i>
                    No patients found matching your criteria
                </td>
            </tr>
        `;
    }

    /**
     * Render error state
     * @private
     * @param {string} message - Error message
     */
    _renderError(message) {
        const target = this.tableBody || this.container;
        if (!target) return;

        target.innerHTML = `
            <tr>
                <td colspan="9" class="text-center text-danger py-4">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    ${this._escape(message)}
                    <button class="btn btn-sm btn-outline-danger ms-2" onclick="App.modules.get('patients').load()">
                        Retry
                    </button>
                </td>
            </tr>
        `;
    }

    /**
     * Render patient detail modal
     * @private
     * @param {Object} patient - Patient data
     */
    _renderDetailModal(patient) {
        const content = document.getElementById('patientDetailContent');
        if (!content) return;

        const primaryInsurance = patient.Insurances?.find(i => i.Type === 0);
        const secondaryInsurance = patient.Insurances?.find(i => i.Type === 1);

        content.innerHTML = `
            <div class="patient-header">
                <div class="patient-avatar-lg">${this._escape(patient.FullName?.charAt(0) || '?')}</div>
                <div class="patient-info">
                    <h3>${this._escape(patient.FullName)}</h3>
                    <div class="mrn">MRN: ${this._escape(patient.MRN)}</div>
                    <div class="patient-meta">
                        <span><i class="bi bi-calendar"></i> ${this._formatDate(patient.DateOfBirth)} (${patient.Age}y)</span>
                        <span><i class="bi bi-telephone"></i> ${this._escape(patient.Phone || 'No phone')}</span>
                        <span><i class="bi bi-envelope"></i> ${this._escape(patient.Email || 'No email')}</span>
                    </div>
                </div>
                <div class="ms-auto">
                    ${this._getStatusBadge(patient.Status)}
                </div>
            </div>

            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#patientOverview">Overview</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#patientInsurances">Insurance</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#patientEpisodes">Care Episodes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#patientAttachments">Attachments</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#patientConsents">Consents</a>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="patientOverview">
                    ${this._renderOverviewTab(patient)}
                </div>
                <div class="tab-pane fade" id="patientInsurances">
                    ${this._renderInsuranceTab(patient, primaryInsurance, secondaryInsurance)}
                </div>
                <div class="tab-pane fade" id="patientEpisodes">
                    ${this._renderCareEpisodesTab(patient)}
                </div>
                <div class="tab-pane fade" id="patientAttachments">
                    ${this._renderAttachmentsTab(patient)}
                </div>
                <div class="tab-pane fade" id="patientConsents">
                    ${this._renderConsentsTab(patient)}
                </div>
            </div>
        `;

        this._showModal('patientDetailModal');

        // Add event listener to load documents when Attachments tab is clicked
        const attachmentsTab = content.querySelector('a[href="#patientAttachments"]');
        if (attachmentsTab) {
            attachmentsTab.addEventListener('shown.bs.tab', () => {
                this._loadViewPatientDocuments(patient.PatientId);
            });

            // Also handle click for browsers that don't fire shown.bs.tab
            attachmentsTab.addEventListener('click', () => {
                // Small delay to let tab become visible
                setTimeout(() => {
                    this._loadViewPatientDocuments(patient.PatientId);
                }, 100);
            });
        }
    }

    /**
     * Render overview tab content
     * @private
     * @param {Object} patient - Patient data
     * @returns {string} HTML
     */
    _renderOverviewTab(patient) {
        return `
            <div class="row">
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Demographics</h6>
                    <p><strong>Address:</strong> ${this._escape(patient.Address || '-')},
                        ${this._escape(patient.City || '')} ${this._escape(patient.State || '')}
                        ${this._escape(patient.ZipCode || '')}</p>
                    <p><strong>Gender:</strong> ${this._escape(patient.Gender || '-')}</p>
                    <p><strong>Preferred Provider:</strong> ${this._escape(patient.PreferredProviderName || '-')}</p>
                </div>
                <div class="col-md-6">
                    <h6 class="text-muted mb-3">Emergency Contact</h6>
                    <p><strong>Name:</strong> ${this._escape(patient.EmergencyContactName || '-')}</p>
                    <p><strong>Phone:</strong> ${this._escape(patient.EmergencyContactPhone || '-')}</p>
                    <p><strong>Relationship:</strong> ${this._escape(patient.EmergencyContactRelation || '-')}</p>
                </div>
            </div>
        `;
    }

    /**
     * Render insurance tab content
     * @private
     * @param {Object} patient - Patient data
     * @param {Object} primaryInsurance - Primary insurance
     * @param {Object} secondaryInsurance - Secondary insurance
     * @returns {string} HTML
     */
    _renderInsuranceTab(patient, primaryInsurance, secondaryInsurance) {
        if (!patient.Insurances?.length) {
            return '<div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No insurance information on file.</div>';
        }

        return `
            ${primaryInsurance ? this._renderInsuranceCard(primaryInsurance, 'Primary Insurance') : ''}
            ${secondaryInsurance ? this._renderInsuranceCard(secondaryInsurance, 'Secondary Insurance') : ''}
        `;
    }

    /**
     * Render insurance card
     * @private
     * @param {Object} insurance - Insurance data
     * @param {string} title - Card title
     * @returns {string} HTML
     */
    _renderInsuranceCard(insurance, title) {
        const categoryNames = ["Worker's Comp", 'Personal Injury', 'Private Insurance', 'Self Pay'];
        const categoryName = categoryNames[insurance.InsuranceCategory] || 'Unknown';

        // Render authorizations list if available
        let authorizationsHtml = '';
        if (insurance.Authorizations && insurance.Authorizations.length > 0) {
            authorizationsHtml = `
                <div class="mt-3 pt-3 border-top">
                    <h6 class="text-muted mb-2"><i class="bi bi-clock-history me-1"></i>Authorization History</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Status</th>
                                    <th>Auth Number</th>
                                    <th>Visits</th>
                                    <th>Expiry</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${insurance.Authorizations.map(auth => {
                                    const statusClass = auth.IsActive ? 'bg-success' : (auth.IsExpired ? 'bg-danger' : 'bg-secondary');
                                    const statusText = auth.IsActive ? 'Active' : (auth.IsExpired ? 'Expired' : 'Inactive');
                                    return `
                                        <tr>
                                            <td><span class="badge ${statusClass}">${statusText}</span></td>
                                            <td>${this._escape(auth.AuthorizationNumber || '-')}</td>
                                            <td>${auth.AuthorizedVisits || 0}</td>
                                            <td>${auth.ExpiryDate ? this._formatDate(auth.ExpiryDate) : '-'}</td>
                                        </tr>
                                    `;
                                }).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>
            `;
        } else {
            authorizationsHtml = `
                <div class="mt-3 pt-3 border-top">
                    <p class="text-muted mb-0"><i class="bi bi-info-circle me-1"></i>No authorizations on file</p>
                </div>
            `;
        }

        return `
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong><i class="bi bi-shield-check me-2"></i>${title}</strong>
                    <span class="badge ${insurance.IsActive ? 'bg-success' : 'bg-secondary'}">
                        ${insurance.IsActive ? 'Active' : 'Inactive'}
                    </span>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Payer:</strong> ${this._escape(insurance.PayerName)}</p>
                            <p class="mb-2"><strong>Insurance Type:</strong>
                                <span class="badge bg-info">${categoryName}</span>
                            </p>
                            <p class="mb-2"><strong>Policy #:</strong> ${this._escape(insurance.PolicyNumber || '-')}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Subscriber:</strong> ${this._escape(insurance.SubscriberName || '-')}</p>
                            <p class="mb-2"><strong>Subscriber ID:</strong> ${this._escape(insurance.SubscriberId || '-')}</p>
                            <p class="mb-2"><strong>Relationship:</strong> ${this._escape(insurance.SubscriberRelationship || '-')}</p>
                        </div>
                    </div>
                    ${authorizationsHtml}
                </div>
            </div>
        `;
    }

    /**
     * Render care episodes tab content
     * @private
     * @param {Object} patient - Patient data
     * @returns {string} HTML
     */
    _renderCareEpisodesTab(patient) {
        if (!patient.CareEpisodes?.length) {
            return `
                <div class="text-center text-muted py-4">
                    <i class="bi bi-clipboard2-x fs-1 d-block mb-2"></i>
                    No care episodes found for this patient.
                </div>
            `;
        }

        return patient.CareEpisodes.map(ep => {
            const statusClass = ep.Status === 0 ? 'bg-success' :
                              ep.Status === 1 ? 'bg-warning text-dark' : 'bg-secondary';
            const statusText = ep.Status === 0 ? 'Active' :
                             ep.Status === 1 ? 'Overdue' :
                             ep.Status === 2 ? 'Completed' : 'On Hold';

            return `
                <div class="card mb-2">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>${this._escape(ep.PrimaryDiagnosis || '-')}</strong>
                                <span class="badge ${statusClass} ms-2">${statusText}</span>
                            </div>
                        </div>
                        <div class="small text-muted mt-1">
                            ${this._formatDate(ep.StartDate)} - ${ep.EndDate ? this._formatDate(ep.EndDate) : 'Ongoing'} |
                            Visits: ${ep.VisitsUsed || 0} |
                            Provider: ${this._escape(ep.PrimaryProviderName || 'Not assigned')}
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    /**
     * Render attachments tab content - shows loading state and triggers async load
     * @private
     * @param {Object} patient - Patient data
     * @returns {string} HTML
     */
    _renderAttachmentsTab(patient) {
        // Return loading state - documents will be loaded when tab is shown
        // Store patient ID in data attribute for async loading
        return `
            <div id="patientAttachmentsContent" data-patient-id="${patient.PatientId}">
                <div class="text-center py-3">
                    <span class="spinner-border spinner-border-sm me-1"></span>Loading documents...
                </div>
            </div>
        `;
    }

    /**
     * Load documents for View Patient modal Attachments tab
     * @private
     * @param {number} patientId - Patient ID
     */
    async _loadViewPatientDocuments(patientId) {
        const container = document.getElementById('patientAttachmentsContent');
        if (!container) return;

        try {
            const documents = await this._apiGet(`/patients/${patientId}/documents`);

            if (!documents || documents.length === 0) {
                container.innerHTML = `
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-paperclip fs-1 d-block mb-2"></i>
                        No documents found for this patient.
                    </div>
                `;
                return;
            }

            const categoryNames = ['Insurance Card', 'ID Document', 'Referral', 'Medical Record', 'Consent Form', 'Other'];

            container.innerHTML = `
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Category</th>
                                <th>Size</th>
                                <th>Uploaded</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${documents.map(doc => `
                                <tr>
                                    <td>
                                        <i class="bi ${this._getFileIcon(doc.FileName)} me-1"></i>
                                        ${this._escape(doc.FileName)}
                                    </td>
                                    <td><span class="badge bg-secondary">${categoryNames[doc.Category] || 'Other'}</span></td>
                                    <td>${this._formatFileSize(doc.FileSize)}</td>
                                    <td>${this._formatDate(doc.CreatedAt)}</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" onclick="window.patientModule.downloadDocument(${doc.DocumentId}, ${patientId})" title="Download">
                                            <i class="bi bi-download"></i>
                                        </button>
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        } catch (error) {
            console.error('[PatientModule] Failed to load documents:', error);
            container.innerHTML = `
                <div class="text-center text-muted py-4">
                    <i class="bi bi-paperclip fs-1 d-block mb-2"></i>
                    No documents found for this patient.
                </div>
            `;
        }
    }

    /**
     * Render consents tab content
     * @private
     * @param {Object} patient - Patient data
     * @returns {string} HTML
     */
    _renderConsentsTab(patient) {
        if (!patient.Consents?.length) {
            return `
                <div class="text-center text-muted py-4">
                    <i class="bi bi-file-earmark-check fs-1 d-block mb-2"></i>
                    No consent records found for this patient.
                    <p class="mt-2 small">Consents are collected at the kiosk during check-in.</p>
                </div>
            `;
        }

        return patient.Consents.map(consent => {
            const statusClass = consent.Status === 'Signed' ? 'bg-success' :
                               consent.Status === 'Pending' ? 'bg-warning text-dark' : 'bg-secondary';

            return `
                <div class="card mb-2">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>${this._escape(consent.FormName)}</strong>
                                <span class="badge ${statusClass} ms-2">${consent.Status}</span>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" onclick="window.patientModule.viewConsent(${consent.ConsentId})" title="View">
                                    <i class="bi bi-eye"></i>
                                </button>
                                ${consent.Status === 'Signed' ? `
                                    <button class="btn btn-outline-success" onclick="window.patientModule.downloadConsent(${consent.ConsentId})" title="Download PDF">
                                        <i class="bi bi-file-pdf"></i>
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                        <div class="small text-muted mt-1">
                            ${consent.SignedAt ? `Signed: ${this._formatDate(consent.SignedAt)}` : 'Not yet signed'}
                            ${consent.SignedBy ? ` by ${this._escape(consent.SignedBy)}` : ''}
                        </div>
                    </div>
                </div>
            `;
        }).join('');
    }

    /**
     * Get file icon based on extension
     * @private
     * @param {string} fileName - File name
     * @returns {string} Bootstrap icon class
     */
    _getFileIcon(fileName) {
        const ext = (fileName || '').split('.').pop().toLowerCase();
        const icons = {
            pdf: 'bi-file-pdf text-danger',
            doc: 'bi-file-word text-primary',
            docx: 'bi-file-word text-primary',
            xls: 'bi-file-excel text-success',
            xlsx: 'bi-file-excel text-success',
            jpg: 'bi-file-image text-info',
            jpeg: 'bi-file-image text-info',
            png: 'bi-file-image text-info',
            gif: 'bi-file-image text-info',
            txt: 'bi-file-text'
        };
        return icons[ext] || 'bi-file-earmark';
    }

    /**
     * Format file size
     * @private
     * @param {number} bytes - File size in bytes
     * @returns {string} Formatted size
     */
    _formatFileSize(bytes) {
        if (!bytes) return '-';
        const units = ['B', 'KB', 'MB', 'GB'];
        let size = bytes;
        let unitIndex = 0;
        while (size >= 1024 && unitIndex < units.length - 1) {
            size /= 1024;
            unitIndex++;
        }
        return `${size.toFixed(1)} ${units[unitIndex]}`;
    }

    /**
     * Download document - uses fetch with auth header and creates blob URL
     * @param {number} documentId - Document ID
     * @param {number} patientId - Patient ID (optional, uses currentPatient if not provided)
     */
    async downloadDocument(documentId, patientId = null) {
        try {
            const pId = patientId || this.currentPatient?.PatientId || document.getElementById('patientId')?.value;
            if (!pId) {
                this._showError('Patient ID is required to download document');
                return;
            }

            this._showInfo('Downloading document...');

            const token = localStorage.getItem('authToken');
            const response = await fetch(`/api/patients/${pId}/documents/${documentId}`, {
                headers: {
                    'Authorization': token ? `Bearer ${token}` : ''
                }
            });

            if (!response.ok) {
                throw new Error('Download failed');
            }

            // Get filename from Content-Disposition header or use default
            const contentDisposition = response.headers.get('Content-Disposition');
            let fileName = 'document';
            if (contentDisposition) {
                const match = contentDisposition.match(/filename="?(.+?)"?(?:;|$)/);
                if (match) fileName = match[1];
            }

            // Create blob and download
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
        } catch (error) {
            console.error('[PatientModule] Failed to download document:', error);
            this._showError('Failed to download document');
        }
    }

    /**
     * Delete document
     * @param {number} documentId - Document ID
     */
    async deleteDocument(documentId) {
        const confirmed = await this._confirm({
            title: 'Delete Document',
            message: 'Are you sure you want to delete this document? This action cannot be undone.',
            confirmText: 'Delete',
            confirmClass: 'btn-danger'
        });

        if (!confirmed) return;

        const patientId = this.currentPatient?.PatientId || document.getElementById('patientId')?.value;
        if (!patientId) {
            this._showError('Patient ID is required to delete document');
            return;
        }

        try {
            await this._apiDelete(`/patients/${patientId}/documents/${documentId}`);
            this._showSuccess('Document deleted successfully');

            // Check which modal is currently open and refresh appropriately
            const editModal = document.getElementById('patientModal');
            const viewModal = document.getElementById('patientDetailModal');
            const editModalOpen = editModal && editModal.classList.contains('show');
            const viewModalOpen = viewModal && viewModal.classList.contains('show');

            if (editModalOpen) {
                // We're in Edit modal - just refresh the attachment list
                await this._loadPatientAttachments(patientId);
            } else if (viewModalOpen && this.currentPatient) {
                // We're in View modal - refresh the documents in the tab
                await this._refreshViewModalDocuments(patientId);
            }
        } catch (error) {
            console.error('[PatientModule] Failed to delete document:', error);
            this._showError('Failed to delete document');
        }
    }

    /**
